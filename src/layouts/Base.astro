---
// フォント: Fontsource self-host（設計書 §3・Astro 6 Fonts API は 6.3.2 で experimental のため不採用）。
// 見出し=しっぽり明朝 600/800 / 本文=Zen Kaku Gothic New 400/500/700 / アクセント=Klee One 600。
import '@fontsource/shippori-mincho/600.css';
import '@fontsource/shippori-mincho/800.css';
import '@fontsource/zen-kaku-gothic-new/400.css';
import '@fontsource/zen-kaku-gothic-new/500.css';
import '@fontsource/zen-kaku-gothic-new/700.css';
import '@fontsource/klee-one/600.css';

// LCP テキスト用 preload（本文 Zen Kaku Gothic New 400・日本語/ラテン）。
// ?url で Vite のハッシュ済みパスを取得し、本番ビルドでも整合する形で <link preload> する。
import zenJa400 from '@fontsource/zen-kaku-gothic-new/files/zen-kaku-gothic-new-japanese-400-normal.woff2?url';
import zenLatin400 from '@fontsource/zen-kaku-gothic-new/files/zen-kaku-gothic-new-latin-400-normal.woff2?url';

import Header from '../components/sections/Header.astro';
const {
  title = 'Co-Thrive Labs（こすらぼ）— AIエージェント4体と作る作品集',
  description = 'AIエージェント4体とオーナーで運営する個人 AI スタジオ「こすらぼ（Co-Thrive Labs）」のポートフォリオ。Claude Code を活用し、AI と人間が共に育つ開発を実践しています。',
  ogImage = '/og-image.png',
  // トップ（index.astro）は自前で <Header /> を置くため Base 既定の Header を抑止する。
  // works 詳細など他ページは hideHeader 未指定 → Base 既定の新 Header（ルート相対アンカー）を表示。
  hideHeader = false,
} = Astro.props;
// canonical URL（Astro.site が未設定の場合は pathname のみ）
const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : Astro.url.pathname;
const ogImageURL = Astro.site
  ? new URL(ogImage, Astro.site).toString()
  : ogImage;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO 基本 -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#f9f2e6" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content="Co-Thrive Labs" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- フォント: self-host（Fontsource を frontmatter で CSS import）。
         LCP テキスト用に本文 Zen Kaku Gothic New 400 を preload。FOIT は font-display: swap で回避。 -->
    <link rel="preload" as="font" type="font/woff2" href={zenJa400} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={zenLatin400} crossorigin />

    <!-- ページ固有の head 追加（JSON-LD 等）。構造化データはホームページのみに入れる -->
    <slot name="head-extra" />
  </head>
  <body>
    {!hideHeader && <Header />}
    <slot />
    <script is:inline>
      // scroll で要素が見えたら fade-in
      document.addEventListener('DOMContentLoaded', () => {
        const targets = document.querySelectorAll('[data-fade]');
        if (!('IntersectionObserver' in window)) {
          targets.forEach((el) => el.classList.add('is-visible'));
        } else {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  io.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.08, rootMargin: '0px 0px -5% 0px' }
          );
          targets.forEach((el) => io.observe(el));
          // 保険: ファーストビュー内の要素は即 visible にする
          // （IntersectionObserver の初回 callback がレイアウト確定前に走ると
          //  isIntersecting=false で来るブラウザがあるため）
          requestAnimationFrame(() => {
            targets.forEach((el) => {
              const rect = el.getBoundingClientRect();
              if (rect.top < window.innerHeight && rect.bottom > 0) {
                el.classList.add('is-visible');
                io.unobserve(el);
              }
            });
          });
        }

        // Header: スクロールで shrink + 背景半透明
        const header = document.querySelector('[data-header]');
        if (header) {
          const onScroll = () => {
            if (window.scrollY > 80) {
              header.classList.add('is-scrolled');
            } else {
              header.classList.remove('is-scrolled');
            }
          };
          onScroll();
          window.addEventListener('scroll', onScroll, { passive: true });
        }

        // ハンバーガーメニュー開閉処理は Header.astro に集約済み（重複防止）
      });
    </script>
    {/* 出現アニメ（設計書 §5.6・F4-b・2026-06-18 四次 FB リワーク）。Astro が GSAP 込みで
        バンドル・defer 読込。pin + scrub 順次出現モード（[data-step-section] 持つ section）
        と IO ベース単発出現モードの二系統。 */}
    <script>import '../scripts/reveal.ts';</script>
    {/* 演出 B グラデ背景切替（設計書 §5.3・F4-c）。reveal.ts と別ファイル・別 IO instance（§5.4.1）。 */}
    <script>import '../scripts/bgGradient.ts';</script>
    {/* 横スク 2 ゾーン（設計書 §5.5・F3）。S5 Works=ステップ送り / S6 DevFlow=scrub 連続。
        768px+ かつ非 reduced-motion のみ pin 発動。SP/reduce は CSS 既定の縦積み。 */}
    <script>import '../scripts/horizontalZones.ts';</script>
    {/* F4-e ちらほら視差装飾（設計書 §5.8・タスク G）。`[data-parallax][data-depth]` を
        scrub 視差。blur は CSS 静的・出現は reveal.ts 委譲・reduce 時は視差停止 blur 維持。 */}
    <script>import '../scripts/parallax.ts';</script>
  </body>
</html>

<style is:global>
  :root {
    /* === v2 配色（COLOR-6 確定・設計書 §2） === */
    --c-paper:        #f9f2e6;               /* ベース紙 C2（背景 70%） */
    --c-paper-deep:   #ece1c8;               /* C-DEEP（S2/S6/S7/S10 帯・演出 B 濃色側） */
    --c-main:         #3A3230;               /* ココアブラウン（文字・枠線 70-80%） */
    --c-main-soft:    rgba(58, 50, 48, 0.7); /* 本文 */
    --c-main-mute:    rgba(58, 50, 48, 0.6); /* 補助テキスト */
    --c-border:       rgba(58, 50, 48, 0.18);/* 枠線 */
    --c-accent:       #C06C5D;               /* テラコッタ（リンク・CTA 5-10%） */
    --c-accent-dark:  #A85847;               /* hover（仮値・WCAG AA は Phase 4-5 で確定） */

    /* === メンバーカラー（S3 のキャラ装飾のみ・本文/CTA に使わない・設計書 §2） === */
    --m-ame:    #D87FA0;  /* あめまみれ ピンク */
    --m-saki:   #6B8E5A;  /* さき みどり（旧 v1 primary と同値だが個性色として残置） */
    --m-ropi:   #8A6FBF;  /* ろぴ むらさき */
    --m-mitsuru:#5B89C2;  /* みつる あお */
    --m-tomomi: #E0A867;  /* ともみ オレンジ */

    /* === フォント（設計書 §2 / §3） === */
    --font-head:   'Shippori Mincho', 'Hiragino Mincho ProN', serif;
    --font-body:   'Zen Kaku Gothic New', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', Meiryo, sans-serif;
    --font-accent: 'Klee One', 'Hiragino Kaku Gothic ProN', sans-serif;

    /* === レイアウト（設計書 §2） === */
    --max-w: 1120px;
    --ease: cubic-bezier(0.22, 0.61, 0.36, 1);
    --bg-transition: 800ms;
    /* 演出 B グラデ背景切替が書き換える唯一の変数（設計書 §5.3.1）。
       初期値 C2 で JS 未実行でも表示が崩れない（プログレッシブ）。 */
    --bg-current: var(--c-paper);

    /* === 余白トークン（設計書 §2「意図的に不揃いな余白」） === */
    --space-loose: clamp(6rem, 12vh, 10rem);
    --space-base:  clamp(4rem, 8vh, 6.5rem);
    --space-snug:  clamp(2.5rem, 5vh, 4rem);

    /* === 実用トークン（v2 配色から導出・shadow は brown 基調へ） === */
    --radius: 14px;
    --shadow-sm: 0 2px 8px rgba(58, 50, 48, 0.05);
    --shadow-md: 0 8px 24px rgba(58, 50, 48, 0.09);
    --shadow-lg: 0 16px 40px rgba(58, 50, 48, 0.13);
    --fs-h1: clamp(2.4rem, 6vw, 4.2rem);
    --fs-h2: clamp(1.8rem, 4vw, 2.8rem);
    --ls-tight: -0.02em;
    --header-h: 72px;
    --header-h-scrolled: 56px;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: var(--header-h-scrolled);
  }

  body {
    margin: 0;
    font-family: var(--font-body);
    color: var(--c-main);
    background: var(--c-paper);
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* 見出しはしっぽり明朝（設計書 §3）。本文は Zen Kaku Gothic New。 */
  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-head);
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  a {
    color: inherit;
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  /* fade-in 共通 */
  [data-fade] {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.7s var(--ease), transform 0.7s var(--ease);
    will-change: opacity, transform;
  }
  [data-fade].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* 出現アニメの初期状態（設計書 §5.6・実体は scripts/reveal.ts・2026-06-18 三次 FB）。
     入域前のチラ見え防止。デフォルト（テキスト等）はフェード（translateY(20px)）。
     `.member-card[data-reveal]` は斜め飛び込み + 反動の初期値を CSS でも分岐させて
     チラ見えを完全に防ぐ（reveal.ts の gsap.set より早い画面初期描画段階で適用）。 */
  [data-reveal] {
    opacity: 0;
    transform: translateY(20px);
    will-change: opacity, transform;
  }
  /* メンバーカード = ポップ初期: 画面下 + 左 + 左回転 + 縮小 */
  .member-card[data-reveal] {
    transform: translateY(200px) translateX(-80px) rotate(-15deg) scale(0.8);
  }

  /* 旧 v1 の番号振り・英語添字ユーティリティ（巨大背面番号 / "01 About" 風ラベル / eyebrow）は
     v2 で全撤去（設計書 §6 Phase 1 / 仕様書 D4「番号振り NG・英語小添字 NG・見出しは日本語のみ」）。 */

  /* フォーカス可視（キーボード操作時のみ） */
  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: 3px;
    border-radius: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    [data-fade] {
      transition: none;
      opacity: 1;
      transform: none;
    }
    [data-reveal] {
      opacity: 1;
      transform: none;
    }
    /* card 側の specificity が高いので reduce 時に明示的に打ち消す */
    .member-card[data-reveal] {
      transform: none;
    }
  }
</style>
