---
// フォント: Fontsource self-host（設計書 §3・Astro 6 Fonts API は 6.3.2 で experimental のため不採用）。
// 見出し=しっぽり明朝 600/800 / 本文=Zen Kaku Gothic New 400/500/700 / アクセント=Klee One 600。
import '@fontsource/shippori-mincho/600.css';
import '@fontsource/shippori-mincho/800.css';
import '@fontsource/zen-kaku-gothic-new/400.css';
import '@fontsource/zen-kaku-gothic-new/500.css';
import '@fontsource/zen-kaku-gothic-new/700.css';
import '@fontsource/klee-one/600.css';

// LCP テキスト用 preload（本文 Zen Kaku Gothic New 400・日本語/ラテン）。
// ?url で Vite のハッシュ済みパスを取得し、本番ビルドでも整合する形で <link preload> する。
import zenJa400 from '@fontsource/zen-kaku-gothic-new/files/zen-kaku-gothic-new-japanese-400-normal.woff2?url';
import zenLatin400 from '@fontsource/zen-kaku-gothic-new/files/zen-kaku-gothic-new-latin-400-normal.woff2?url';

import Header from '../components/sections/Header.astro';
// fb7 §4.5.2 案1: 紙テクスチャ noise を共通モジュールから取得し --paper-noise-url（:root）に定義。
// PaperBg / シミ色背景 / シミ overlay fill が同じ粒を参照して質感統一（add1・§4.5）。
import { paperNoiseUrl } from '../lib/paperNoise';
const {
  title = 'Co-Thrive Labs（こすらぼ）— AIエージェント4体と作る作品集',
  description = 'AIエージェント4体とオーナーで運営する個人 AI スタジオ「こすらぼ（Co-Thrive Labs）」のポートフォリオ。Claude Code を活用し、AI と人間が共に育つ開発を実践しています。',
  ogImage = '/og-image.png',
  // トップ（index.astro）は自前で <Header /> を置くため Base 既定の Header を抑止する。
  // works 詳細など他ページは hideHeader 未指定 → Base 既定の新 Header（ルート相対アンカー）を表示。
  hideHeader = false,
} = Astro.props;
// canonical URL（Astro.site が未設定の場合は pathname のみ）
const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : Astro.url.pathname;
const ogImageURL = Astro.site
  ? new URL(ogImage, Astro.site).toString()
  : ogImage;
---

<!doctype html>
<!-- fb7 §4.5.2: --paper-noise-url を :root(=html) に注入。PaperBg/シミ系が共通参照（add1）。 -->
<html lang="ja" style={`--paper-noise-url: url("${paperNoiseUrl}");`}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO 基本 -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#f9f2e6" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content="Co-Thrive Labs" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- フォント: self-host（Fontsource を frontmatter で CSS import）。
         LCP テキスト用に本文 Zen Kaku Gothic New 400 を preload。FOIT は font-display: swap で回避。 -->
    <link rel="preload" as="font" type="font/woff2" href={zenJa400} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={zenLatin400} crossorigin />

    <!-- ページ固有の head 追加（JSON-LD 等）。構造化データはホームページのみに入れる -->
    <slot name="head-extra" />
  </head>
  <body>
    {!hideHeader && <Header />}
    <slot />
    <script is:inline>
      // scroll で要素が見えたら fade-in
      document.addEventListener('DOMContentLoaded', () => {
        const targets = document.querySelectorAll('[data-fade]');
        if (!('IntersectionObserver' in window)) {
          targets.forEach((el) => el.classList.add('is-visible'));
        } else {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  io.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.08, rootMargin: '0px 0px -5% 0px' }
          );
          targets.forEach((el) => io.observe(el));
          // 保険: ファーストビュー内の要素は即 visible にする
          // （IntersectionObserver の初回 callback がレイアウト確定前に走ると
          //  isIntersecting=false で来るブラウザがあるため）
          requestAnimationFrame(() => {
            targets.forEach((el) => {
              const rect = el.getBoundingClientRect();
              if (rect.top < window.innerHeight && rect.bottom > 0) {
                el.classList.add('is-visible');
                io.unobserve(el);
              }
            });
          });
        }

        // Header: スクロールで shrink + 背景半透明
        const header = document.querySelector('[data-header]');
        if (header) {
          const onScroll = () => {
            if (window.scrollY > 80) {
              header.classList.add('is-scrolled');
            } else {
              header.classList.remove('is-scrolled');
            }
          };
          onScroll();
          window.addEventListener('scroll', onScroll, { passive: true });
        }

        // ハンバーガーメニュー開閉処理は Header.astro に集約済み（重複防止）
      });
    </script>
    {/* 演出A Hero 入り込み（rev1 base + あめさん FB 数値）。
        refreshPriority:230 で Hero pin spacer を StudioAbout(200) より先に確定。 */}
    <script>import '../scripts/heroImmersion.ts';</script>
    {/* 出現アニメ（設計書 §5.6・F4-b・2026-06-18 四次 FB リワーク）。Astro が GSAP 込みで
        バンドル・defer 読込。pin + scrub 順次出現モード（[data-step-section] 持つ section）
        と IO ベース単発出現モードの二系統。 */}
    <script>import '../scripts/reveal.ts';</script>
    {/* 案 P フェーズ P（2026-06-20）: S7 TechStack も同型の fixed overlay + scrollY 監視で順次出現。
        reveal pin チェーン末端の累積誤差による「先走り」を根本解消（StudioAbout と同パターン）。 */}
    <script>import '../scripts/techstackReveal.ts';</script>
    {/* 案 P フェーズ2（2026-06-20）: TechStack → ComingSoon cover transition。TechStack progress
        0.65〜1.0 を cover 区間とし、ComingSoon overlay を translateY(100vh → 0) で下からせり上げ。
        pin 不使用・plain JS で rev4.2 破綻の罠（sticky × pin 競合）を構造的に回避。 */}
    <script>import '../scripts/comingSoonCover.ts';</script>
    {/* 演出 B グラデ背景切替（設計書 §5.3・F4-c）。reveal.ts と別ファイル・別 IO instance（§5.4.1）。 */}
    <script>import '../scripts/bgGradient.ts';</script>
    {/* 横スク 2 ゾーン（設計書 §5.5・F3）。S5 Works=ステップ送り / S6 DevFlow=scrub 連続。
        768px+ かつ非 reduced-motion のみ pin 発動。SP/reduce は CSS 既定の縦積み。 */}
    <script>import '../scripts/horizontalZones.ts';</script>
    {/* F4-e ちらほら視差装飾（設計書 §5.8・タスク G）。`[data-parallax][data-depth]` を
        scrub 視差。blur は CSS 静的・出現は reveal.ts 委譲・reduce 時は視差停止 blur 維持。 */}
    <script>import '../scripts/parallax.ts';</script>
    {/* 技スタ→ComingSoon「下から覆い被さる」単発演出（fb7 §10・coverTransition.ts 新規）。
        coffeeStain.ts より前に登録 → coffeeStain の最終 refresh（rAF×2）で ST-cover も測られる（§10.4）。 */}
    <script>import '../scripts/coverTransition.ts';</script>
    {/* コーヒーシミ章替わり演出（設計書 §5.10.4・S4 Services → S5 Works）。
        fb7: 侵食→四隅ベタ→全面維持の片道（後退削除）。最終 refresh をここで集約（§10.4）。 */}
    <script>import '../scripts/coffeeStain.ts';</script>
    {/* F5 メンバーカード カーソル追従 tilt（設計書 §5.9・2026-06-20 採用）。
        強さ: 中（±10deg / ±20px）・戻し: 0.6s。inner `.member-card__tilt` に閉じて
        reveal.ts のポップ tween と干渉ゼロ。pointer:fine 偽 / reduce 真で無効化。 */}
    <script>import '../scripts/memberCardTilt.ts';</script>
  </body>
</html>

<style is:global>
  :root {
    /* === v2 配色（COLOR-6 確定・設計書 §2） === */
    --c-paper:        #f9f2e6;               /* ベース紙 C2（背景 70%） */
    --c-paper-warm:   #f1e7d3;               /* C-WARM（S3 Members 帯・paper と paper-deep の中間でほんのり温かみのある紙色・3 次 FB で S2→S3 切替の視認用に追加） */
    --c-paper-deep:   #ece1c8;               /* C-DEEP（S2/S6/S7/S10 帯・演出 B 濃色側） */
    --c-main:         #3A3230;               /* ココアブラウン（文字・枠線 70-80%） */
    --c-main-soft:    rgba(58, 50, 48, 0.7); /* 本文 */
    --c-main-mute:    rgba(58, 50, 48, 0.6); /* 補助テキスト */
    --c-border:       rgba(58, 50, 48, 0.18);/* 枠線 */
    --c-accent:       #C06C5D;               /* テラコッタ（リンク・CTA 5-10%） */
    --c-accent-dark:  #A85847;               /* hover（仮値・WCAG AA は Phase 4-5 で確定） */

    /* === メンバーカラー（S3 のキャラ装飾のみ・本文/CTA に使わない・設計書 §2） === */
    --m-ame:    #D87FA0;  /* あめまみれ ピンク */
    --m-saki:   #6B8E5A;  /* さき みどり（旧 v1 primary と同値だが個性色として残置） */
    --m-ropi:   #8A6FBF;  /* ろぴ むらさき */
    --m-mitsuru:#5B89C2;  /* みつる あお */
    --m-tomomi: #E0A867;  /* ともみ オレンジ */

    /* === フォント（設計書 §2 / §3） === */
    --font-head:   'Shippori Mincho', 'Hiragino Mincho ProN', serif;
    --font-body:   'Zen Kaku Gothic New', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', Meiryo, sans-serif;
    --font-accent: 'Klee One', 'Hiragino Kaku Gothic ProN', sans-serif;

    /* === レイアウト（設計書 §2） === */
    --max-w: 1120px;
    --ease: cubic-bezier(0.22, 0.61, 0.36, 1);
    /* 演出 B グラデ背景切替の transition 時間（設計書 §5.10.3・5 次 FB で 800ms → 1500ms へ延長・「やわらかフェード」狙い）。 */
    --bg-transition: 1500ms;
    /* 演出 B グラデ背景切替が書き換える唯一の変数（設計書 §5.3.1）。
       初期値 C2 で JS 未実行でも表示が崩れない（プログレッシブ）。 */
    --bg-current: var(--c-paper);

    /* === 余白トークン（設計書 §2「意図的に不揃いな余白」・§5.10.2 で PC 倍化・SP 1.3-1.4 倍に抑制） === */
    --space-loose: clamp(8rem, 22vh, 18rem);   /* PC ≈ 18rem / SP ≈ 8rem */
    --space-base:  clamp(5.5rem, 15vh, 12rem); /* PC ≈ 12rem / SP ≈ 5.5rem */
    --space-snug:  clamp(3.5rem, 9vh, 7.5rem); /* PC ≈ 7.5rem / SP ≈ 3.5rem */

    /* === コーヒーシミ演出（設計書 §5.10.4 / fb7 §4） === */
    --c-coffee-stain: #8B6F4E;   /* シミ色（A 案）。fb7 §4.2: 値は濃いめのまま保持し、背景/fill は color-mix で薄める（適用時 mix・add1） */
    --stain-r: 0%;               /* シミ半径（coffeeStain.ts が scrub で 0% → 150% にアニメ） */
    --stain-fill-opacity: 0;     /* fb7 §4.2: シミ fill 層の不透明度。侵食完了で 0→1（四隅ベタ）。coffeeStain.ts 駆動 */
    /* fb7 §8.3: 定着後の背景/fill 用の薄シミ色（紙色 30% 混色）。overlay fill と §8 セクション背景で同色にして継ぎ目を消す。 */
    --c-coffee-stain-soft: color-mix(in srgb, var(--c-coffee-stain) 70%, var(--c-paper));

    /* === 実用トークン（v2 配色から導出・shadow は brown 基調へ） === */
    --radius: 14px;
    --shadow-sm: 0 2px 8px rgba(58, 50, 48, 0.05);
    --shadow-md: 0 8px 24px rgba(58, 50, 48, 0.09);
    --shadow-lg: 0 16px 40px rgba(58, 50, 48, 0.13);
    --fs-h1: clamp(2.4rem, 6vw, 4.2rem);
    --fs-h2: clamp(1.8rem, 4vw, 2.8rem);
    --ls-tight: -0.02em;
    --header-h: 72px;
    --header-h-scrolled: 56px;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: var(--header-h-scrolled);
  }

  body {
    margin: 0;
    font-family: var(--font-body);
    color: var(--c-main);
    background: var(--c-paper);
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* 見出しはしっぽり明朝（設計書 §3）。本文は Zen Kaku Gothic New。 */
  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-head);
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  a {
    color: inherit;
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  /* === コーヒーシミ overlay（設計書 §5.10.4 / fb7 §4.2・§4.5.4） ===
     位置: fixed・z:9999・pointer-events なし。
     fb7 で edge/fill の 2 層（疑似要素）に分離:
       ::before(edge) = 侵食中の「広がるにじみ」（radial・--stain-r で 0→150%・濃いめ）。
       ::after(fill)  = 四隅まで完全シミ色のベタ（薄シミ色＋紙テクスチャ noise）。
                        侵食完了で --stain-fill-opacity 0→1 で不透明化＝四隅ベタ（要件2）。
     §8 セクション背景と fill を同じ「薄シミ色＋noise」にして継ぎ目を消す（§8.3）。 */
  .coffee-stain {
    position: fixed;
    inset: 0;
    z-index: 9999;  /* コンテンツ最前面・侵食演出（五次 FB Case A 2026-06-18） */
    pointer-events: none;
  }
  /* edge: 侵食中の広がるにじみ（薄茶 soft radial・--stain-r 0%→220%・fb7 rev4 §A）。
     farthest-corner で四隅を半径基準にし、濃色終端 *0.85・透明 *1.05 でフェード帯を最小化。
     色は soft（薄茶）に統一し fill・§8背景とピクセル一致させて継ぎ目を消す（§A.1 / §A.4）。 */
  .coffee-stain::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle farthest-corner at 50% 50%,
      var(--c-coffee-stain-soft) 0%,
      var(--c-coffee-stain-soft) calc(var(--stain-r) * 0.85),
      transparent calc(var(--stain-r) * 1.05)
    );
    will-change: background;
  }
  /* fill: 四隅まで完全シミ色のベタ（薄シミ色＋noise）。侵食完了で不透明化（§4.2・§4.5.4）。
     色は --c-coffee-stain-soft（§8 背景と同色）・noise は --paper-noise-url（他背景と同粒）。 */
  .coffee-stain::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--c-coffee-stain-soft);
    background-image: var(--paper-noise-url);
    background-repeat: repeat;
    opacity: var(--stain-fill-opacity, 0);
    will-change: opacity;
  }

  /* fb7 rev5 §1.4: #coffee-stain-anchor（独立 pin 用・高さ0）は撤去。
     侵食駆動が reveal.ts の Services pin に統合され独立 pin が不要になったため。
     coffee-stain 本体 overlay（.coffee-stain / edge / fill）は上で定義済み・残す。 */

  /* fb7 rev4.2 §4.4: #techstack-cover-anchor は cover の JS pin 廃止に伴い撤去（CSS sticky 方式へ移行）。 */

  /* fb7 rev6: .works-floating-title 関連 CSS は撤去。
     works 全体を 1 pin に統合した（horizontalZones.ts）ので、本物の見出し+説明文が pin 内で
     物理的に画面に残るようになり、複製見出しが不要になった。 */

  /* fb7 §4.4: .is-over-stain トグルは撤去。制作物以降は §8 で常時 z:10000（シミ超え）にする。 */

  /* fade-in 共通 */
  [data-fade] {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.7s var(--ease), transform 0.7s var(--ease);
    will-change: opacity, transform;
  }
  [data-fade].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* 出現アニメの初期状態（設計書 §5.6・実体は scripts/reveal.ts・2026-06-18 三次 FB）。
     入域前のチラ見え防止。デフォルト（テキスト等）はフェード（translateY(20px)）。
     `.member-card[data-reveal]` は斜め飛び込み + 反動の初期値を CSS でも分岐させて
     チラ見えを完全に防ぐ（reveal.ts の gsap.set より早い画面初期描画段階で適用）。 */
  [data-reveal] {
    opacity: 0;
    transform: translateY(20px);
    will-change: opacity, transform;
  }
  /* メンバーカード = ポップ初期: 画面下 + 左 + 左回転 + 縮小 */
  .member-card[data-reveal] {
    transform: translateY(200px) translateX(-80px) rotate(-15deg) scale(0.8);
  }

  /* 旧 v1 の番号振り・英語添字ユーティリティ（巨大背面番号 / "01 About" 風ラベル / eyebrow）は
     v2 で全撤去（設計書 §6 Phase 1 / 仕様書 D4「番号振り NG・英語小添字 NG・見出しは日本語のみ」）。 */

  /* フォーカス可視（キーボード操作時のみ） */
  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: 3px;
    border-radius: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    [data-fade] {
      transition: none;
      opacity: 1;
      transform: none;
    }
    [data-reveal] {
      opacity: 1;
      transform: none;
    }
    /* card 側の specificity が高いので reduce 時に明示的に打ち消す */
    .member-card[data-reveal] {
      transform: none;
    }
    /* コーヒーシミ演出スキップ（§5.10.4 / fb7 §11・reduce のみ全オフ）。
       edge=--stain-r:0%（透明）・fill=--stain-fill-opacity:0（非表示）で完全に出さない。 */
    .coffee-stain {
      --stain-r: 0%;
      --stain-fill-opacity: 0;
    }
  }
</style>
