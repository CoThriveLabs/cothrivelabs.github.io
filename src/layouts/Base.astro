---
// フォント: Fontsource self-host（Astro 6 Fonts API は experimental のため不採用）。
// 見出し=しっぽり明朝 600/800 / 本文=Zen Kaku Gothic New 400/500/700 / アクセント=Klee One 600。
import '@fontsource/shippori-mincho/600.css';
import '@fontsource/shippori-mincho/800.css';
import '@fontsource/zen-kaku-gothic-new/400.css';
import '@fontsource/zen-kaku-gothic-new/500.css';
import '@fontsource/zen-kaku-gothic-new/700.css';
import '@fontsource/klee-one/600.css';

// LCP テキスト用 preload（本文 Zen Kaku Gothic New 400・日本語/ラテン）。
// ?url で Vite のハッシュ済みパスを取得し、本番ビルドでも整合する形で <link preload> する。
import zenJa400 from '@fontsource/zen-kaku-gothic-new/files/zen-kaku-gothic-new-japanese-400-normal.woff2?url';
import zenLatin400 from '@fontsource/zen-kaku-gothic-new/files/zen-kaku-gothic-new-latin-400-normal.woff2?url';

import Header from '../components/sections/Header.astro';
// 紙テクスチャ noise を共通モジュールから取得し --paper-noise-url（:root）に注入。
// PaperBg / シミ色背景 / シミ overlay fill が同じ粒を参照して質感統一。
import { paperNoiseUrl } from '../lib/paperNoise';
const {
  title = 'Co-Thrive Labs（こすらぼ）— AIエージェント4体と作る作品集',
  description = 'AIエージェント4体とオーナーで運営する個人 AI スタジオ「こすらぼ（Co-Thrive Labs）」のポートフォリオ。Claude Code を活用し、AI と人間が共に育つ開発を実践しています。',
  ogImage = '/og-image.png',
  // トップ（index.astro）は自前で <Header /> を置くため Base 既定の Header を抑止する。
  // works 詳細など他ページは hideHeader 未指定 → Base 既定の新 Header（ルート相対アンカー）を表示。
  hideHeader = false,
} = Astro.props;
// canonical URL（Astro.site が未設定の場合は pathname のみ）
const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : Astro.url.pathname;
const ogImageURL = Astro.site
  ? new URL(ogImage, Astro.site).toString()
  : ogImage;
---

<!doctype html>
<!-- --paper-noise-url を :root(=html) に注入。PaperBg / シミ系が共通参照。 -->
<html lang="ja" style={`--paper-noise-url: url("${paperNoiseUrl}");`}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO 基本 -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#f9f2e6" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content="Co-Thrive Labs" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- フォント: self-host（Fontsource を frontmatter で CSS import）。
         LCP テキスト用に本文 Zen Kaku Gothic New 400 を preload。FOIT は font-display: swap で回避。 -->
    <link rel="preload" as="font" type="font/woff2" href={zenJa400} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={zenLatin400} crossorigin />

    <!-- ページ固有の head 追加（JSON-LD 等）。構造化データはホームページのみに入れる -->
    <slot name="head-extra" />
  </head>
  <body>
    {!hideHeader && <Header />}
    <slot />
    <script is:inline>
      // scroll で要素が見えたら fade-in
      document.addEventListener('DOMContentLoaded', () => {
        const targets = document.querySelectorAll('[data-fade]');
        if (!('IntersectionObserver' in window)) {
          targets.forEach((el) => el.classList.add('is-visible'));
        } else {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  io.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.08, rootMargin: '0px 0px -5% 0px' }
          );
          targets.forEach((el) => io.observe(el));
          // 保険: ファーストビュー内の要素は即 visible にする
          // （IntersectionObserver の初回 callback がレイアウト確定前に走ると
          //  isIntersecting=false で来るブラウザがあるため）
          requestAnimationFrame(() => {
            targets.forEach((el) => {
              const rect = el.getBoundingClientRect();
              if (rect.top < window.innerHeight && rect.bottom > 0) {
                el.classList.add('is-visible');
                io.unobserve(el);
              }
            });
          });
        }

        // Header: スクロールで shrink + 背景半透明
        const header = document.querySelector('[data-header]');
        if (header) {
          const onScroll = () => {
            if (window.scrollY > 80) {
              header.classList.add('is-scrolled');
            } else {
              header.classList.remove('is-scrolled');
            }
          };
          onScroll();
          window.addEventListener('scroll', onScroll, { passive: true });
        }

        // ハンバーガーメニュー開閉処理は Header.astro に集約済み（重複防止）
      });
    </script>
    {/* Hero 入り込み演出。refreshPriority:230 で Hero pin spacer を StudioAbout(200) より先に確定。 */}
    <script>import '../scripts/heroImmersion.ts';</script>
    {/* 出現アニメ（GSAP）。pin + scrub 順次出現モード（[data-step-section] 持つ section）と
        IO ベース単発出現モードの二系統。 */}
    <script>import '../scripts/reveal.ts';</script>
    {/* TechStack は fixed overlay + scrollY 監視で順次出現させる。
        reveal pin チェーン末端の累積誤差による「先走り」を構造的に回避する独立 setup。 */}
    <script>import '../scripts/techstackReveal.ts';</script>
    {/* TechStack → ComingSoon cover transition。TechStack progress 0.65〜1.0 を cover 区間とし、
        ComingSoon overlay を translateY(100vh → 0) で下からせり上げ。
        pin 不使用・plain JS で sticky × pin の競合罠を構造的に回避。 */}
    <script>import '../scripts/comingSoonCover.ts';</script>
    {/* グラデ背景切替。reveal.ts と別ファイル・別 IO instance。 */}
    <script>import '../scripts/bgGradient.ts';</script>
    {/* 横スク 2 ゾーン。S5 Works=ステップ送り / S6 DevFlow=scrub 連続。
        768px+ かつ非 reduced-motion のみ pin 発動。SP/reduce は CSS 既定の縦積み。 */}
    <script>import '../scripts/horizontalZones.ts';</script>
    {/* ちらほら視差装飾。`[data-parallax][data-depth]` を scrub 視差。
        blur は CSS 静的・出現は reveal.ts 委譲・reduce 時は視差停止だが blur は維持。 */}
    <script>import '../scripts/parallax.ts';</script>
    {/* ちらほら装飾「葉っぱそよ風アニメ」。`[data-leaf]` を GSAP timeline で独立ループ。
        reduce 時は no-op（静止表示）。parallax.ts と属性別なので干渉なし。 */}
    <script>import '../scripts/leafBreeze.ts';</script>
    {/* 技スタ→ComingSoon「下から覆い被さる」単発演出。
        coffeeStain.ts より前に登録し、coffeeStain の最終 refresh（rAF×2）で測ってもらう。 */}
    <script>import '../scripts/coverTransition.ts';</script>
    {/* コーヒーシミ章替わり演出（侵食→四隅ベタ→全面維持の片道）。
        ScrollTrigger 最終 refresh をここで集約する。 */}
    <script>import '../scripts/coffeeStain.ts';</script>
    {/* メンバーカード カーソル追従 tilt。強さ: ±15deg / ±30px・戻し: 0.6s。
        inner `.member-card__tilt` に閉じて reveal.ts のポップ tween と干渉ゼロ。
        pointer:fine 偽 / reduce 真で無効化。 */}
    <script>import '../scripts/memberCardTilt.ts';</script>
  </body>
</html>

<style is:global>
  :root {
    /* === 配色 === */
    --c-paper:        #FFFBF3;               /* ベース紙 C2（背景 70%・白寄せでベージュらしさを抑える） */
    --c-paper-warm:   #f9f2e6;               /* C-WARM（シミ周辺で茶色に馴染むベージュ） */
    --c-paper-deep:   #F2EBDA;               /* C-DEEP（S2/S6/S7/S10 帯・グラデ濃色側） */
    --c-main:         #3A3230;               /* ココアブラウン（文字・枠線 70-80%） */
    --c-main-soft:    rgba(58, 50, 48, 0.7); /* 本文 */
    --c-main-mute:    rgba(58, 50, 48, 0.6); /* 補助テキスト */
    --c-border:       rgba(58, 50, 48, 0.18);/* 枠線 */
    --c-accent:       #C06C5D;               /* テラコッタ（リンク・CTA 5-10%） */
    --c-accent-dark:  #A85847;               /* hover */

    /* === メンバーカラー（キャラ装飾のみ・本文/CTA に使わない） === */
    --m-ame:    #D87FA0;  /* ピンク */
    --m-saki:   #6B8E5A;  /* みどり */
    --m-ropi:   #8A6FBF;  /* むらさき */
    --m-mitsuru:#5B89C2;  /* あお */
    --m-tomomi: #E0A867;  /* オレンジ */

    /* === フォント === */
    --font-head:   'Shippori Mincho', 'Hiragino Mincho ProN', serif;
    --font-body:   'Zen Kaku Gothic New', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', Meiryo, sans-serif;
    --font-accent: 'Klee One', 'Hiragino Kaku Gothic ProN', sans-serif;

    /* === レイアウト === */
    --max-w: 1120px;
    --ease: cubic-bezier(0.22, 0.61, 0.36, 1);
    /* グラデ背景切替の transition 時間。長めにとって「やわらかフェード」感を出す。 */
    --bg-transition: 1500ms;
    /* グラデ背景切替が書き換える唯一の変数。初期値 C2 で JS 未実行でも崩れない（プログレッシブ）。 */
    --bg-current: var(--c-paper);

    /* === 余白トークン（意図的に不揃いな余白） === */
    --space-loose: clamp(8rem, 22vh, 18rem);   /* PC 約 18rem / SP 約 8rem */
    --space-base:  clamp(5.5rem, 15vh, 12rem); /* PC 約 12rem / SP 約 5.5rem */
    --space-snug:  clamp(3.5rem, 9vh, 7.5rem); /* PC 約 7.5rem / SP 約 3.5rem */

    /* === コーヒーシミ演出 === */
    --c-coffee-stain: #8B6F4E;   /* シミ色（濃いめ）。背景/fill は color-mix で薄めて適用 */
    --stain-r: 0%;               /* シミ半径（reveal.ts が scrub でアニメ） */
    --stain-fill-opacity: 0;     /* シミ fill 層の不透明度。侵食完了で 0→1（四隅ベタ） */
    /* 定着後の背景/fill 用の薄シミ色（紙色 30% 混色）。
       overlay fill と各セクション背景で同色にして継ぎ目を消す。 */
    --c-coffee-stain-soft: color-mix(in srgb, var(--c-coffee-stain) 70%, var(--c-paper));

    /* === 実用トークン（shadow は brown 基調） === */
    --radius: 14px;
    --shadow-sm: 0 2px 8px rgba(58, 50, 48, 0.05);
    --shadow-md: 0 8px 24px rgba(58, 50, 48, 0.09);
    --shadow-lg: 0 16px 40px rgba(58, 50, 48, 0.13);
    --fs-h1: clamp(2.4rem, 6vw, 4.2rem);
    --fs-h2: clamp(1.8rem, 4vw, 2.8rem);
    --ls-tight: -0.02em;
    --header-h: 72px;
    --header-h-scrolled: 56px;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: var(--header-h-scrolled);
  }

  body {
    margin: 0;
    font-family: var(--font-body);
    color: var(--c-main);
    background: var(--c-paper);
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* 見出しはしっぽり明朝。本文は Zen Kaku Gothic New。 */
  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-head);
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  a {
    color: inherit;
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  /* === コーヒーシミ overlay ===
     位置: fixed・z:9999・pointer-events なし。
     edge/fill の 2 層（疑似要素）に分離:
       ::before(edge) = 侵食中の「広がるにじみ」（radial・--stain-r で 0→220%）。
       ::after(fill)  = 四隅まで完全シミ色のベタ（薄シミ色＋紙テクスチャ noise）。
                        侵食完了で --stain-fill-opacity 0→1 で不透明化＝四隅ベタ。
     セクション背景と fill を同じ「薄シミ色＋noise」にして継ぎ目を消す。 */
  .coffee-stain {
    position: fixed;
    inset: 0;
    z-index: 9999;
    pointer-events: none;
  }
  /* edge: 侵食中の広がるにじみ（薄茶 soft radial・--stain-r 0%→220%）。
     farthest-corner で四隅を半径基準にし、濃色終端 *0.85・透明 *1.05 でフェード帯を最小化。
     色は soft（薄茶）に統一し fill・各セクション背景とピクセル一致させて継ぎ目を消す。 */
  .coffee-stain::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle farthest-corner at 50% 50%,
      var(--c-coffee-stain-soft) 0%,
      var(--c-coffee-stain-soft) calc(var(--stain-r) * 0.85),
      transparent calc(var(--stain-r) * 1.05)
    );
    will-change: background;
  }
  /* fill: 四隅まで完全シミ色のベタ（薄シミ色＋noise）。侵食完了で不透明化。
     色は --c-coffee-stain-soft（セクション背景と同色）・noise は --paper-noise-url（他背景と同粒）。 */
  .coffee-stain::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--c-coffee-stain-soft);
    background-image: var(--paper-noise-url);
    background-repeat: repeat;
    opacity: var(--stain-fill-opacity, 0);
    will-change: opacity;
  }

  /* fade-in 共通 */
  [data-fade] {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.7s var(--ease), transform 0.7s var(--ease);
    will-change: opacity, transform;
  }
  [data-fade].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* 出現アニメの初期状態（実体は scripts/reveal.ts）。
     入域前のチラ見え防止のため、CSS でも初期 transform を持つ。
     デフォルト（テキスト等）はフェード（translateY(20px)）。
     `.member-card[data-reveal]` は斜め飛び込み + 反動の初期値を CSS でも分岐させて
     チラ見えを完全に防ぐ（reveal.ts の gsap.set より早い画面初期描画段階で適用）。 */
  [data-reveal] {
    opacity: 0;
    transform: translateY(20px);
    will-change: opacity, transform;
  }
  /* メンバーカード = ポップ初期: 画面下 + 左 + 左回転 + 縮小 */
  .member-card[data-reveal] {
    transform: translateY(200px) translateX(-80px) rotate(-15deg) scale(0.8);
  }

  /* フォーカス可視（キーボード操作時のみ） */
  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: 3px;
    border-radius: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    [data-fade] {
      transition: none;
      opacity: 1;
      transform: none;
    }
    [data-reveal] {
      opacity: 1;
      transform: none;
    }
    /* card 側の specificity が高いので reduce 時に明示的に打ち消す */
    .member-card[data-reveal] {
      transform: none;
    }
    /* reduce 時はコーヒーシミ演出を完全オフ。
       edge=--stain-r:0%（透明）・fill=--stain-fill-opacity:0（非表示）。 */
    .coffee-stain {
      --stain-r: 0%;
      --stain-fill-opacity: 0;
    }
  }
</style>
