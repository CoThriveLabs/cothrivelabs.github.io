---
// 公式 HP トップ。領域 A（S1-S7・背景固定 sticky）/ 領域 B（S8-S10・通常スクロール）。
// Header は自前の sections/Header を使うため Base 既定の Header は hideHeader で抑止。
import Base from '../layouts/Base.astro';
import PaperBg from '../components/PaperBg.astro';
import LeafBreeze from '../components/LeafBreeze.astro';
import Header from '../components/sections/Header.astro';
import Hero from '../components/sections/Hero.astro';
import StudioAbout from '../components/sections/StudioAbout.astro';
import Members from '../components/sections/Members.astro';
import Services from '../components/sections/Services.astro';
import Works from '../components/sections/Works.astro';
import DevFlow from '../components/sections/DevFlow.astro';
import TechStack from '../components/sections/TechStack.astro';
import ComingSoon from '../components/sections/ComingSoon.astro';
import Contact from '../components/sections/Contact.astro';
import Footer from '../components/sections/Footer.astro';

// 構造化データ（ホームページのみ・Google 公式ルールに準拠）
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Co-Thrive Labs',
  alternateName: ['こすらぼ', 'Co-Thrive Labs（こすらぼ）'],
  url: 'https://cothrivelabs.com',
  logo: 'https://cothrivelabs.com/logo.png',
  description:
    'Co-Thrive Labs（こすらぼ）は、AIエージェント4体と共にスピード感のある開発を行う個人開発スタジオ。企画・設計から実装・運用まで、一人でフルスタックに手がけます。',
  sameAs: ['https://github.com/CoThriveLabs'],
};
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Co-Thrive Labs',
  alternateName: 'こすらぼ',
  url: 'https://cothrivelabs.com/',
};
---
<Base title="Co-Thrive Labs（こすらぼ）— AIエージェント4体と作る作品集" hideHeader={true}>
  <script
    type="application/ld+json"
    slot="head-extra"
    is:inline
    set:html={JSON.stringify(organizationJsonLd)}
  />
  <script
    type="application/ld+json"
    slot="head-extra"
    is:inline
    set:html={JSON.stringify(websiteJsonLd)}
  />

  <Header />
  <main class="home">
    {/* 領域 A: S1-S7（背景固定 sticky） */}
    <div class="region-a">
      <PaperBg mode="fixed" />
      {/* ちらほら装飾「葉っぱそよ風アニメ」。fixed・z:0・最背面寄り。領域 A 限定。
          実体は src/scripts/leafBreeze.ts（reduce で no-op）。 */}
      <LeafBreeze />
      <Hero />
      <StudioAbout />
      <Members />
      <Services />
      {/* コーヒーシミ侵食 overlay 層（position:fixed・z:9999）。
          侵食駆動は reveal.ts の Services pin（STAIN_EXTRA 区間）に統合。 */}
      <div class="coffee-stain" data-coffee-stain aria-hidden="true"></div>
      {/* works 全体 1 pin 統合 + reveal を timeline tween で scrub 駆動（horizontalZones.ts）。
          本物の見出し+説明文が pin 中ずっと画面上部に残り、その下でカード帯が右から流れる。 */}
      <Works />
      <DevFlow />
      <div class="layered-pin-container">
        <div class="layered-pin-panel" data-panel="techstack">
          <TechStack />
        </div>
        <div class="layered-pin-panel" data-panel="comingsoon">
          <ComingSoon />
        </div>
      </div>
    </div>

    {/* 領域 B: S9-S10（通常スクロール・実背景色） */}
    <div class="region-b">
      <Contact />
    </div>
  </main>
  <Footer />
</Base>

<style>
  .home {
    display: block;
  }
  /* 領域 A: 背景は region-a 直下の PaperBg(mode="fixed") に一元化（--bg-current）。
     ここに自前のベタ背景を持たない（グラデ背景切替を見せるため）。 */
  .region-a {
    position: relative;
  }
  /* 領域 B: 通常スクロール・実背景色（S8/S10 は C-DEEP / S9 は C2） */
  .region-b {
    position: relative;
    background: var(--c-paper-deep);
  }

  /* Layered Pinning: TechStack / ComingSoon を同一 container に重ね、
     scrub で前面パネルを yPercent:-100 押し出し → 下のパネルが下から現れる。 */
  @media (prefers-reduced-motion: no-preference) and (min-width: 768px) {
    .layered-pin-container {
      position: relative;
      height: 100vh;
      overflow: hidden;
    }
    .layered-pin-panel {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 100vh;
      overflow: hidden;
    }
  }
  @media (max-width: 767px), (prefers-reduced-motion: reduce) {
    .layered-pin-container {
      height: auto;
    }
    .layered-pin-panel {
      position: static;
      height: auto;
    }
  }
</style>
