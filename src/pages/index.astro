---
// 公式 HP v2 トップ。領域 A（S1-S7・Phase 4 で背景固定 sticky 予定）/ 領域 B（S8-S10・通常スクロール）。
// Header は自前の sections/Header を使うため Base 既定の Header は hideHeader で抑止。
import Base from '../layouts/Base.astro';
import PaperBg from '../components/PaperBg.astro';
import Header from '../components/sections/Header.astro';
import Hero from '../components/sections/Hero.astro';
import StudioAbout from '../components/sections/StudioAbout.astro';
import Members from '../components/sections/Members.astro';
import Services from '../components/sections/Services.astro';
import Works from '../components/sections/Works.astro';
import DevFlow from '../components/sections/DevFlow.astro';
import TechStack from '../components/sections/TechStack.astro';
import ComingSoon from '../components/sections/ComingSoon.astro';
import Contact from '../components/sections/Contact.astro';
import Footer from '../components/sections/Footer.astro';

// 構造化データ（ホームページのみ・Google 公式ルールに準拠・W1 統一表記）
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Co-Thrive Labs',
  alternateName: ['こすらぼ', 'Co-Thrive Labs（こすらぼ）'],
  url: 'https://cothrivelabs.com',
  logo: 'https://cothrivelabs.com/logo.png',
  description:
    'Co-Thrive Labs（こすらぼ）は、AIエージェント4体と共にスピード感のある開発を行う個人開発スタジオ。企画・設計から実装・運用まで、一人でフルスタックに手がけます。',
  sameAs: ['https://github.com/CoThriveLabs'],
};
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Co-Thrive Labs',
  alternateName: 'こすらぼ',
  url: 'https://cothrivelabs.com/',
};
---
<Base title="Co-Thrive Labs（こすらぼ）— AIエージェント4体と作る作品集" hideHeader={true}>
  <script
    type="application/ld+json"
    slot="head-extra"
    is:inline
    set:html={JSON.stringify(organizationJsonLd)}
  />
  <script
    type="application/ld+json"
    slot="head-extra"
    is:inline
    set:html={JSON.stringify(websiteJsonLd)}
  />

  <Header />
  <main class="home">
    {/* 領域 A: S1-S7（Phase 4 で背景固定 sticky・現状は通常フロー） */}
    <div class="region-a">
      <PaperBg mode="fixed" />
      <Hero />
      <StudioAbout />
      <Members />
      <Services />
      <Works />
      <DevFlow />
      <TechStack />
    </div>

    {/* 領域 B: S8-S10（通常スクロール・実背景色） */}
    <div class="region-b">
      <ComingSoon />
      <Contact />
    </div>
  </main>
  <Footer />
</Base>

<style>
  .home {
    display: block;
  }
  /* 領域 A: 背景は region-a 直下の PaperBg(mode="fixed") に一元化（--bg-current）。
     ここに自前のベタ背景を持たない（演出 B グラデ切替を見せるため・設計書 §5.3 / 手順 0-a）。 */
  .region-a {
    position: relative;
  }
  /* 領域 B: 通常スクロール・実背景色（S8/S10 は C-DEEP / S9 は C2） */
  .region-b {
    position: relative;
    background: var(--c-paper-deep);
  }
</style>
