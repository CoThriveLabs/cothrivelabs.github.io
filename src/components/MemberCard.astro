---
// メンバー紹介カード（設計書 §4.1）。
// color はメンバー個性色（--m-*）でカード装飾のみに使う。本文・リンクには使わない。
export interface Props {
  name: string;
  role: string;
  tagline: string;
  color: string;
  image: string;
}
const { name, role, tagline, color, image } = Astro.props;
---
<article class="member-card" style={`--card-accent:${color}`} data-reveal="card">
  <span class="member-card__bar" aria-hidden="true"></span>
  <div class="member-card__avatar">
    <img src={image} alt={`${name}のアイコン`} loading="lazy" width="80" height="80" />
  </div>
  <p class="member-card__name">{name}</p>
  <p class="member-card__role">{role}</p>
  <p class="member-card__tagline">{tagline}</p>
</article>

<style>
  .member-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 2rem 1.5rem 1.75rem;
    background: #fff;
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .member-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }
  /* 上端の個性色バー（装飾のみ） */
  .member-card__bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--card-accent);
  }
  .member-card__avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    overflow: hidden;
    margin-bottom: 1rem;
    border: 2px solid color-mix(in srgb, var(--card-accent) 35%, transparent);
    background: var(--c-paper-deep);
  }
  .member-card__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .member-card__name {
    margin: 0 0 0.3rem;
    font-family: var(--font-head);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--c-main);
  }
  .member-card__role {
    margin: 0 0 0.85rem;
    font-family: var(--font-accent);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    color: var(--card-accent);
    font-weight: 600;
  }
  .member-card__tagline {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.85rem;
    line-height: 1.75;
    color: var(--c-main-soft);
  }
</style>
