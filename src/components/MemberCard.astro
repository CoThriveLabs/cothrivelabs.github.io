---
// メンバー紹介カード（設計書 §4.1）。
// color はメンバー個性色（--m-*）でカード装飾のみに使う。本文・リンクには使わない。
export interface Props {
  name: string;
  role: string;
  tagline: string;
  color: string;
  image: string;
}
const { name, role, tagline, color, image } = Astro.props;
---
<article class="member-card" style={`--card-accent:${color}`} data-reveal="card">
  {/* tilt 用 inner（設計書 §5.9・F5）。
       外殻 .member-card は reveal.ts のポップ tween + perspective だけを持つ透明 wrapper。
       見た目（background / border / radius / padding / shadow）と bar は inner に持たせて
       カード全体（白背景含む）が tilt で一緒に傾くようにする（あめさん FB 反映・2026-06-20）。 */}
  <div class="member-card__tilt">
    {/* 上端の個性色バー: inner の先頭に置いて .member-card__tilt 基準で top:0 に貼る。 */}
    <span class="member-card__bar" aria-hidden="true"></span>
    <div class="member-card__avatar">
      <img src={image} alt={`${name}のアイコン`} loading="lazy" width="120" height="120" />
    </div>
    <p class="member-card__name">{name}</p>
    <p class="member-card__role">{role}</p>
    <p class="member-card__tagline">{tagline}</p>
  </div>
</article>

<style>
  /* 外殻は透明 wrapper（reveal.ts のポップ tween + tilt の perspective 基点だけ持つ）。
     見た目は __tilt 側に移譲して、カード全体が tilt で傾くようにする（あめさん FB・2026-06-20）。 */
  .member-card {
    position: relative;
    /* F5 tilt: 3D 効果のための遠近（外殻維持・inner の rotation を奥行きに見せる）
       実機 FB: 1000px → 600px（強化）→ 800px（効きすぎ抑え・中間値）（2026-06-20）。 */
    perspective: 800px;
  }
  /* F5 tilt inner（設計書 §5.9）— ここがカードの「見た目」本体。
     白背景・border・radius・padding・shadow を全部ここに持って、tilt rotation/translate
     と一緒に動かす。bar も inner 内の先頭に入れて .member-card__tilt 基準で top:0 に貼る。 */
  .member-card__tilt {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    /* 外形の縦横比 2:3 固定（あめさん FB・2026-06-20）。
       前回 padding 1.5倍化で縦長になりすぎたため、padding は元値に戻し
       aspect-ratio で外形を 2:3 矩形に固定する。中身（avatar/フォント）の 1.5倍化は維持。 */
    aspect-ratio: 2 / 3;
    padding: 2rem 1.5rem 1.75rem;
    background: #fff;
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    /* overflow: hidden は preserve-3d を flatten するため削除（あめさん FB・2026-06-20）。
       CSS 仕様: overflow:hidden/clip は 3D rendering context を flatten し、子の translateZ が効かなくなる。
       角丸 clip が必要な avatar は要素単体で overflow:hidden + border-radius:50% を持つので影響なし。 */
    transition: box-shadow 0.3s var(--ease);
    transform-style: preserve-3d;
    will-change: transform;
  }
  .member-card:hover .member-card__tilt {
    box-shadow: var(--shadow-md);
  }
  /* 上端の個性色バー（装飾のみ）— inner 内の最上端に貼り付け
     F5 3D parallax: 20→40px（浮かせ強化）→ 15px → 5px（静止時の浮き違和感を完全解消・2026-06-20）。
     高さ: 4→6px（1.5倍スケール）。 */
  .member-card__bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 6px;
    background: var(--card-accent);
    transform: translateZ(5px);
  }
  /* F5 3D parallax: avatar はメインの見せ場なので最も手前に浮かせる。
     will-change は主役だけに付与（過剰指定で層を増やさない）。
     60→120px（倍化）→ 50px（効きすぎ抑え・中間値）（2026-06-20）。 */
  .member-card__avatar {
    /* 1.5倍スケール: 80→120px / margin 1→1.5rem（2026-06-20）。 */
    width: 120px;
    height: 120px;
    border-radius: 50%;
    overflow: hidden;
    margin-bottom: 1.5rem;
    border: 2px solid color-mix(in srgb, var(--card-accent) 35%, transparent);
    background: var(--c-paper-deep);
    transform: translateZ(50px);
    will-change: transform;
  }
  .member-card__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* F5 3D parallax: name Z=30px / role Z=25px / tagline Z=10px で奥行きの階層を作る。
     40/30/10 → 80/60/20（倍化）→ 30/25/10（効きすぎ抑え・中間値）（2026-06-20）。 */
  /* 1.5倍スケール: font-size と margin を 1.5 倍へ（2026-06-20）。
     name 1.15→1.7rem / role 0.78→1.15rem / tagline 0.85→1.25rem。
     margin: 0.3→0.45rem / 0.85→1.25rem。 */
  .member-card__name {
    margin: 0 0 0.45rem;
    font-family: var(--font-head);
    font-size: 1.7rem;
    font-weight: 600;
    color: var(--c-main);
    transform: translateZ(30px);
  }
  .member-card__role {
    margin: 0 0 1.25rem;
    font-family: var(--font-accent);
    font-size: 1.15rem;
    letter-spacing: 0.12em;
    color: var(--card-accent);
    font-weight: 600;
    transform: translateZ(25px);
  }
  .member-card__tagline {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1.25rem;
    line-height: 1.75;
    color: var(--c-main-soft);
    transform: translateZ(10px);
  }
</style>
