---
// 固定ヘッダー: ロゴ + アンカーナビ。スクロールで高さ shrink + 背景半透明。
// モバイル（〜768px）はハンバーガー → 右側ドロワーメニュー + backdrop。
const links = [
  { href: '/#about', label: 'About' },
  { href: '/#members', label: 'Members' },
  { href: '/#works', label: 'Works' },
  { href: '/#updates', label: 'Updates' },
];
---
<header class="site-header" data-header>
  <div class="site-header-inner">
    <a class="site-brand" href="/" data-brand-home aria-label="Co-Thrive Labs トップへ">
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-text">Co-Thrive Labs</span>
    </a>
    <nav
      class="site-nav"
      id="site-nav"
      data-nav
      aria-label="グローバルナビゲーション"
      role="dialog"
      aria-modal="true"
    >
      <ul>
        {links.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <button
      type="button"
      class="nav-toggle"
      data-nav-toggle
      aria-label="メニューを開く"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <span class="bar" aria-hidden="true"></span>
      <span class="bar" aria-hidden="true"></span>
      <span class="bar" aria-hidden="true"></span>
    </button>
  </div>
</header>
<div class="header-menu-backdrop" data-nav-backdrop aria-hidden="true"></div>

<script>
  // ハンバーガーメニューの UX 補強: 背景クリック / ESC / メニュー項目クリック / nav 余白クリックで閉じる
  // Astro <script> は type="module" で defer ロードなので DOMContentLoaded を待たず即実行
  (() => {
    const toggle = document.querySelector('[data-nav-toggle]');
    const nav = document.querySelector('[data-nav]');
    const backdrop = document.querySelector('[data-nav-backdrop]');
    if (!toggle || !nav || !backdrop) return;

    const closeMenu = () => {
      if (!nav.classList.contains('is-open')) return;
      nav.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'メニューを開く');
      document.body.style.overflow = '';
    };

    const openMenu = () => {
      nav.classList.add('is-open');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'メニューを閉じる');
      document.body.style.overflow = 'hidden';
    };

    // ハンバーガーボタンで開閉トグル
    toggle.addEventListener('click', () => {
      if (nav.classList.contains('is-open')) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    // 背景（backdrop）クリックで閉じる
    backdrop.addEventListener('click', closeMenu);

    // ESC キーで閉じる
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMenu();
    });

    // メニュー項目クリックで閉じる（アンカー遷移は通常通り）
    nav.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', closeMenu);
    });

    // 余白クリック close は backdrop が担当（nav 自体には click-to-close を付けない、
    // toggle のクリックイベントとバッティングして即閉じる問題を回避）

    // ヘッダーロゴ「Co-Thrive Labs」クリックで現在ページのトップへスムーズスクロール
    // 中クリック / Ctrl+クリック / 修飾キー併用は通常リンク (/) として尊重し、新タブで開けるようにする
    const brand = document.querySelector('[data-brand-home]');
    if (brand) {
      brand.addEventListener('click', (e) => {
        // 修飾キーや中クリック (button === 1) はデフォルト挙動を維持
        if (
          e.defaultPrevented ||
          e.button !== 0 ||
          e.metaKey ||
          e.ctrlKey ||
          e.shiftKey ||
          e.altKey
        ) {
          return;
        }
        e.preventDefault();
        // モバイルメニューが開いていれば閉じる
        closeMenu();
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
        // URL に #hero 等のハッシュが残らないようクリア（履歴を汚さず置き換え）
        if (window.location.hash) {
          history.replaceState(null, '', window.location.pathname + window.location.search);
        }
      });
    }
  })();
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 40;
    height: var(--header-h);
    background: rgba(255, 255, 255, 0);
    transition: height 0.28s var(--ease), background 0.28s var(--ease), box-shadow 0.28s var(--ease), backdrop-filter 0.28s var(--ease);
  }
  .site-header.is-scrolled {
    height: var(--header-h-scrolled);
    background: rgba(255, 255, 255, 0.78);
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    box-shadow: 0 1px 0 rgba(42, 42, 42, 0.06);
  }
  /* ドロワー展開中は header の半透明白フィルタを切ってドロワー上端をきれいに見せる。
     z-index: 80 でドロワー (site-nav 子) を backdrop (60) より上に持ち上げる */
  body:has(.site-nav.is-open) .site-header,
  body:has(.site-nav.is-open) .site-header.is-scrolled {
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    background: transparent;
    box-shadow: none;
    transition: none;
    z-index: 80;
  }
  .site-header-inner {
    max-width: var(--max-w);
    height: 100%;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .site-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--color-text);
    font-family: var(--font-en);
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .brand-mark {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    box-shadow: 0 2px 6px rgba(107, 142, 90, 0.32);
  }
  .brand-text {
    font-size: 0.95rem;
  }
  .site-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 1.6rem;
  }
  .site-nav a {
    font-family: var(--font-en);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-text-sub);
    position: relative;
    padding: 0.4rem 0;
    transition: color 0.25s var(--ease);
  }
  .site-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 2px;
    background: var(--color-accent);
    transition: width 0.3s var(--ease);
  }
  .site-nav a:hover {
    color: var(--color-text);
  }
  .site-nav a:hover::after {
    width: 100%;
  }
  .nav-toggle {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 0;
    background: transparent;
    border: 0;
    cursor: pointer;
    position: relative;
    z-index: 80;
  }
  /* 背景オーバーレイ。デフォルトは非表示、is-open と連動して表示 */
  .header-menu-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s var(--ease), visibility 0.2s var(--ease);
    z-index: 60;
    pointer-events: none;
  }
  body:has(.site-nav.is-open) .header-menu-backdrop {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  .nav-toggle .bar {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-text);
    border-radius: 2px;
    transition: transform 0.25s var(--ease), opacity 0.2s var(--ease);
    transform-origin: center;
  }

  /* PC 幅では backdrop は完全に非表示（保険） */
  @media (min-width: 769px) {
    .header-menu-backdrop {
      display: none;
    }
  }

  /* モバイル: 右側ドロワー化 */
  @media (max-width: 768px) {
    .nav-toggle {
      display: inline-flex;
    }
    .site-nav {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      left: auto;
      width: min(86%, 360px);
      background: #ffffff;
      box-shadow: -8px 0 24px rgba(42, 42, 42, 0.08);
      will-change: transform;
      transform: translateX(100%);
      transition: transform 0.3s var(--ease);
      z-index: 70;
      overflow-y: auto;
    }
    .site-nav.is-open {
      transform: translateX(0);
    }
    .site-nav ul {
      flex-direction: column;
      gap: 2rem;
      height: 100%;
      justify-content: center;
      padding: 2rem 1.5rem;
    }
    .site-nav a {
      font-size: 1.15rem;
      letter-spacing: 0.18em;
      color: var(--color-text);
    }
    /* 開いている時、ハンバーガーを × に */
    .site-header:has(.site-nav.is-open) .nav-toggle .bar:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .site-header:has(.site-nav.is-open) .nav-toggle .bar:nth-child(2) {
      opacity: 0;
    }
    .site-header:has(.site-nav.is-open) .nav-toggle .bar:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }

  @media (max-width: 380px) {
    .brand-text {
      font-size: 0.85rem;
    }
  }

  /* アクセシビリティ: モーション軽減 */
  @media (prefers-reduced-motion: reduce) {
    .site-nav,
    .header-menu-backdrop,
    .nav-toggle .bar,
    .site-header {
      transition: none !important;
    }
  }
</style>
