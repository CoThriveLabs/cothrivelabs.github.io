---
// Members セクション: あめまみれ + AI 社員 4 人のキャラ紹介カード
const members = [
  {
    name: 'あめまみれ',
    role: 'Founder',
    tagline: '最終意思決定・プロダクト方向性・ビジネス推進',
    color: '#D87FA0',
    image: '/members/amemamire.png',
  },
  {
    name: 'さき',
    role: 'CEO',
    tagline: '仕様書・戦略立案・社員との仲介・デバッグ',
    color: '#6B8E5A',
    image: '/members/saki.png',
  },
  {
    name: 'ろぴ',
    role: 'CTO',
    tagline: '設計書・テスト・コードレビュー・ドキュメント',
    color: '#8A6FBF',
    image: '/members/ropi.png',
  },
  {
    name: 'みつる',
    role: '開発者',
    tagline: 'ファイル作成・実装・コーディング全般',
    color: '#5B89C2',
    image: '/members/mituru.png',
  },
  {
    name: 'ともみ',
    role: 'リサーチャー',
    tagline: 'ウェブ調査・市場調査・情報収集',
    color: '#E0A867',
    image: '/members/tomomi.png',
  },
];
---
<section class="members" id="members">
  <div class="members-inner">
    <div class="members-head" data-fade>
      <h2 class="section-title">
        <span class="section-num-bg" aria-hidden="true">02</span>
        <span class="section-label">
          <span class="num">02</span>
          <span class="text">Members</span>
        </span>
        <span class="section-title-text">5 人で作っています</span>
      </h2>
      <p class="members-lead">それぞれ得意なことで支え合うチームです</p>
    </div>
    <div class="members-grid">
      {members.map((m, i) => (
        <article class="member-card" data-fade style={`--card-accent:${m.color}; transition-delay:${i * 60}ms`}>
          <span class="member-bar" aria-hidden="true"></span>
          <div class="member-avatar">
            <img src={m.image} alt={`${m.name}のアイコン`} loading="lazy" width="76" height="76" />
          </div>
          <h3>{m.name}</h3>
          <p class="role">{m.role}</p>
          <p class="tagline">{m.tagline}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .members {
    padding: 7rem 1.5rem;
    background: var(--color-bg-soft);
    position: relative;
  }
  .members-inner {
    max-width: var(--max-w);
    margin: 0 auto;
  }
  .members-head {
    text-align: center;
    margin-bottom: 3rem;
    position: relative;
  }
  .section-title {
    margin: 0 0 0.85rem;
    position: relative;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    padding-top: 1.2rem;
  }
  .members-head .section-num-bg {
    left: 50%;
    transform: translateX(-50%);
  }
  .members-head .section-label {
    justify-content: center;
  }
  .section-title-text {
    font-family: var(--font-jp);
    font-weight: 700;
    font-size: var(--fs-h2);
    line-height: 1.3;
    color: var(--color-text);
    letter-spacing: 0.01em;
    position: relative;
    z-index: 1;
  }
  .members-lead {
    margin: 0;
    color: var(--color-text-mute);
    font-size: 0.95rem;
  }
  .members-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.25rem;
    /* Phase 3.6: 3D ホバー用のステージ */
    perspective: 1000px;
  }
  .member-card {
    position: relative;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 2rem 1.25rem 1.5rem;
    text-align: center;
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    /* Phase 3.6: 3D 傾きの軸を下端中央へ（上に持ち上がりつつ手前に傾く） */
    transform-origin: center bottom;
    transform: translateZ(0);
    transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease), border-color 0.3s var(--ease);
  }
  /* Phase 3.6: 光沢 (sheen) を斜めに走らせる */
  .member-card::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      115deg,
      transparent 35%,
      rgba(255, 255, 255, 0.42) 50%,
      transparent 65%
    );
    opacity: 0;
    transform: translateX(-30%);
    transition: opacity 0.4s var(--ease), transform 0.7s var(--ease);
    z-index: 1;
    mix-blend-mode: overlay;
  }
  .member-card:hover {
    /* 軽い 3D 傾き（rotate は 3 度以内、上品に） */
    transform: translateY(-8px) rotateX(2.5deg) rotateY(-2deg);
    box-shadow: var(--shadow-md);
    border-color: var(--card-accent, var(--color-primary));
  }
  .member-card:hover::before {
    opacity: 1;
    transform: translateX(30%);
  }
  /* sheen より中身を前面に */
  .member-card > * {
    position: relative;
    z-index: 2;
  }
  .member-bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--card-accent, var(--color-primary));
  }
  .member-avatar {
    width: 76px;
    height: 76px;
    border-radius: 50%;
    margin: 0.5rem auto 1.25rem;
    padding: 3px;
    background: var(--card-accent, var(--color-primary));
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease);
    overflow: hidden;
  }
  .member-avatar img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    background: #fff;
  }
  .member-card:hover .member-avatar {
    transform: scale(1.06) rotate(-2deg);
    box-shadow: 0 10px 22px rgba(0, 0, 0, 0.12);
  }
  .member-card h3 {
    margin: 0 0 0.35rem;
    font-size: 1.1rem;
    color: var(--color-text);
    font-family: var(--font-jp);
  }
  .role {
    margin: 0 0 0.85rem;
    color: var(--card-accent, var(--color-primary));
    font-family: var(--font-en);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    font-weight: 600;
    text-transform: uppercase;
  }
  .tagline {
    margin: 0;
    color: var(--color-text-sub);
    font-size: 0.83rem;
    line-height: 1.7;
  }

  /* レスポンシブ */
  @media (max-width: 1100px) {
    .members-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 768px) {
    .members-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }
  @media (max-width: 480px) {
    .members {
      padding: 5rem 1.25rem;
    }
    .member-card {
      padding: 1.75rem 1rem 1.25rem;
    }
    .member-avatar {
      width: 64px;
      height: 64px;
    }
  }
  @media (max-width: 360px) {
    .members-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Phase 3.6: 動きを抑えたいユーザー向けに 3D / sheen を無効化 */
  @media (prefers-reduced-motion: reduce) {
    .member-card {
      transition: box-shadow 0.2s, border-color 0.2s;
    }
    .member-card:hover {
      transform: none;
    }
    .member-card::before {
      display: none;
    }
  }
</style>
