---
// 使い方紹介（ホットスポット）セクション。
// 大きいスクショ + ピン5個 + 中央モーダル popup で構成。
import type { WorkPin } from '../../types/work';
import HotspotPin from './HotspotPin.astro';
import HotspotPopup from './HotspotPopup.astro';

export interface Props {
  image: string;
  image_alt: string;
  pins: WorkPin[];
}
const { image, image_alt, pins } = Astro.props;
---
<section class="wi-hotspot" id="hotspot">
  <div class="wi-hotspot__inner" data-fade>
    <h2 class="wi-section-title">
      <span class="wi-section-title__num">03</span>
      <span class="wi-section-title__text">使い方</span>
    </h2>
    <p class="wi-hotspot__lead">
      画像のピンをクリックすると、各機能の説明が開きます。
    </p>

    <div class="wi-hotspot__viewport" data-hotspot-viewport>
      <img class="wi-hotspot__image" src={image} alt={image_alt} loading="lazy" />
      {pins.map((pin, i) => (
        <HotspotPin
          id={pin.id}
          label={pin.label}
          x_pct={pin.x_pct}
          y_pct={pin.y_pct}
          index={i + 1}
        />
      ))}
    </div>

    <ol class="wi-hotspot__legend" aria-label="ピン一覧">
      {pins.map((pin, i) => (
        <li>
          <button
            type="button"
            class="wi-hotspot__legend-item"
            data-pin-id={pin.id}
            aria-controls={`wi-popup-${pin.id}`}
          >
            <span class="wi-hotspot__legend-num">{i + 1}</span>
            <span class="wi-hotspot__legend-label">{pin.label}</span>
          </button>
        </li>
      ))}
    </ol>
  </div>

  {pins.map((pin) => (
    <HotspotPopup
      id={pin.id}
      title={pin.title}
      body={pin.body}
      screenshot={pin.screenshot}
      label={pin.label}
    />
  ))}
</section>

<script>
  // ホットスポット制御（クライアント JS）。
  // - ピン or 凡例ボタンクリックで popup を開く
  // - ESC / ✕ / backdrop クリックで閉じる
  // - focus trap、開閉時の focus 復帰
  (() => {
    const section = document.querySelector<HTMLElement>('.wi-hotspot');
    if (!section) return;

    const triggers = section.querySelectorAll<HTMLButtonElement>('[data-pin-id]');
    const popups = section.querySelectorAll<HTMLElement>('.wi-popup');

    let activePopup: HTMLElement | null = null;
    let lastTrigger: HTMLElement | null = null;

    const focusableSelector =
      'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])';

    function openPopup(pinId: string, trigger: HTMLElement) {
      const popup = section!.querySelector<HTMLElement>(`#wi-popup-${pinId}`);
      if (!popup) return;
      // 別の popup が開いていたら閉じる
      if (activePopup && activePopup !== popup) {
        activePopup.hidden = true;
      }
      popup.hidden = false;
      activePopup = popup;
      lastTrigger = trigger;

      // aria-expanded 同期
      triggers.forEach((t) => {
        if (t.dataset.pinId === pinId && t.hasAttribute('aria-expanded')) {
          t.setAttribute('aria-expanded', 'true');
        }
      });

      // panel に focus
      const panel = popup.querySelector<HTMLElement>('.wi-popup__panel');
      panel?.focus();

      document.addEventListener('keydown', onKeyDown);
      document.body.style.overflow = 'hidden';
    }

    function closePopup() {
      if (!activePopup) return;
      activePopup.hidden = true;

      triggers.forEach((t) => {
        if (t.hasAttribute('aria-expanded')) {
          t.setAttribute('aria-expanded', 'false');
        }
      });

      const toFocus = lastTrigger;
      activePopup = null;
      lastTrigger = null;
      document.removeEventListener('keydown', onKeyDown);
      document.body.style.overflow = '';

      // 元の trigger に focus 戻す
      toFocus?.focus();
    }

    function onKeyDown(e: KeyboardEvent) {
      if (!activePopup) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        closePopup();
        return;
      }
      if (e.key === 'Tab') {
        const focusables = activePopup.querySelectorAll<HTMLElement>(focusableSelector);
        if (focusables.length === 0) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        const current = document.activeElement as HTMLElement | null;

        // panel 自体に focus がある初期状態は first に寄せる
        if (current === activePopup.querySelector('.wi-popup__panel')) {
          e.preventDefault();
          (e.shiftKey ? last : first).focus();
          return;
        }
        if (e.shiftKey && current === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && current === last) {
          e.preventDefault();
          first.focus();
        }
      }
    }

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const id = trigger.dataset.pinId;
        if (!id) return;
        openPopup(id, trigger);
      });
    });

    popups.forEach((popup) => {
      popup.querySelectorAll<HTMLElement>('[data-close]').forEach((el) => {
        el.addEventListener('click', closePopup);
      });
    });
  })();
</script>

<style>
  .wi-hotspot {
    padding: clamp(3rem, 6vw, 5rem) 1.5rem;
    background: var(--color-bg-soft, #f4f1e0);
  }
  .wi-hotspot__inner {
    max-width: 880px;
    margin: 0 auto;
  }
  .wi-section-title {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    margin: 0 0 1.25rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--color-border);
  }
  .wi-section-title__num {
    font-family: var(--font-en);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: var(--ls-tight);
  }
  .wi-section-title__text {
    font-family: var(--font-jp);
    font-size: clamp(1.4rem, 3vw, 1.85rem);
    color: var(--color-text);
    line-height: 1.3;
  }
  .wi-hotspot__lead {
    margin: 0 0 1.75rem;
    font-size: 0.95rem;
    color: var(--color-text-sub, #555);
    line-height: 1.7;
  }
  .wi-hotspot__viewport {
    position: relative;
    border-radius: 10px;
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--color-border);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
  }
  .wi-hotspot__image {
    width: 100%;
    height: auto;
    display: block;
  }

  .wi-hotspot__legend {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 0.6rem;
  }
  .wi-hotspot__legend-item {
    width: 100%;
    text-align: left;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.6rem 0.8rem;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    cursor: pointer;
    color: var(--color-text);
    transition: border-color 0.15s ease, transform 0.15s ease, background 0.15s ease;
    font: inherit;
  }
  .wi-hotspot__legend-item:hover,
  .wi-hotspot__legend-item:focus-visible {
    border-color: var(--color-accent, #C97B5E);
    transform: translateY(-1px);
    outline: none;
  }
  .wi-hotspot__legend-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--color-accent, #C97B5E);
    color: #fff;
    font-family: var(--font-en);
    font-size: 0.75rem;
    font-weight: 700;
    flex-shrink: 0;
  }
  .wi-hotspot__legend-label {
    font-size: 0.92rem;
    line-height: 1.4;
  }

  @media (max-width: 767px) {
    .wi-hotspot__legend {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 420px) {
    .wi-hotspot__legend {
      grid-template-columns: 1fr;
    }
  }
</style>
