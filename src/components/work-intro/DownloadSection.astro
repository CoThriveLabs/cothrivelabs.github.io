---
// ダウンロードセクション: OS 別ダウンロードボタン + 自動検出による推奨表示。
// distribution.enabled === true の作品にのみ表示される（呼び出し側で分岐）。
import type { WorkDistribution, WorkDownloadOS } from '../../types/work';

export interface Props extends WorkDistribution {
  sectionNum?: string; // ページ内通し番号（既定 "04"）
}
const {
  version,
  released_at,
  downloads,
  install_guide,
  release_notes_url,
  sectionNum = '04',
} = Astro.props;

// OS 別のアイコン色（コントロールはクラスで切替）
const osIconLabel: Record<WorkDownloadOS, string> = {
  windows: 'Windows',
  macos: 'macOS',
  linux: 'Linux',
  source: 'Source',
};
---
<section class="wi-download" id="download">
  <div class="wi-download__inner" data-fade>
    <h2 class="wi-section-title">
      <span class="wi-section-title__num">{sectionNum}</span>
      <span class="wi-section-title__text">ダウンロード</span>
    </h2>

    {(version || released_at) && (
      <p class="wi-download__version">
        {version && <span class="wi-download__version-num">v{version}</span>}
        {released_at && <span class="wi-download__version-date">リリース {released_at}</span>}
        {release_notes_url && (
          <a class="wi-download__notes" href={release_notes_url} target={release_notes_url.startsWith('http') ? '_blank' : undefined} rel={release_notes_url.startsWith('http') ? 'noopener' : undefined}>
            リリースノートを見る
            <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M3 7h8M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        )}
      </p>
    )}

    <p class="wi-download__disclaimer">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <circle cx="7" cy="7" r="6" stroke="currentColor" stroke-width="1.3"/>
        <path d="M7 4v3.5M7 9.5v.1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
      </svg>
      個人開発の作品です。自己責任で使用してください。
    </p>

    <div class="wi-download__buttons" id="wi-download-buttons">
      {downloads.map((d) => (
        <a
          class={`wi-dl-btn wi-dl-btn--${d.os}`}
          href={d.url}
          download={d.os !== 'source' ? '' : undefined}
          data-os={d.os}
          data-arch={d.arch ?? ''}
          aria-label={`${d.label} をダウンロード`}
        >
          <span class="wi-dl-btn__badge" aria-hidden="true">推奨</span>
          <span class="wi-dl-btn__icon" aria-hidden="true">
            {d.os === 'windows' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M3 5.4l7.5-1v8.1H3V5.4zm0 13.2v-7.7h7.5v8.7L3 18.6zm8.5-5.1H21V20l-9.5-1.3v-5.2zm0-9.1L21 3v8.6h-9.5V4.4z"/>
              </svg>
            )}
            {d.os === 'macos' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M16.5 1.5c.1 1.3-.4 2.6-1.2 3.5-.9 1-2.3 1.7-3.5 1.6-.1-1.3.5-2.5 1.3-3.4.9-1 2.3-1.7 3.4-1.7zm3.6 16.4c-.6 1.3-.9 1.9-1.6 3-1 1.6-2.5 3.6-4.3 3.6-1.6 0-2.1-1-4.3-1-2.3 0-2.8 1-4.4 1-1.8 0-3.2-1.8-4.2-3.4C.6 18 .3 12.5 2.5 9.7c1.5-2 3.9-3.2 6.1-3.2 2.3 0 3.7 1.2 5.6 1.2 1.8 0 3-1.2 5.6-1.2 2 0 4 1.1 5.5 2.9-4.8 2.6-4 9.4-.2 11.5z"/>
              </svg>
            )}
            {d.os === 'linux' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12.5 2C10 2 9 4 9 6c0 1.5.5 3 1 4-1.5 1-2 2.5-3 4.5-.5 1-1.5 1.5-2 2.5-.5 1 0 2 1 2.5.5.5 0 1 0 1.5s.5 1.5 1.5 1.5c1.5 0 2-1 3.5-1 .5 0 1 .2 1.5.5s1 .5 1.5.5c1.5 0 2-1 3.5-1 1 0 1.5 1 3 1 1 0 1.5-1 1.5-1.5s-.5-1 0-1.5c1-.5 1.5-1.5 1-2.5-.5-1-1.5-1.5-2-2.5-1-2-1.5-3.5-3-4.5.5-1 1-2.5 1-4 0-2-1-4-3.5-4zm-1 3a1 1 0 011 1 1 1 0 01-1 1 1 1 0 01-1-1 1 1 0 011-1zm2 0a1 1 0 011 1 1 1 0 01-1 1 1 1 0 01-1-1 1 1 0 011-1zm-1 4c1 0 2 .5 2 1.5s-1 1.5-2 1.5-2-.5-2-1.5 1-1.5 2-1.5z"/>
              </svg>
            )}
            {d.os === 'source' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 7 4 12 9 17"/>
                <polyline points="15 7 20 12 15 17"/>
              </svg>
            )}
          </span>
          <span class="wi-dl-btn__main">
            <span class="wi-dl-btn__os-label">{osIconLabel[d.os]}</span>
            <span class="wi-dl-btn__label">{d.label}</span>
          </span>
          {d.size_mb !== null && d.size_mb !== undefined && (
            <span class="wi-dl-btn__size">{d.size_mb} MB</span>
          )}
        </a>
      ))}
    </div>

    {install_guide && (
      <details class="wi-download__install">
        <summary>インストール手順 / 警告回避</summary>
        <p>{install_guide}</p>
      </details>
    )}
  </div>
</section>

<script>
  // OS 自動検出 → .is-recommended 付与。
  // navigator.userAgentData (Chromium 90+) を優先、無ければ navigator.userAgent / platform で fallback。
  (() => {
    const container = document.getElementById('wi-download-buttons');
    if (!container) return;

    function detectOS(): 'windows' | 'macos' | 'linux' | null {
      const nav = navigator as Navigator & {
        userAgentData?: { platform?: string };
      };
      const uaPlatform = (nav.userAgentData?.platform ?? '').toLowerCase();
      const ua = (navigator.userAgent ?? '').toLowerCase();
      const platform = (navigator.platform ?? '').toLowerCase();

      const sources = [uaPlatform, ua, platform];
      const joined = sources.join(' ');

      if (/win/.test(joined)) return 'windows';
      if (/mac|darwin/.test(joined)) return 'macos';
      if (/linux|ubuntu|fedora|debian/.test(joined)) return 'linux';
      return null;
    }

    const detected = detectOS();
    if (!detected) return;

    const matched = container.querySelectorAll<HTMLAnchorElement>(`.wi-dl-btn[data-os="${detected}"]`);
    matched.forEach((btn) => btn.classList.add('is-recommended'));
  })();
</script>

<style>
  .wi-download {
    padding: clamp(3rem, 6vw, 5rem) 1.5rem;
    background: var(--color-bg);
  }
  .wi-download__inner {
    max-width: 880px;
    margin: 0 auto;
  }
  .wi-section-title {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    margin: 0 0 1.5rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--color-border);
  }
  .wi-section-title__num {
    font-family: var(--font-en);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: var(--ls-tight);
  }
  .wi-section-title__text {
    font-family: var(--font-jp);
    font-size: clamp(1.4rem, 3vw, 1.85rem);
    color: var(--color-text);
    line-height: 1.3;
  }

  .wi-download__version {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.85rem;
    margin: 0 0 1rem;
    color: var(--color-text-sub);
    font-size: 0.92rem;
  }
  .wi-download__version-num {
    font-family: var(--font-en);
    font-weight: 700;
    color: var(--color-primary);
    font-size: 1rem;
    letter-spacing: 0.04em;
  }
  .wi-download__version-date {
    color: var(--color-text-mute);
    font-size: 0.85rem;
  }
  .wi-download__notes {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.88rem;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s var(--ease, ease);
  }
  .wi-download__notes:hover {
    border-bottom-color: var(--color-accent);
  }

  .wi-download__disclaimer {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1.75rem;
    padding: 0.55rem 0.9rem;
    border-radius: 6px;
    background: rgba(201, 123, 94, 0.08);
    color: var(--color-accent-dark, #a25a3f);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  /* --- ボタン本体 --- */
  .wi-download__buttons {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.9rem;
    margin-bottom: 1.5rem;
  }

  .wi-dl-btn {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.85rem;
    padding: 0.95rem 1.15rem;
    background: #fff;
    border: 1.5px solid var(--color-border);
    border-radius: 10px;
    color: var(--color-text);
    text-decoration: none;
    transition: border-color 0.2s var(--ease, ease), transform 0.2s var(--ease, ease), box-shadow 0.2s var(--ease, ease);
  }
  .wi-dl-btn:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm, 0 4px 12px rgba(0, 0, 0, 0.06));
  }
  .wi-dl-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .wi-dl-btn__badge {
    position: absolute;
    top: -10px;
    right: 14px;
    display: none;
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
    background: var(--color-accent, #C97B5E);
    color: #fff;
    font-family: var(--font-jp);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.3;
    box-shadow: 0 2px 6px rgba(201, 123, 94, 0.35);
  }

  .wi-dl-btn__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    color: var(--color-text-sub);
  }
  .wi-dl-btn--windows .wi-dl-btn__icon { color: #0078d4; }
  .wi-dl-btn--macos   .wi-dl-btn__icon { color: #444; }
  .wi-dl-btn--linux   .wi-dl-btn__icon { color: #d6a13a; }
  .wi-dl-btn--source  .wi-dl-btn__icon { color: var(--color-primary); }

  .wi-dl-btn__main {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .wi-dl-btn__os-label {
    font-family: var(--font-en);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    color: var(--color-text-mute);
    text-transform: uppercase;
    font-weight: 600;
  }
  .wi-dl-btn__label {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.35;
  }
  .wi-dl-btn__size {
    font-family: var(--font-en);
    font-size: 0.78rem;
    color: var(--color-text-mute);
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }

  /* --- 推奨ボタン強調 --- */
  .wi-dl-btn.is-recommended {
    border-color: var(--color-accent);
    background: linear-gradient(180deg, #fff 0%, #fef7f3 100%);
    box-shadow: 0 0 0 4px rgba(201, 123, 94, 0.12), 0 6px 16px rgba(201, 123, 94, 0.15);
    transform: translateY(-1px);
  }
  .wi-dl-btn.is-recommended .wi-dl-btn__badge {
    display: inline-block;
  }
  .wi-dl-btn.is-recommended .wi-dl-btn__label {
    color: var(--color-accent-dark, #a25a3f);
  }

  /* --- インストール手順 details --- */
  .wi-download__install {
    margin-top: 1rem;
    padding: 0.85rem 1.1rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-bg-soft);
  }
  .wi-download__install summary {
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text);
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .wi-download__install summary::before {
    content: '▸';
    color: var(--color-accent);
    transition: transform 0.2s var(--ease, ease);
    display: inline-block;
  }
  .wi-download__install[open] summary::before {
    transform: rotate(90deg);
  }
  .wi-download__install p {
    margin: 0.85rem 0 0;
    font-size: 0.9rem;
    line-height: 1.85;
    color: var(--color-text-sub);
  }

  /* --- レスポンシブ --- */
  @media (max-width: 767px) {
    .wi-download__buttons {
      grid-template-columns: 1fr;
    }
    .wi-dl-btn.is-recommended {
      box-shadow: 0 0 0 3px rgba(201, 123, 94, 0.14), 0 4px 10px rgba(201, 123, 94, 0.18);
    }
  }
  @media (max-width: 414px) {
    .wi-dl-btn {
      padding: 0.85rem 1rem;
      gap: 0.7rem;
    }
    .wi-dl-btn__icon {
      width: 32px;
      height: 32px;
    }
    .wi-dl-btn__icon svg {
      width: 22px;
      height: 22px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wi-dl-btn,
    .wi-dl-btn:hover,
    .wi-download__install summary::before,
    .wi-download__install[open] summary::before {
      transition: none;
      transform: none;
    }
  }
</style>
