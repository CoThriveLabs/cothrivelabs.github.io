---
// 番号付きのホットスポットピン。x_pct / y_pct で画像内に絶対配置。
export interface Props {
  id: string;
  label: string;
  x_pct: number;
  y_pct: number;
  index: number;
}
const { id, label, x_pct, y_pct, index } = Astro.props;
---
<button
  class="wi-pin"
  type="button"
  aria-label={`ピン ${index}: ${label}`}
  aria-controls={`wi-popup-${id}`}
  aria-expanded="false"
  data-pin-id={id}
  style={`left:${x_pct}%;top:${y_pct}%;`}
>
  <span class="wi-pin__num" aria-hidden="true">{index}</span>
  <span class="wi-pin__sr">{label}</span>
</button>

<style>
  .wi-pin {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 2px solid #fff;
    background: var(--color-accent, #C97B5E);
    color: #fff;
    padding: 0;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25), 0 0 0 4px rgba(201, 123, 94, 0.25);
    animation: wi-pin-pulse 2.2s infinite;
    transition: transform 0.15s ease;
    z-index: 2;
  }
  .wi-pin:hover,
  .wi-pin:focus-visible {
    transform: translate(-50%, -50%) scale(1.12);
    outline: none;
  }
  .wi-pin:focus-visible {
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3), 0 0 0 4px rgba(107, 142, 90, 0.55);
  }
  .wi-pin__num {
    font-family: var(--font-en, "Inter", sans-serif);
    font-size: 0.85rem;
    font-weight: 700;
    line-height: 1;
  }
  /* スクリーンリーダー専用テキスト */
  .wi-pin__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @keyframes wi-pin-pulse {
    0%   { box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25), 0 0 0 0 rgba(201, 123, 94, 0.55); }
    70%  { box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25), 0 0 0 16px rgba(201, 123, 94, 0); }
    100% { box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25), 0 0 0 0 rgba(201, 123, 94, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .wi-pin {
      animation: none;
    }
    .wi-pin:hover,
    .wi-pin:focus-visible {
      transform: translate(-50%, -50%);
    }
  }

  @media (max-width: 1099px) {
    .wi-pin { width: 26px; height: 26px; }
    .wi-pin__num { font-size: 0.8rem; }
  }
  @media (max-width: 767px) {
    .wi-pin { width: 24px; height: 24px; }
    .wi-pin__num { font-size: 0.75rem; }
  }
</style>
