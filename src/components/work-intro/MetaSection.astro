---
// メタ情報: 期間 / 技術 / チーム / 開発スタイル
import type { WorkTeamMember } from '../../types/work';

export interface Props {
  period: string;
  duration_label: string;
  stack: string[];
  team: WorkTeamMember[];
  development_style: string;
  sectionNum?: string;
}
const {
  period,
  duration_label,
  stack,
  team,
  development_style,
  sectionNum = '04',
} = Astro.props;
---
<section class="wi-meta" id="meta">
  <div class="wi-meta__inner" data-fade>
    <h2 class="wi-section-title">
      <span class="wi-section-title__num">{sectionNum}</span>
      <span class="wi-section-title__text">メタ情報</span>
    </h2>
    <dl class="wi-meta__list">
      <div class="wi-meta__row">
        <dt>開発期間</dt>
        <dd>{period}<span class="wi-meta__note">（{duration_label}）</span></dd>
      </div>
      <div class="wi-meta__row">
        <dt>技術スタック</dt>
        <dd>
          <ul class="wi-meta__tags">
            {stack.map((s) => <li class="wi-tag">{s}</li>)}
          </ul>
        </dd>
      </div>
      <div class="wi-meta__row">
        <dt>チーム</dt>
        <dd>
          <ul class="wi-meta__team">
            {team.map((m) => (
              <li>
                <span class="wi-meta__name">{m.name}</span>
                <span class="wi-meta__role">{m.role}</span>
              </li>
            ))}
          </ul>
        </dd>
      </div>
      <div class="wi-meta__row">
        <dt>開発スタイル</dt>
        <dd>{development_style}</dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .wi-meta {
    padding: clamp(3rem, 6vw, 5rem) 1.5rem;
    background: var(--color-bg);
  }
  .wi-meta__inner {
    max-width: 880px;
    margin: 0 auto;
  }
  .wi-section-title {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    margin: 0 0 2rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--color-border);
  }
  .wi-section-title__num {
    font-family: var(--font-en);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: var(--ls-tight);
  }
  .wi-section-title__text {
    font-family: var(--font-jp);
    font-size: clamp(1.4rem, 3vw, 1.85rem);
    color: var(--color-text);
    line-height: 1.3;
  }
  .wi-meta__list {
    margin: 0;
    display: grid;
    gap: 1.5rem;
  }
  .wi-meta__row {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 1.5rem;
    align-items: start;
    padding-bottom: 1.5rem;
    border-bottom: 1px dashed var(--color-border);
  }
  .wi-meta__row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .wi-meta__row dt {
    margin: 0;
    font-family: var(--font-en);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-primary);
    font-weight: 600;
    padding-top: 0.2rem;
  }
  .wi-meta__row dd {
    margin: 0;
    color: var(--color-text);
    line-height: 1.85;
    font-size: 0.95rem;
  }
  .wi-meta__note {
    margin-left: 0.5rem;
    color: var(--color-text-mute);
    font-size: 0.85rem;
  }
  .wi-meta__tags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .wi-tag {
    font-family: var(--font-en);
    font-size: 0.78rem;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    color: var(--color-text-sub);
    font-weight: 500;
    letter-spacing: 0.04em;
  }
  .wi-meta__team {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }
  .wi-meta__team li {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    flex-wrap: wrap;
  }
  .wi-meta__name {
    font-weight: 700;
    color: var(--color-text);
  }
  .wi-meta__role {
    font-size: 0.85rem;
    color: var(--color-text-mute);
  }

  @media (max-width: 640px) {
    .wi-meta__row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
