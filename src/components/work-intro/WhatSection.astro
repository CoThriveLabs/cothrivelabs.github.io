---
// どういうもの: 概要段落 + 技術スタックタグ
export interface Props {
  paragraphs: string[];
  stack?: string[];
}
const { paragraphs, stack = [] } = Astro.props;
---
<section class="wi-what" id="what">
  <div class="wi-what__inner" data-fade>
    <h2 class="wi-section-title">
      <span class="wi-section-title__num">01</span>
      <span class="wi-section-title__text">どういうもの</span>
    </h2>
    <div class="wi-what__body">
      {paragraphs.map((p) => <p>{p}</p>)}
    </div>
    {stack.length > 0 && (
      <div class="wi-what__stack">
        <span class="wi-what__stack-label">技術スタック</span>
        <ul class="wi-what__tags">
          {stack.map((s) => <li class="wi-tag">{s}</li>)}
        </ul>
      </div>
    )}
  </div>
</section>

<style>
  .wi-what {
    padding: clamp(3rem, 6vw, 5rem) 1.5rem;
    background: var(--c-paper);
  }
  .wi-what__inner {
    max-width: 880px;
    margin: 0 auto;
  }
  .wi-section-title {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    margin: 0 0 2rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--c-border);
  }
  .wi-section-title__num {
    font-family: var(--font-accent);
    font-size: 1rem;
    font-weight: 700;
    color: var(--c-accent);
    letter-spacing: var(--ls-tight);
  }
  .wi-section-title__text {
    font-family: var(--font-body);
    font-size: clamp(1.4rem, 3vw, 1.85rem);
    color: var(--c-main);
    line-height: 1.3;
  }
  .wi-what__body p {
    margin: 0 0 1.2rem;
    font-size: 1rem;
    line-height: 1.95;
    color: var(--c-main);
  }
  .wi-what__body p:last-child {
    margin-bottom: 0;
  }
  .wi-what__stack {
    margin-top: 2.25rem;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--c-border);
  }
  .wi-what__stack-label {
    display: block;
    font-family: var(--font-accent);
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    color: var(--c-main);
    font-weight: 600;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }
  .wi-what__tags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .wi-tag {
    font-family: var(--font-accent);
    font-size: 0.78rem;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    background: var(--c-paper-deep);
    border: 1px solid var(--c-border);
    color: var(--c-main-soft);
    font-weight: 500;
    letter-spacing: 0.04em;
  }
</style>
