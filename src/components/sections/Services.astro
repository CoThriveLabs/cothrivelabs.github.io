---
// S4 受けられる案件。6 カテゴリ・「対応可」止め・誇張表現なし・価格は出さない。
import { Image } from 'astro:assets';
import SectionHeading from '../SectionHeading.astro';
import ropiFloating from '../../assets/decor/ropi-froating.png';
import tomomiFloating from '../../assets/decor/tomomi-froating.png';

const services = [
  { title: 'Web サイト制作', body: 'コーポレート・ポートフォリオなどの静的サイト。設計から公開まで。' },
  { title: 'LP 制作', body: '営業・キャンペーン向けランディングページ。JukuMate で一式作った経験があります。' },
  { title: '業務効率化', body: '手作業の自動化や社内ツールづくり。小さな困りごとから相談できます。' },
  { title: 'AI 活用支援', body: 'Claude API などを使った機能の組み込み。何ができるかの整理から。' },
  { title: 'プロトタイプ制作', body: 'アイデアを動く形にして検証する試作。Sprout のような小さな実験から。' },
  { title: 'WordPress 対応', body: '既存 WordPress サイトの制作・調整にも対応できます。' },
];
---
<section class="services" id="services" data-bg="paper" data-step-section data-step-distance="500">
  <div class="services__inner">
    <SectionHeading
      title="受けられる案件"
      lead="いま対応できることです。気になるものがあれば、まずはお声がけください。"
    />
    <ul class="services__grid">
      {services.map((s) => (
        <li class="services__item" data-reveal>
          <h3 class="services__title">{s.title}</h3>
          <p class="services__body">{s.body}</p>
        </li>
      ))}
    </ul>
  </div>
  {/* 常時ふわふわ装飾。reveal/parallax 管理外、CSS keyframes のみで動かす（左上=ろぴ・右下=ともみ） */}
  <Image src={ropiFloating} alt="" class="services__floater services__floater--ropi" widths={[200, 300, 400]} sizes="240px" aria-hidden="true" />
  <Image src={tomomiFloating} alt="" class="services__floater services__floater--tomomi" widths={[200, 300, 400]} sizes="240px" aria-hidden="true" />
</section>
{/* シミ侵食駆動専用 sentinel。Services pin の trigger 外側（natural flow）に置く。
    Why section 外: pin trigger の内側に置くと Services pin active 中も sentinel が
    viewport に入り、Services 表示中にシミ侵食が走って S4 が飲み込まれて表示されないバグになる。
    pin 解除後の natural flow 位置から sentinel が稼ぐスクロール量で shadow stain が完成する。
    視覚不可視（1px width）。 */}
<div class="stain-sentinel" data-stain-sentinel aria-hidden="true"></div>

<style>
  .services {
    padding: calc(var(--space-base) * 0.6) 1.5rem;
    /* 装飾の absolute 配置基点・はみ出し防止 */
    position: relative;
    overflow: hidden;
  }
  .services__inner {
    max-width: var(--max-w);
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }
  .services__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
  }
  .services__item {
    padding: 1.75rem;
    background: #fff;
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .services__item:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }
  .services__title {
    margin: 0 0 0.6rem;
    font-family: var(--font-head);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--c-main);
  }
  .services__body {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1.235rem;
    line-height: 1.85;
    color: var(--c-main-soft);
  }
  /* 常時ふわふわアニメ装飾（pin セクションの reveal 管理外、視差も不要） */
  /* 共通: サイズ・アニメ・装飾。位置は modifier 側で指定 */
  .services__floater {
    position: absolute;
    width: 240px;
    height: auto;
    pointer-events: none;
    user-select: none;
    z-index: 0;
    opacity: 0.95;
    animation: services-float 4.5s ease-in-out infinite;
  }
  /* ともみ: 右下 */
  .services__floater--tomomi {
    bottom: clamp(2rem, 5vh, 5rem);
    right: clamp(1.5rem, 3vw, 4rem);
  }
  /* ろぴ: 左上、半位相ずれで動きを互い違いに */
  .services__floater--ropi {
    top: clamp(2rem, 5vh, 5rem);
    left: clamp(1.5rem, 3vw, 4rem);
    animation-delay: -1.5s;
  }
  @keyframes services-float {
    0%, 100% { transform: translateY(0) rotate(-1deg); }
    50%      { transform: translateY(-12px) rotate(1deg); }
  }
  /* シミ侵食駆動専用 sentinel。CSS scroll-driven animation の view-timeline source。
     view-timeline-name で名前付け → Base.astro の .coffee-stain::before/::after が参照。
     sentinel の cover phase（viewport 下辺 → 上辺到達）を 0→1 progress として使う。
     高さ = sentinel 自身の縦距離 → 滞在時間（侵食ペース）を決める。
     SP は半量、reduce 時は 0 で縦スクロール無駄を消す（@supports 未サポート時も静止表示）。 */
  .stain-sentinel {
    width: 1px;
    height: 800px;
    margin: 0 auto;
    pointer-events: none;
    view-timeline-name: --stain-timeline;
    view-timeline-axis: block;
  }
  @media (max-width: 767px) {
    .stain-sentinel {
      height: 400px;
    }
    /* SP は明示的に 2 列固定（auto-fit の minmax 260px だと 1 列になる） */
    .services__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
    }
    /* SP 2 列化でカード幅が狭くなるため、内部要素を 0.9 倍に圧縮して窮屈感を和らげる。 */
    .services__item {
      padding: 0.99rem 0.9rem;
    }
    .services__title {
      font-size: 0.9rem;
      margin-bottom: 0.54rem;
    }
    .services__body {
      font-size: 0.945rem;
      line-height: 1.7;
    }
    /* SP では一律 110px に縮小、位置は modifier ごとに角ピタ寄せ */
    .services__floater {
      width: 110px;
    }
    .services__floater--tomomi {
      bottom: 1rem;
      right: 1rem;
    }
    .services__floater--ropi {
      top: 0.5rem;
      left: 0.5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .stain-sentinel {
      height: 0;
    }
    .services__floater {
      animation: none;
      transform: none;
    }
  }
</style>
