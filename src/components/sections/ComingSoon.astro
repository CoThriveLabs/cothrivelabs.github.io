---
// S8 案件受託案内。CTA 6 要素を構造として実装（フォーム挙動は未実装）。
// 領域 B・C-DEEP 実背景。価格は「応相談」のみ・根拠ない誇張表現 NG・断定保証 NG。
// この section 内に他リンク・ナビ・ボタンを置かない（CTA 単一化）。
---
{/* ComingSoon は sentinel + overlay 構造。comingSoonCover.ts が TechStack sentinel の
    progress 0.65〜1.0 を cover 区間として overlay の transform を translateY(100vh→0) で補間し
    下からせり上げる。CS sentinel 消化後は is-unpinned で自然フロー復帰（pin 不使用・plain JS）。 */}
<div class="coming-soon-sentinel" data-comingsoon-sentinel>
  <section class="coming-soon" id="coming-soon" data-reveal data-comingsoon-overlay>
    <div class="coming-soon__inner">
      {/* outcome-driven ヘッドライン */}
      <h2 class="coming-soon__headline">
        Web 制作・LP・業務効率化のご相談、はじめませんか
      </h2>
      <p class="coming-soon__sub">現在準備中・先行のお声がけを受付中です。</p>

      {/* social proof（実数のみ・誇張なし・制作物セクションと整合） */}
      <p class="coming-soon__proof">
        制作実績を公開中です（Sprout / LE CIEL / JukuMate / gizirotto の 4 件）。
      </p>

      {/* 期間明示（具体時期未確定なので範囲表現） */}
      <p class="coming-soon__period">
        準備が整い次第、正式に受付を開始します。
      </p>

      {/* ファーストビューに 1 つだけの CTA（フォーム挙動は未実装） */}
      <form class="coming-soon__form" data-phase5-pending>
        <label class="coming-soon__label" for="cs-email">メールアドレス</label>
        <div class="coming-soon__row">
          <input
            class="coming-soon__input"
            id="cs-email"
            type="email"
            name="email"
            placeholder="you@example.com"
            autocomplete="email"
            required
          />
          <button class="coming-soon__button" type="submit">
            お声がけリストに登録
          </button>
        </div>
        {/* 紹介インセンティブは送信後の確認画面 / 自動返信で明示する想定 */}
        <p class="coming-soon__note">
          登録後、受付開始のご案内を優先してお送りします。価格は応相談です。
        </p>
      </form>
    </div>
  </section>
</div>

<style>
  .coming-soon {
    padding: var(--space-loose) 1.5rem;
    background: var(--c-paper-deep);
    /* 技スタ→ComingSoon 覆い被さりの土台。comingSoonCover.ts が transform:translateY を
       100vh→0 で駆動して下からせり上げる。
       z:10000 = 技スタ同等。ヘッダーは常に最前面なので覆わない。
       初期 translateY は JS が set。reduce/SP（非対象）では set しない＝通常表示。 */
    position: relative;
    z-index: 10000;
  }
  .coming-soon__inner {
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
  }
  .coming-soon__headline {
    margin: 0 0 0.85rem;
    font-family: var(--font-head);
    font-size: var(--fs-h2);
    font-weight: 800;
    line-height: 1.4;
    color: var(--c-main);
  }
  .coming-soon__sub {
    margin: 0 0 1.5rem;
    font-family: var(--font-body);
    font-size: 1.235rem;
    color: var(--c-main-soft);
  }
  .coming-soon__proof,
  .coming-soon__period {
    margin: 0 0 0.5rem;
    font-family: var(--font-body);
    font-size: 1.144rem;
    color: var(--c-main-mute);
  }
  .coming-soon__form {
    margin-top: 2rem;
    text-align: left;
  }
  .coming-soon__label {
    display: block;
    font-family: var(--font-accent);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    color: var(--c-main-mute);
    margin-bottom: 0.5rem;
  }
  .coming-soon__row {
    display: flex;
    gap: 0.75rem;
  }
  .coming-soon__input {
    flex: 1;
    min-width: 0;
    padding: 0.8rem 1rem;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--c-main);
    background: #fff;
    border: 1px solid var(--c-border);
    border-radius: 999px;
  }
  .coming-soon__input:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: 1px;
  }
  .coming-soon__button {
    flex-shrink: 0;
    padding: 0.8rem 1.5rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 600;
    color: #fff;
    background: var(--c-accent);
    border: none;
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.25s var(--ease), transform 0.25s var(--ease);
  }
  .coming-soon__button:hover {
    background: var(--c-accent-dark);
    transform: translateY(-1px);
  }
  .coming-soon__note {
    margin: 0.85rem 0 0;
    font-family: var(--font-body);
    font-size: 1.04rem;
    line-height: 1.7;
    color: var(--c-main-mute);
  }

  /* SP 用 BP 640px。狭幅でもボタン文字「お声がけリストに登録」がはみ出ないよう、
     row → column で input とボタンを縦積みに切替える。 */
  @media (max-width: 640px) {
    .coming-soon__row {
      flex-direction: column;
    }
    .coming-soon__button {
      width: 100%;
    }
  }

  /* === TechStack → ComingSoon cover transition ===
     PC + no-reduced-motion のみ発動。SP / reduce 時は sentinel/overlay は static 扱いで
     自然フローに戻り、reveal.ts の IO 単発出現で表示される（既存挙動維持）。
     comingSoonCover.ts が TechStack sentinel の progress 0.65〜1.0 を cover 区間として
     overlay の transform を translateY(100vh → 0) で補間（毎フレーム JS で transform 直書き）。
     CS sentinel 区間内は画面固定維持、消化後は is-unpinned で自然フロー復帰。 */
  @media (prefers-reduced-motion: no-preference) and (min-width: 768px) {
    .coming-soon-sentinel {
      /* cover 区間 100vh のみ。cover 完了瞬間（cs.top <= 0）で fixed 解除し
         ComingSoon→Contact は通常スクロールに移行する。 */
      height: 100vh;
      position: relative;
    }
    .coming-soon[data-comingsoon-overlay] {
      position: fixed;
      inset: 0;
      /* TechStack overlay (10001) より上・Header (10004) / nav-overlay (10003) より下 */
      z-index: 10002;
      /* 不透明必須（下層が透けないように） */
      background: var(--c-paper-deep);
      /* 初期は画面下に待機（JS が毎フレーム上書き） */
      transform: translateY(100vh);
      will-change: transform;
      /* transition なし（毎フレーム JS で transform 直書き） */
    }
    /* cover 完了後、自然フローへ復帰（CS sentinel 消化後） */
    .coming-soon[data-comingsoon-overlay].is-unpinned {
      position: relative;
      transform: none;
      z-index: auto;
    }
    /* Gotcha: overlay の fixed 化で grid item が natural width に縮む。
       overlay 内部の width 100% を保証して inner の max-width 中央寄せが効くようにする。 */
    .coming-soon[data-comingsoon-overlay] .coming-soon__inner {
      width: 100%;
    }
  }
</style>
