---
// S5 制作物一覧（設計書 §4.2）。WorkCard で 4 件縦積み（横スクは Phase 4）。
// 4 件すべて確定原稿で公開中（task 4・さき起草）。詳細ページは Phase 5 で本実装（仮パス）、
// ぎじろっとのみ v1.0 公開済の外部 URL に飛ばす。
import SectionHeading from '../SectionHeading.astro';
import WorkCard from '../WorkCard.astro';

const works = [
  {
    title: 'Sprout',
    subtitle: '成長する TODO アプリ',
    challenge: 'ロードマップとタスクを一望できる場所がなく、長期目標の分解管理に困っていた。',
    built: 'ゴール→タスク→ステップの3階層で管理し、進捗に応じて植物が育つ SPA。',
    tags: ['FastAPI', 'SQLite', 'Vanilla JS'],
    craft: 'AIエージェントが API 経由で直接タスクを投入でき、会話だけで運用できるようにした。',
    detailUrl: '/works/sprout/',
    status: '公開中' as const,
  },
  {
    title: 'LE CIEL ÉTOILÉ',
    subtitle: '架空フレンチレストランの紹介サイト',
    challenge: 'みつる版・ろぴ版で同じ案件を 2 回作り、それぞれの長所と短所が残った状態だった。',
    built: '2 版の良いとこ取りで v2 を作り直し、Canvas 星空背景と縦積みエディトリアル Hero で銀座モダンフレンチの世界観を表現した静的サイト。',
    tags: ['HTML/CSS/JS', 'Canvas 星空', 'パララックス'],
    craft: 'lerp 追従と prefers-reduced-motion 対応を両立し、装飾の上品さとアクセシビリティを並立させた。',
    detailUrl: '/works/le-ciel-etoile/',
    status: '公開中' as const,
  },
  {
    title: 'JukuMate',
    subtitle: '個人塾向け業務自動化 SaaS の営業 LP',
    challenge: '小規模塾は IT ツール選定の判断材料が少なく、保護者連絡や生徒管理に多くの時間を取られていた。',
    built: '「保護者日次レポート + AI チャットボットでの学習可視化」を訴求する縦長 LP。塾長視点の Solution を 1 スクロールで体験できるよう、本ページめくり SVG 装飾とスクロール pin 演出を組み合わせた。',
    tags: ['Astro', 'GSAP', 'Cloudflare Workers'],
    craft: '紙の質感を出すための本ページめくり装飾を SVG で再現し、塾長の判断負荷を下げる情報設計に仕上げた。',
    detailUrl: '/works/jukumate/',
    status: '公開中' as const,
  },
  {
    title: 'ぎじろっと',
    subtitle: '家族の議事録 AI',
    challenge: '議事録ツールの多くは会社の会議向けで、家族会議や家計報告など「家庭の議事録」は書式が揺れがちだった。',
    built: '家族向けに振り切ったテンプレート議事録 SaaS。組み込みテンプレや独自テンプレ PDF から項目構造を抽出し、Claude が箇条書きメモを書式に沿って整形して PDF 出力する。',
    tags: ['Next.js 15', 'Supabase', 'Claude'],
    craft: 'PDF プレビューと最終出力のずれを 1 モジュールに集約する「座標の真実マップ」設計で、WYSIWYG エディタの精度を担保した。',
    detailUrl: 'https://gizirotto.cothrivelabs.com',
    status: '公開中' as const,
  },
];
---
<section class="works" id="works">
  {/* ブロック1: 見出し+説明文。rev9: works 全体 1pin 統合のため data-step-section を撤去
      （reveal.ts (1) pin 対象から外し、horizontalZones.ts の timeline tween で駆動を一元化）。 */}
  <div class="works__intro" id="works-intro">
    <div class="works__inner works__inner--intro">
      <SectionHeading
        title="制作物一覧"
        lead="こすらぼで作ってきたものです。うまくいかなかった過程も含めて残しています。"
      />
    </div>
  </div>
  {/* ブロック2: 横スク pin（horizontalZones.ts）= 段階5。
      rev9: works 全体 1pin 統合により本物の見出しが pin 中画面に残り続けるため、
      rev7 で置いていた scroller 内部 absolute 複製見出し（.works__scroller-heading）は撤去。 */}
  <div class="works__scroller">
    <div class="works__inner works__inner--scroller">
      <div class="works__list">
        {works.map((w) => (
          <WorkCard
            title={w.title}
            subtitle={w.subtitle}
            challenge={w.challenge}
            built={w.built}
            tags={w.tags}
            craft={w.craft}
            detailUrl={w.detailUrl}
            status={w.status}
          />
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .works {
    padding: var(--space-snug) 1.5rem var(--space-base);
  }
  .works__inner {
    max-width: 820px;
    margin: 0 auto;
  }
  /* 見出しブロックは z を持てる土台（制作物 section が §8 で z:10000 化済み）。 */
  .works__intro {
    position: relative;
    /* fb7 §5（要件3）: Services 等と同等の天井 padding（見出しが上端に貼り付くのを防ぐ）。 */
    padding-top: var(--space-base);
  }
  .works__list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* fb7 §8（要件6＋add1）: 制作物以降は「薄シミ色＋紙テクスチャ noise」背景でシミ全面維持を表現。
     §11: 全幅 no-preference ガード（SP でも ON・reduce のみ紙色のまま除外）。
     §4.4: 常時 z:10000 でシミ overlay(9999) の前面（.is-over-stain トグル廃止の代替）。
     R13: color-mix 非対応環境向けに background-color のベタ値を前置きフォールバック。 */
  @media (prefers-reduced-motion: no-preference) {
    .works {
      position: relative;
      z-index: 10000;
      background-color: var(--c-coffee-stain);
      background-color: var(--c-coffee-stain-soft);
      background-image: var(--paper-noise-url);
      background-repeat: repeat;
    }
    /* fb7 rev4.4 §2.4: シミ侵食 pin 中だけ works を overlay(9999) 背面へ降格（先走り防止）。
       coffeeStain.ts が onEnter で is-stain-invading を付与・onLeave で除去。侵食完了で §8 の z:10000 に復帰。
       works 自身の §8 背景（薄茶+noise）は overlay fill（薄茶+noise）と同色同粒なので z 前後で段差は出ない。 */
    .works.is-stain-invading {
      z-index: 9998;
    }
  }

  @media (min-width: 768px) and (prefers-reduced-motion: no-preference) {
    /* fb7 rev9 §2.3: works 全体を 1 pin 化（horizontalZones.ts）。
       pin 中の画面構成 = works 1 枚として確定（縦flex column）。 */
    .works {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    /* rev9: 自然高（見出し+lead+padding）で画面上部固定領域。 */
    .works__intro {
      flex: 0 0 auto;
      padding-top: var(--header-h-scrolled);
    }
    /* rev9: 残りスペース全部を取り、その中で縦中央寄せ（カード帯を画面中央〜下に配置）。
       ★ 横方向の中央配置ロジック（horizontalZones.ts の getStartX 等）は不可触・縦のみ調整。 */
    .works__scroller {
      position: relative;
      padding-left: 0;
      padding-right: 0;
      overflow: hidden;
      min-height: 0;
      flex: 1 1 auto;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding-top: 0;
    }
    .works__inner--scroller {
      max-width: none;
      margin: 0;
      padding: 0 1.5rem;
      /* flex 子として横幅が潰れないよう全幅を担保（縦中央寄せで shrink しても width 維持）。 */
      width: 100%;
    }
    .works__list {
      flex-direction: row;
      flex-wrap: nowrap;
      gap: 2rem;
      will-change: transform;
    }
    /* Astro scoped CSS は別 component (WorkCard.astro) の DOM 要素には
       data-astro-cid を継承しないため、子セレクタ `.works__list > *` が WorkCard の
       <article class="work-card"> に当たらない。:global() で scope を抜けて直接当てる。
       三次差し戻し原因: width 指定が当たらず flex item が default で縮み、
       scrollWidth ≈ clientWidth で totalScroll ≈ 0 → pin の意味なし状態だった。 */
    .works__list > :global(.work-card) {
      flex: 0 0 auto;
      width: min(560px, 80vw);
      /* flex shrink 防止の念押し（flex 指定だけで効くが Safari 等で稀に override される保険） */
      min-width: min(560px, 80vw);
    }
  }
</style>
