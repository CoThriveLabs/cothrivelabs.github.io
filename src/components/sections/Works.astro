---
// S5 制作物一覧。WorkCard で 4 件を SP では縦積み、PC では横スクで配置。
// 4 件すべて確定原稿で公開中。詳細ページは未実装の仮パス、
// ぎじろっとのみ公開済の外部 URL に飛ばす。
import SectionHeading from '../SectionHeading.astro';
import WorkCard from '../WorkCard.astro';

const works = [
  {
    title: 'Sprout',
    subtitle: '成長する TODO アプリ',
    challenge: 'ロードマップとタスクを一望できる場所がなく、長期目標の分解管理に困っていた。',
    built: 'ゴール→タスク→ステップの3階層で管理し、進捗に応じて植物が育つ SPA。',
    tags: ['FastAPI', 'SQLite', 'Vanilla JS'],
    craft: 'AIエージェントが API 経由で直接タスクを投入でき、会話だけで運用できるようにした。',
    detailUrl: '/works/sprout/',
    status: '公開中' as const,
  },
  {
    title: 'LE CIEL ÉTOILÉ',
    subtitle: '架空フレンチレストランの紹介サイト',
    challenge: 'みつる版・ろぴ版で同じ案件を 2 回作り、それぞれの長所と短所が残った状態だった。',
    built: '2 版の良いとこ取りで v2 を作り直し、Canvas 星空背景と縦積みエディトリアル Hero で銀座モダンフレンチの世界観を表現した静的サイト。',
    tags: ['HTML/CSS/JS', 'Canvas 星空', 'パララックス'],
    craft: 'lerp 追従と prefers-reduced-motion 対応を両立し、装飾の上品さとアクセシビリティを並立させた。',
    detailUrl: '/works/le-ciel-etoile/',
    status: '公開中' as const,
  },
  {
    title: 'JukuMate',
    subtitle: '個人塾向け業務自動化 SaaS の営業 LP',
    challenge: '小規模塾は IT ツール選定の判断材料が少なく、保護者連絡や生徒管理に多くの時間を取られていた。',
    built: '「保護者日次レポート + AI チャットボットでの学習可視化」を訴求する縦長 LP。塾長視点の Solution を 1 スクロールで体験できるよう、本ページめくり SVG 装飾とスクロール pin 演出を組み合わせた。',
    tags: ['Astro', 'GSAP', 'Cloudflare Workers'],
    craft: '紙の質感を出すための本ページめくり装飾を SVG で再現し、塾長の判断負荷を下げる情報設計に仕上げた。',
    detailUrl: '/works/jukumate/',
    status: '公開中' as const,
  },
  {
    title: 'ぎじろっと',
    subtitle: '家族の議事録 AI',
    challenge: '議事録ツールの多くは会社の会議向けで、家族会議や家計報告など「家庭の議事録」は書式が揺れがちだった。',
    built: '家族向けに振り切ったテンプレート議事録 SaaS。組み込みテンプレや独自テンプレ PDF から項目構造を抽出し、Claude が箇条書きメモを書式に沿って整形して PDF 出力する。',
    tags: ['Next.js 15', 'Supabase', 'Claude'],
    craft: 'PDF プレビューと最終出力のずれを 1 モジュールに集約する「座標の真実マップ」設計で、WYSIWYG エディタの精度を担保した。',
    detailUrl: 'https://gizirotto.cothrivelabs.com',
    status: '公開中' as const,
  },
];
---
<section class="works" id="works" data-bg="paper-warm">
  {/* ブロック1: 見出し+説明文。works 全体 1pin 統合のため data-step-section を持たず、
      reveal.ts (1) pin 対象から外して horizontalZones.ts の timeline tween で駆動を一元化。 */}
  <div class="works__intro" id="works-intro">
    <div class="works__inner works__inner--intro">
      <SectionHeading
        title="制作物一覧"
        lead="こすらぼで作ってきたものです。うまくいかなかった過程も含めて残しています。"
      />
    </div>
  </div>
  {/* ブロック2: 横スク pin（horizontalZones.ts）。
      works 全体 1pin 統合により本物の見出しが pin 中画面に残り続けるため、複製見出しは持たない。 */}
  <div class="works__scroller">
    <div class="works__inner works__inner--scroller">
      <div class="works__list">
        {works.map((w) => (
          <WorkCard
            title={w.title}
            subtitle={w.subtitle}
            challenge={w.challenge}
            built={w.built}
            tags={w.tags}
            craft={w.craft}
            detailUrl={w.detailUrl}
            status={w.status}
          />
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .works {
    padding: var(--space-snug) 1.5rem var(--space-base);
    /* シミ侵食完了〜Works 見出しの真空区間（pinSpacing 余剰）を負 margin で詰める。
       document スクロール量を短縮しつつ、演出 timeline / data-bg トリガー要素の相対位置は不変
       （reveal.ts は invalidateOnRefresh で再計算）。 */
    margin-top: calc(-200vh - 1000px);
  }
  .works__inner {
    max-width: 820px;
    margin: 0 auto;
  }
  /* 共通 SectionHeading の lead 色 (--c-main-mute α=0.6) を S5 限定で α=0.85 に上書き。
     S5 のみ濃く出して可読性確保（共通コンポは変えない）。 */
  .works :global(.section-heading__lead) {
    color: rgba(58, 50, 48, 0.85);
  }
  /* 見出しブロックは z を持てる土台（works section は後段で z:10000 化）。 */
  .works__intro {
    position: relative;
    /* 他セクションと揃えて天井 padding を確保（見出しが上端に貼り付くのを防ぐ）。 */
    padding-top: var(--space-base);
  }
  .works__list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* 背景色は fixed 背景レイヤ（--bg-current）に委ね、works 自身は紙テクスチャ noise のみを重ねる。
     自前の background-color を持つとシミ侵食前から画面下端に色が透けて見える「先走り」が出るため。
     SP でも noise は ON・reduce のみ除外。常時 z:10000 でシミ overlay(9999) の前面。 */
  @media (prefers-reduced-motion: no-preference) {
    .works {
      position: relative;
      z-index: 10000;
      background-image: var(--paper-noise-url);
      background-repeat: repeat;
    }
    /* シミ侵食中は overlay(9999) 背面へ降格して overlay 側の塗りを優先させる。
       侵食完了で z:10000 に復帰し、works の noise が overlay の上に来る。 */
    .works.is-stain-invading {
      z-index: 9998;
    }
  }

  /* SP は画面崩れ抑制のため負 margin を半量に留める */
  @media (max-width: 767px) {
    .works {
      margin-top: calc(-100vh - 500px);
    }
  }

  @media (min-width: 768px) and (prefers-reduced-motion: no-preference) {
    /* works 全体を 1 pin 化（horizontalZones.ts）。pin 中の画面構成 = works 1 枚として確定。 */
    .works {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    /* 自然高（見出し+lead+padding）で画面上部固定領域。 */
    .works__intro {
      flex: 0 0 auto;
      padding-top: var(--header-h-scrolled);
    }
    /* 残りスペース全部を取り、その中で縦中央寄せ（カード帯を画面中央〜下に配置）。
       Gotcha: 横方向の中央配置ロジック（horizontalZones.ts の getStartX 等）は不可触・縦のみ調整。 */
    .works__scroller {
      position: relative;
      padding-left: 0;
      padding-right: 0;
      overflow: hidden;
      min-height: 0;
      flex: 1 1 auto;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding-top: 0;
    }
    .works__inner--scroller {
      max-width: none;
      margin: 0;
      padding: 0 1.5rem;
      /* flex 子として横幅が潰れないよう全幅を担保（縦中央寄せで shrink しても width 維持） */
      width: 100%;
    }
    .works__list {
      flex-direction: row;
      flex-wrap: nowrap;
      gap: 2rem;
      will-change: transform;
    }
    /* Gotcha: Astro scoped CSS は別 component (WorkCard.astro) の DOM 要素に
       data-astro-cid を継承しないため、子セレクタ `.works__list > *` が WorkCard の
       <article class="work-card"> に当たらない。:global() で scope を抜けて直接当てる。
       これを忘れると width 指定が当たらず flex item が default で縮み、
       scrollWidth ≈ clientWidth で totalScroll ≈ 0 → 横スクが効かない。
       clamp 化で中域も滑らかに（下限 280 / 中域 60vw / 上限 560）。 */
    .works__list > :global(.work-card) {
      flex: 0 0 auto;
      width: clamp(280px, 60vw, 560px);
      /* flex shrink 防止の念押し（flex 指定だけで効くが Safari 等で稀に override される保険） */
      min-width: clamp(280px, 60vw, 560px);
    }
  }
</style>
