---
// S5 制作物一覧。WorkCard で 4 件を SP では縦積み、PC では横スクで配置。
// What: works データを src/data/works.ts に集約し、ここはレイアウト責務のみに絞る。
import SectionHeading from '../SectionHeading.astro';
import WorkCard from '../WorkCard.astro';
import { works } from '../../data/works';
---
<section class="works" id="works" data-step-section>
  <div class="works__grains" aria-hidden="true">
    <div class="works__grain works__grain--1"></div>
    <div class="works__grain works__grain--2"></div>
    <div class="works__grain works__grain--3"></div>
  </div>
  {/* 見出し+説明文ブロック。 */}
  <div class="works__intro" id="works-intro">
    <div class="works__inner works__inner--intro">
      <SectionHeading
        title="制作物一覧"
        lead="こすらぼで作ってきたものです。うまくいかなかった過程も含めて残しています。"
      />
    </div>
  </div>
  {/* カードリストブロック。 */}
  <div class="works__scroller">
    <div class="works__inner works__inner--scroller">
      {/* PaperBg 駆動の sentinel。works__list 直前に配置することで
          シミ侵食完了後・カードリスト入域時に paper-warm 切替が発火する。
          視覚上は不可視（1px 透明マーカー）。 */}
      <div class="works-sentinel" data-works-sentinel data-bg="paper-warm" aria-hidden="true"></div>
      <div class="works__list">
        {works.map((w) => (
          <WorkCard detail={w} />
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .works {
    padding: calc(var(--space-snug) * 0.6) 1.5rem calc(var(--space-base) * 0.6);
  }
  .works__grains {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }
  .works__grain {
    position: absolute;
    border-radius: 50%;
    background: rgba(94, 64, 50, 0.10);
    pointer-events: none;
  }
  .works__grain--1 {
    top: 25%;
    left: 8%;
    width: 400px;
    height: 400px;
    animation: grain-float 7s ease-in-out infinite;
  }
  .works__grain--2 {
    top: 45%;
    left: 65%;
    width: 520px;
    height: 520px;
    animation: grain-float 8.5s ease-in-out infinite -2.5s;
  }
  .works__grain--3 {
    top: 65%;
    left: 35%;
    width: 360px;
    height: 360px;
    animation: grain-float 6.5s ease-in-out infinite -4s;
  }
  @keyframes grain-float {
    0%, 100% { transform: translateY(0); }
    50%     { transform: translateY(-8px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .works__grain { animation: none; }
  }
  .works__inner {
    max-width: 820px;
    margin: 0 auto;
  }
  /* 共通 SectionHeading の lead 色 (--c-main-mute α=0.6) を S5 限定で α=0.85 に上書き。
     S5 のみ濃く出して可読性確保（共通コンポは変えない）。 */
  .works :global(.section-heading__lead) {
    color: rgba(58, 50, 48, 0.85);
  }
  .works__intro {
    position: relative;
    padding-top: calc(var(--space-base) * 0.6);
  }
  /* スクロールコンテナは .works__list 自身に統一（親 .works__scroller / .works__inner--scroller は
     overflow: visible のまま）。親に overflow-x を持たせると list.scrollWidth が clientWidth と
     一致して horizontal-wheel-drag.ts が即 return する。 */
  .works__list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;

    overflow-x: auto;
    overflow-y: hidden;

    /* scrollbar UI は隠す（横スクは JS + ネイティブ両対応） */
    scrollbar-width: none;
    -ms-overflow-style: none;

    /* テキスト選択防止: dragstart + pointermove preventDefault が一次防御。
       user-select: none は念のための保険として残す（子の focus は壊れない） */
    -webkit-user-select: none;
    user-select: none;

    /* 縦スワイプはネイティブの縦スクに譲り、横は JS（pointer events）で制御 */
    touch-action: pan-y;

    cursor: grab;
  }
  .works__list:active {
    cursor: grabbing;
  }
  .works__list::-webkit-scrollbar {
    display: none;
  }
  /* PaperBg 駆動専用の不可視マーカー。視覚に出さず IO trigger だけ担う。 */
  .works-sentinel {
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  /* 背景色は fixed 背景レイヤ（--bg-current）に委ね、works 自身は紙テクスチャ noise のみを重ねる。
     自前の background-color を持つとシミ侵食前から画面下端に色が透けて見える「先走り」が出るため。
     SP でも noise は ON・reduce のみ除外。 */
  @media (prefers-reduced-motion: no-preference) {
    .works {
      position: relative;
      z-index: 10000;
      background-image: var(--paper-noise-url);
      background-repeat: repeat;
    }
  }

  @media (min-width: 768px) and (prefers-reduced-motion: no-preference) {
    /* sentinel cover phase 中はシミ overlay と Works 背景の継ぎ目を消すため、
       Works section 自身もシミ色を持って「コーヒーがこぼれた後」の世界観を維持する。 */
    .works {
      background-color: var(--c-coffee-stain-soft);
    }
  }

  /* PC: 横並びカードリスト。
     - 子合計幅 < 親幅（PC ワイド）: justify-content: safe center で中央寄せ、横スクなし
     - 子合計幅 > 親幅（タブレット）: ネイティブ overflow-x: auto で横スク
     カード幅・gap は commit eac5435 当時と一致。 */
  @media (min-width: 768px) {
    .works {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    .works__intro {
      flex: 0 0 auto;
      padding-top: 0;
    }
    .works__scroller {
      position: relative;
      padding-left: 0;
      padding-right: 0;
      overflow: visible;
      min-height: 0;
      flex: 1 1 auto;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding-top: 0;
    }
    .works__inner--scroller {
      max-width: none;
      margin: 0;
      padding: 0 1.5rem;
      width: 100%;
    }
    /* スクロールコンテナを list 自体に統一（SP/PC とも）。
       overflow-x: auto は「子合計幅 > 親幅」のときだけスクロールバーが出る挙動。 */
    .works__list {
      flex-direction: row;
      flex-wrap: nowrap;
      gap: 2rem;
      will-change: transform;
      scroll-behavior: auto;
      justify-content: safe center;
    }
    /* Gotcha: Astro scoped CSS は別 component (WorkCard.astro) の DOM 要素に
       data-astro-cid を継承しないため、子セレクタ `.works__list > *` が WorkCard の
       <article class="pf-card"> に当たらない。:global() で scope を抜けて直接当てる。 */
    .works__list > :global(.pf-card) {
      flex: 0 0 auto;
      width: clamp(196px, 42vw, 392px);
      min-width: clamp(196px, 42vw, 392px);
    }
  }

  /* SP / タブレット (< 768px): 横並び + 横スク。
     カードサイズは PC と同値（SP で過度に縮小するとカード内テキストが圧迫されるため）。 */
  @media (max-width: 767px) {
    .works {
      padding-left: 0;
      padding-right: 0;
    }
    .works__inner--intro {
      padding-inline: 1.5rem;
    }
    .works__list {
      flex-direction: row;
      flex-wrap: nowrap;
      gap: 1.5rem;
      padding-inline: 1.5rem;
      padding-block: 0.25rem;
      scroll-behavior: auto;
    }
    .works__list > :global(.pf-card) {
      flex: 0 0 auto;
      width: clamp(196px, 42vw, 392px);
      min-width: clamp(196px, 42vw, 392px);
    }
    .works__grain--1 { width: 200px; height: 200px; }
    .works__grain--2 { width: 260px; height: 260px; }
    .works__grain--3 { width: 180px; height: 180px; }
  }
</style>

<script>
  // What: PF カード「詳細」ボタン押下で <dialog> を開閉する制御スクリプト。
  // Why: Works.astro スコープで 1 度だけ読み込むことで、他ページのバンドルを膨らませない。
  import '../../scripts/pf-modal';
  // What: 横スクロール帯上での wheel 縦→横変換とマウスドラッグスクロール。
  import '../../scripts/horizontal-wheel-drag';
</script>
