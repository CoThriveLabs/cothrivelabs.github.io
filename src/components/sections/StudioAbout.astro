---
// S2 スタジオ概要（設計書 §4.2）。--space-loose。未登記のため「スタジオ」表記で統一。
// リード文はあめさん確定原文（PF エピソード混入版は破棄）。
// あめさん FB 2026-06-21: facts カード削除（ともみが後で対抗文を追加するためのプレースホルダ）。
//                        併せて data-bg paper-deep → paper-warm に変更。
import SectionHeading from '../SectionHeading.astro';
import Decor from '../Decor.astro';
---
<section class="studio-about" id="studio-about" data-bg="paper-warm" data-step-section>
  {/* F4-e ちらほら視差装飾（設計書 §5.8 / タスク G）。aria-hidden 装飾扱い・コンテンツ下層
      Decor は装飾なので data-reveal は外しておく（pin scrub 進行カウントに混ぜると意図と
      ズレるため・§5.6 四次 FB）。視差は parallax.ts で別途。 */}
  <Decor char="ropi" depth="back" corner="top-left" noReveal />
  <Decor char="tomomi" depth="mid" corner="bottom-right" noReveal />
  <div class="studio-about__inner">
    <SectionHeading title="こすらぼ（Co-Thrive Labs）とは" align="left" />

    <div class="studio-about__body">
      <div class="studio-about__lead" data-reveal>
        {/* v1.4 リード文（ともみ敬体ドラフト v3 §4 反映・3 段落構造） */}
        <p>
          こすらぼ（Co-Thrive Labs）は、あめまみれ（人間）と AIエージェント4体で動かしている小さなスタジオです。ひとりでは抱えきれなかった「企画・設計・実装・テスト」を 5 人で役割分担し、フルスタックで開発を進めていきます。
        </p>
        <p>
          AI を使うからこそ、信頼できるものをつくる。それがこすらぼのスタンスです。
        </p>
        <p>
          具体的な開発の進め方は「開発フロー」へ、納品基準は「Footer」までスクロールしてご覧ください。
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .studio-about {
    padding: var(--space-loose) 1.5rem;
    /* F4-e 装飾の absolute 配置基点・はみ出し防止（§5.8 / タスク G） */
    position: relative;
    overflow: hidden;
    /* 案A: Hero pin spacer 余剰（≒1vh 真空区間）詰め。S2 を Hero 直後に
       吸い寄せて document スクロール量を短縮（演出 timeline / 相対位置は不変）。
       倍化 (2026-06-20 二回目 FB): 体感変化が薄かったため -50vh → -100vh。 */
    margin-top: -100vh;
  }
  .studio-about__inner {
    max-width: var(--max-w);
    margin: 0 auto;
    /* 装飾(z-index:0)より上に乗せる */
    position: relative;
    z-index: 1;
  }
  /* あめさん FB 2026-06-21: facts カード削除に伴い 2 列 grid → 単列化（lead だけ残す）。 */
  .studio-about__body {
    display: block;
  }
  .studio-about__lead p {
    margin: 0 0 1.25rem;
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 1.6vw, 1.05rem);
    line-height: 2;
    color: var(--c-main-soft);
  }
  .studio-about__lead p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    /* 案A SP: 画面崩れ抑制のため半量にとどめる。
       倍化 (2026-06-20 二回目 FB): -25vh → -50vh。 */
    .studio-about {
      margin-top: -50vh;
    }
  }
</style>
