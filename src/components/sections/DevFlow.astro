---
// S6 開発フロー（設計書 §4.2）。flow-diagram.md の 5 段を縦積み骨格（横スク scrub は Phase 4）。
// C-DEEP 背景・--space-snug。
import SectionHeading from '../SectionHeading.astro';

const steps = [
  { no: '01', title: '要件定義', who: 'あめまみれ × さき', body: '何を作るかを壁打ちで固める。必要なら下調べを挟む。' },
  { no: '02', title: '設計書', who: 'ろぴ', body: '仕様を実装できる粒度の設計に落とす。フェーズ分けもここで。' },
  { no: '03', title: '実装 + 一次テスト', who: 'みつる', body: 'まず動くものを作り、自分で動作確認まで通す。' },
  { no: '04', title: '二次テスト', who: 'ろぴ', body: '設計書とコードを照合し、コードレビューと動作確認をする。' },
  { no: '05', title: '実機検証', who: 'さき → あめまみれ', body: '実機で最終確認。問題があれば前の段に差し戻す。' },
];
---
<section class="devflow" id="devflow" data-bg="paper-deep">
  <div class="devflow__inner">
    <SectionHeading
      title="開発フロー"
      lead="案件は5つの段を通します。テストは省略しない決まりです。"
    />
    <ol class="devflow__list">
      {steps.map((s) => (
        <li class="devflow__step" data-reveal>
          <span class="devflow__no" aria-hidden="true">{s.no}</span>
          <div class="devflow__content">
            <h3 class="devflow__title">{s.title}</h3>
            <p class="devflow__who">{s.who}</p>
            <p class="devflow__body">{s.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .devflow {
    padding: var(--space-snug) 1.5rem var(--space-base);
  }
  .devflow__inner {
    max-width: 760px;
    margin: 0 auto;
  }
  .devflow__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .devflow__step {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 1.5rem 1.75rem;
    background: color-mix(in srgb, var(--c-paper) 70%, transparent);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
  }
  /* 番号は装飾の連番（"01 about" 型の英語添字ではなく、工程の手順番号なので可） */
  .devflow__no {
    flex-shrink: 0;
    font-family: var(--font-accent);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1;
    color: var(--c-accent);
    font-feature-settings: 'tnum' 1;
    padding-top: 0.1rem;
  }
  .devflow__title {
    margin: 0 0 0.2rem;
    font-family: var(--font-head);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--c-main);
  }
  .devflow__who {
    margin: 0 0 0.5rem;
    font-family: var(--font-accent);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--c-main-mute);
  }
  .devflow__body {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.8;
    color: var(--c-main-soft);
  }

  @media (max-width: 480px) {
    .devflow__step {
      padding: 1.25rem 1.25rem;
      gap: 1rem;
    }
    .devflow__no {
      font-size: 1.25rem;
    }
  }

  /* fb7 §8（要件6＋add1）: 制作物以降の「薄シミ色＋紙テクスチャ noise」背景（シミ全面維持の継続）。
     §11: 全幅 no-preference ガード（SP でも ON・reduce のみ除外）。§4.4: 常時 z:10000（シミ超え）。
     R13: color-mix 非対応向けに background-color ベタ値を前置きフォールバック。 */
  @media (prefers-reduced-motion: no-preference) {
    .devflow {
      position: relative;
      z-index: 10000;
      background-color: var(--c-coffee-stain);
      background-color: var(--c-coffee-stain-soft);
      background-image: var(--paper-noise-url);
      background-repeat: repeat;
    }
  }

  /* 768px+ かつ非 reduced-motion: scrub 連続横スク用に横並び化
     （実際の pin / translateX は horizontalZones.ts が担当・設計書 §5.5 / タスク D） */
  @media (min-width: 768px) and (prefers-reduced-motion: no-preference) {
    .devflow {
      padding-left: 0;
      padding-right: 0;
      overflow: hidden;
      /* fb7 rev7 §3.4: pin spacer の素地（region-a の紙色）露出を防ぐ。
         画面高さを確保し flex 縦中央寄せで中身を中央に置き、spacer の上下余白を消す。 */
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .devflow__inner {
      max-width: none;
      margin: 0;
      padding: 0 1.5rem;
    }
    .devflow__list {
      flex-direction: row;
      flex-wrap: nowrap;
      gap: 2rem;
      align-items: stretch;
      will-change: transform;
    }
    /* M4（2026-06-21 みつる調査→さき三次→みつる実装）: clamp 化で中域もステップ幅を滑らかに。
       下限 220 / 中域 32vw / 上限 320。 */
    .devflow__step {
      flex: 0 0 auto;
      width: clamp(220px, 32vw, 320px);
      /* flex shrink 防止の念押し（Works と同方針・三次差し戻し対策） */
      min-width: clamp(220px, 32vw, 320px);
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
