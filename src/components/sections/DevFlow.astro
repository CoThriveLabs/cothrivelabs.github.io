---
import SectionHeading from '../SectionHeading.astro';
import { devflowSteps } from '../../data/devflow';

// What: カード表示は既存の no/title/who/body をそのまま出す。新規データ層に集約しつつ表示文言は不変。
const steps = devflowSteps.map((s) => ({
  id: s.id,
  no: s.no,
  // カード上の who 表記は短縮版を維持（モーダル内では役職込みのフル表記）
  cardWho:
    s.id === 'requirements' ? 'あめまみれ × さき'
    : s.id === 'design' ? 'ろぴ'
    : s.id === 'implementation' ? 'みつる'
    : s.id === 'second-test' ? 'ろぴ'
    : s.id === 'verification' ? 'さき → あめまみれ'
    : 'さき → CI/CD',
  title: s.title,
  body: s.body,
}));
---

<section class="devflow" id="devflow" data-bg="paper-deep">
  <div class="devflow__pin">
    <div class="devflow__inner">
      <SectionHeading title="開発フロー" lead="案件は6つの段を通します。テストは省略しない決まりです。" />

      <ol class="devflow__list">
        {steps.map((s) => (
          <li class="devflow__step" data-reveal="slide-x">
            <button
              type="button"
              class="devflow__step-btn"
              aria-haspopup="dialog"
              aria-controls={`devflow-modal-${s.id}`}
              data-devflow-modal-open={s.id}
            >
              <span class="devflow__no" aria-hidden="true">{s.no}</span>
              <div class="devflow__content">
                <h3 class="devflow__title">{s.title}</h3>
                <p class="devflow__who">{s.cardWho}</p>
                <p class="devflow__body">{s.body}</p>
                <span class="devflow__more" aria-hidden="true">
                  詳細を見る
                  <svg width="12" height="12" viewBox="0 0 14 14" fill="none">
                    <path d="M3 7h8M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </div>
            </button>
          </li>
        ))}
      </ol>
    </div>
  </div>

  <aside class="devflow__epilog" data-reveal-late data-bg="paper-deep">
    <h3 class="devflow__epilog-heading">運用の前提 — 人が判断する部分・AI で自動化する部分・人と AI で協力する部分</h3>
    <p class="devflow__epilog-lead">
      AI に書かせて終わり、ではありません。出力されたコードは必ず人が読み、設計書と仕様書に照らして採否を決めます。こすらぼでは、開発工程を以下の三分割で運用しています。
    </p>

    <table class="devflow__matrix">
      <thead>
        <tr>
          <th>区分</th>
          <th>対象工程の例</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>人が判断する</td>
          <td>API キーの登録 / 本番公開の push 操作 / 法務・契約判断</td>
        </tr>
        <tr>
          <td>AI で自動化する</td>
          <td>設計書の作成 / 実装 / ドキュメント整備</td>
        </tr>
        <tr>
          <td>人と AI で協力する</td>
          <td>コードチェック / セキュリティ対策 / レビュー</td>
        </tr>
      </tbody>
    </table>

    <p class="devflow__epilog-summary">
      自動化していい部分と、人が判断する部分を分けて運用する。これが、こすらぼが「どう動くチームか」の前提です。AI を活用するからこそ、責任の所在を曖昧にしないことを大切にしています。
    </p>
  </aside>

  {devflowSteps.map((s) => (
    <dialog
      class="devflow-modal"
      id={`devflow-modal-${s.id}`}
      aria-label={`${s.title}の開発フロー`}
    >
      <div class="devflow-modal__inner">
        <button
          class="devflow-modal__close"
          type="button"
          aria-label="閉じる"
          data-devflow-modal-close
        >
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        </button>
        <img
          class="devflow-modal__image"
          src={s.image}
          alt=""
        />
      </div>
    </dialog>
  ))}
</section>

<script>
  // What: DevFlow カード詳細モーダルの開閉スクリプト。DevFlow セクション内で 1 度だけ読み込む。
  import '../../scripts/devflow-modal';
  // What: 横スクロール帯上での wheel 縦→横変換とマウスドラッグスクロール。
  import '../../scripts/horizontal-wheel-drag';
</script>

<style>
  .devflow {
    position: relative;
    z-index: 10000;
    padding: 0 1.5rem calc(var(--space-base) * 0.6);
  }

  .devflow__pin {
    padding: calc(var(--space-snug) * 0.6) 0 0;
  }

  .devflow__inner {
    max-width: 760px;
    margin: 0 auto;
  }

  /* 見出しブロックは横スクと無関係に従来の細幅を維持する。
     inner を ≥768px で 1280px まで広げる関係で、SectionHeading が間延びしないよう個別に絞る。 */
  .devflow__inner > :global(.section-heading) {
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
  }

  .devflow :global(.section-heading__lead) {
    color: rgba(58, 50, 48, 0.85);
  }

  /* カードリスト（SP は縦並び、PC は横並び）。 */
  .devflow__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;

    overflow-x: auto;
    overflow-y: hidden;

    /* scrollbar UI は隠す（横スクは JS + ネイティブ両対応） */
    scrollbar-width: none;
    -ms-overflow-style: none;

    /* テキスト選択防止: dragstart + pointermove preventDefault が一次防御。
       user-select: none は念のための保険として残す（子の focus は壊れない） */
    -webkit-user-select: none;
    user-select: none;

    /* 縦スワイプはネイティブの縦スクに譲り、横は JS（pointer events）で制御 */
    touch-action: pan-y;

    cursor: grab;
  }
  .devflow__list:active {
    cursor: grabbing;
  }
  .devflow__list::-webkit-scrollbar {
    display: none;
  }

  .devflow__step {
    background: #FFFBF3;
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.25s var(--ease), box-shadow 0.25s var(--ease), transform 0.25s var(--ease);
  }

  .devflow__step-btn {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1.25rem 1.25rem 1.5rem;
    width: 100%;
    height: 100%;
    text-align: left;
    background: transparent;
    border: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
    border-radius: var(--radius);
  }

  .devflow__step:hover {
    border-color: var(--c-accent);
    box-shadow: var(--shadow-sm);
    transform: translateY(-2px);
  }

  .devflow__step:focus-within {
    border-color: var(--c-accent);
    box-shadow: var(--shadow-sm);
  }

  .devflow__step-btn:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: 3px;
  }

  .devflow__content {
    flex: 1 1 auto;
    min-width: 0;
  }

  .devflow__more {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.85rem;
    font-family: var(--font-accent);
    font-size: 0.85rem;
    color: var(--c-accent);
    transition: gap 0.2s var(--ease);
  }
  .devflow__step:hover .devflow__more {
    gap: 0.55rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .devflow__step,
    .devflow__more {
      transition: none;
    }
    .devflow__step:hover {
      transform: none;
    }
  }

  .devflow__no {
    flex-shrink: 0;
    font-family: var(--font-accent);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1;
    color: var(--c-accent);
    font-feature-settings: 'tnum' 1;
    padding-top: 0.1rem;
  }

  .devflow__title {
    margin: 0 0 0.2rem;
    font-family: var(--font-head);
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--c-main);
  }

  .devflow__who {
    margin: 0 0 0.5rem;
    font-family: var(--font-accent);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--c-main-mute);
  }

  .devflow__body {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1.235rem;
    line-height: 1.8;
    color: rgba(58, 50, 48, 0.85);
  }

  .devflow__epilog {
    position: relative;
    z-index: 10000;
    max-width: 760px;
    margin: 0.33rem auto clamp(6rem, 18vh, 12rem);
    padding: 0 1.5rem;
  }

  .devflow__epilog-heading {
    font-family: var(--font-head);
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    font-weight: 600;
    color: var(--c-main);
    margin: 0 0 0.75rem;
    line-height: 1.6;
  }

  .devflow__epilog-lead,
  .devflow__epilog-summary {
    font-family: var(--font-body);
    font-size: 1.235rem;
    color: rgba(58, 50, 48, 0.85);
    line-height: 1.85;
    margin: 0 0 1rem;
  }

  .devflow__epilog-summary {
    margin-bottom: 0;
  }

  .devflow__matrix {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0 1.5rem;
    background: color-mix(in srgb, var(--c-paper) 70%, transparent);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .devflow__matrix th,
  .devflow__matrix td {
    padding: 0.95rem 1rem;
    vertical-align: top;
    text-align: left;
    border-bottom: 1px solid var(--c-border);
    font-size: 1.235rem;
    line-height: 1.7;
  }

  .devflow__matrix th {
    background: color-mix(in srgb, var(--c-paper-deep) 80%, transparent);
    font-family: var(--font-head);
    font-weight: 600;
    color: var(--c-main);
  }

  .devflow__matrix td:first-child {
    width: 30%;
    font-weight: 600;
    color: var(--c-main);
    white-space: nowrap;
  }

  .devflow__matrix td:last-child {
    color: rgba(58, 50, 48, 0.85);
  }

  .devflow__matrix tr:last-child td {
    border-bottom: none;
  }

  @media (max-width: 480px) {
    .devflow__step-btn {
      padding: 1.25rem 1.25rem;
      gap: 1rem;
    }

    .devflow__no {
      font-size: 1.25rem;
    }
  }

  @media (max-width: 767px) {
    .devflow__matrix {
      border-radius: var(--radius);
    }

    .devflow__matrix thead {
      display: none;
    }

    .devflow__matrix,
    .devflow__matrix tbody,
    .devflow__matrix tr,
    .devflow__matrix td {
      display: block;
      width: 100%;
    }

    .devflow__matrix tr {
      padding: 0.75rem 0;
      border-bottom: 1px solid var(--c-border);
    }

    .devflow__matrix tr:last-child {
      border-bottom: none;
    }

    .devflow__matrix td {
      padding: 0.25rem 1rem;
      border-bottom: none;
      font-size: 1.235rem;
    }

    .devflow__matrix td:first-child {
      width: 100%;
      white-space: normal;
      padding-bottom: 0.35rem;
      font-size: 1.235rem;
    }

    .devflow__matrix td:last-child {
      padding-top: 0;
      padding-left: 1rem;
      line-height: 1.7;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .devflow {
      background-color: var(--c-coffee-stain);
      background-color: var(--c-coffee-stain-soft);
      background-image: var(--paper-noise-url);
      background-repeat: repeat;
    }
  }

  /* PC: 横並びカードリスト。
     - 子合計幅 < 親幅（PC ワイド）: justify-content: safe center で中央寄せ、横スクなし
     - 子合計幅 > 親幅（タブレット）: ネイティブ overflow-x: auto で横スク
     カード幅・gap は commit eac5435 当時と一致。 */
  @media (min-width: 768px) {
    .devflow {
      padding-left: 0;
      padding-right: 0;
      overflow: visible;
    }

    .devflow__pin {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      padding: calc(var(--space-snug) * 0.6) 0 0;
      /* スクロールコンテナは子の .devflow__list 自身に統一。
         ここに overflow-x を持たせると親側がスクロールしてしまい、
         horizontal-wheel-drag.ts が list.scrollWidth === list.clientWidth と判定して
         即 return する（wheel→横スク変換が効かなくなる）。 */
      overflow: visible;
    }

    .devflow__inner {
      max-width: none;
      margin: 0;
      padding: 0 1.5rem;
    }

    .devflow__list {
      flex-direction: row;
      flex-wrap: nowrap;
      gap: 2rem;
      align-items: stretch;
      will-change: transform;
      scroll-behavior: auto;
      justify-content: safe center;
    }

    .devflow__step {
      flex: 0 0 auto;
      width: clamp(220px, 32vw, 320px);
      min-width: clamp(220px, 32vw, 320px);
    }

    .devflow__step-btn {
      flex-direction: column;
      align-items: flex-start;
    }

    .devflow__epilog {
      width: min(760px, calc(100% - 3rem));
    }
  }

  /* SP / タブレット (< 768px): カードリスト自体も横並び + 横スクで一貫性を保つ。
     カード幅は PC と同じ clamp。
     section に padding-inline: 1.5rem が掛かっているので、スクロール域を画面端まで広げるため
     負 margin で打ち消し、list 自身に同等の padding-inline を持たせる。 */
  @media (max-width: 767px) {
    .devflow__list {
      flex-direction: row;
      flex-wrap: nowrap;
      gap: 1rem;
      margin-inline: -1.5rem;
      padding-inline: 1.5rem;
      padding-block: 0.25rem;
      scroll-behavior: auto;
    }

    .devflow__step {
      flex: 0 0 auto;
      width: clamp(220px, 32vw, 320px);
      min-width: clamp(220px, 32vw, 320px);
    }
  }

  /* ===== 詳細モーダル ===== */
  .devflow-modal {
    border: none;
    padding: 0;
    background: transparent;
    max-width: min(680px, calc(100vw - 2rem));
    width: 100%;
    max-height: calc(100vh - 2rem);
    border-radius: var(--radius);
  }
  .devflow-modal::backdrop {
    background: rgba(58, 50, 48, 0.55);
    backdrop-filter: blur(3px);
  }
  .devflow-modal[open] {
    animation: devflow-modal-in 0.25s var(--ease);
  }
  @keyframes devflow-modal-in {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .devflow-modal[open] { animation: none; }
  }

  .devflow-modal__inner {
    position: relative;
    background: var(--c-paper);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    display: flex;
    flex-direction: column;
    max-height: calc(100vh - 2rem);
    overflow-y: auto;
    padding: 1rem;
    scrollbar-width: thin;
  }

  .devflow-modal__close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 2;
    background: var(--c-paper);
    border: 1px solid var(--c-border);
    border-radius: 999px;
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--c-main);
    cursor: pointer;
    flex-shrink: 0;
    transition: background 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .devflow-modal__close:hover {
    background: var(--c-paper-deep);
    border-color: var(--c-main-mute);
  }
  .devflow-modal__close:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: 2px;
  }

  .devflow-modal__image {
    display: block;
    width: 100%;
    max-width: min(720px, 90vw);
    height: auto;
    margin: 0 auto;
  }

  @media (max-width: 640px) {
    .devflow-modal {
      max-width: 100vw;
      max-height: 100vh;
      border-radius: 0;
      margin: 0;
    }
    .devflow-modal__inner {
      border-radius: 0;
      max-height: 100vh;
      padding: 0.5rem;
    }
    .devflow-modal__image {
      max-width: 100%;
    }
  }
</style>
