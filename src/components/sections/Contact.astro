---
// S9 連絡先。問い合わせフォームの骨格（送信挙動は未実装）。
// 領域 B・C2 実背景。SLA は範囲表現「平日 1〜2 営業日以内」。
import SectionHeading from '../SectionHeading.astro';
---
<section class="contact" id="contact">
  <div class="contact__inner">
    <SectionHeading
      title="連絡先"
      lead="ご相談・お見積もりはこちらから。平日 1〜2 営業日以内にお返事します。"
    />
    <form class="contact__form" data-phase5-pending>
      <div class="contact__field">
        <label class="contact__label" for="contact-name">お名前</label>
        <input class="contact__input" id="contact-name" type="text" name="name" autocomplete="name" required />
      </div>
      <div class="contact__field">
        <label class="contact__label" for="contact-email">メールアドレス</label>
        <input class="contact__input" id="contact-email" type="email" name="email" autocomplete="email" required />
      </div>
      <div class="contact__field">
        <label class="contact__label" for="contact-message">ご相談内容</label>
        <textarea class="contact__textarea" id="contact-message" name="message" rows="5" required></textarea>
      </div>
      <button class="contact__button" type="submit">送信する</button>
      <p class="contact__note">いただいた内容は、ご相談への対応にのみ使用します。</p>
    </form>
  </div>
</section>

<style>
  .contact {
    padding: var(--space-base) 1.5rem;
    background: var(--c-paper);
  }
  .contact__inner {
    max-width: 600px;
    margin: 0 auto;
  }
  .contact__form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .contact__field {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .contact__label {
    font-family: var(--font-accent);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    color: var(--c-main-mute);
  }
  .contact__input,
  .contact__textarea {
    width: 100%;
    box-sizing: border-box;
    padding: 0.8rem 1rem;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--c-main);
    background: #fff;
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
  }
  .contact__textarea {
    resize: vertical;
  }
  .contact__input:focus-visible,
  .contact__textarea:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: 1px;
  }
  .contact__button {
    align-self: flex-start;
    padding: 0.85rem 2rem;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    color: #fff;
    background: var(--c-accent);
    border: none;
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.25s var(--ease), transform 0.25s var(--ease);
  }
  .contact__button:hover {
    background: var(--c-accent-dark);
    transform: translateY(-1px);
  }
  .contact__note {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1.04rem;
    line-height: 1.7;
    color: var(--c-main-mute);
  }
</style>
