---
// S3 メンバー紹介（設計書 §4.2）。MemberCard × 5。役割明示優先・メンバーカラーは装飾のみ。
// テキストは D7 適合・W1 統一（メンバー表記、人数は文言化しない）。
import SectionHeading from '../SectionHeading.astro';
import MemberCard from '../MemberCard.astro';
import Decor from '../Decor.astro';

const members = [
  {
    name: 'あめまみれ',
    role: 'Founder',
    tagline: '人間。要件定義やコードチェックを行い、開発フローすべてを監視する。',
    color: 'var(--m-ame)',
    image: '/members/amemamire.png',
  },
  {
    name: 'さき',
    role: 'CEO',
    tagline: '仕様書作成やメンバー間の橋渡し、実機テストを担当。',
    color: 'var(--m-saki)',
    image: '/members/saki.png',
  },
  {
    name: 'ろぴ',
    role: 'CTO',
    tagline: '設計書作成と二次テスト、コードレビューやリファクタリングを担当。',
    color: 'var(--m-ropi)',
    image: '/members/ropi.png',
  },
  {
    name: 'みつる',
    role: 'Engineer',
    tagline: '設計書をもとに、実装から一次テストまで担当。ファイル管理も行う。',
    color: 'var(--m-mitsuru)',
    image: '/members/mituru.png',
  },
  {
    name: 'ともみ',
    role: 'Researcher',
    tagline: '市場調査と技術調査担当。仕様書レビューや執筆も行う。',
    color: 'var(--m-tomomi)',
    image: '/members/tomomi.png',
  },
];
---
<section class="members" id="members" data-bg="paper-warm" data-step-section>
  {/* F4-e ちらほら視差装飾（設計書 §5.8 / タスク G）。
      pin セクション内では noReveal で reveal.ts 管理外（順次出現カウントに装飾を混ぜない）。 */}
  <Decor char="mituru" depth="front" corner="top-right" noReveal />
  <div class="members__inner">
    <SectionHeading
      title="メンバー紹介"
      lead="5 人それぞれに役割があります。"
    />
    <div class="members__grid">
      {members.map((m) => (
        <MemberCard
          name={m.name}
          role={m.role}
          tagline={m.tagline}
          color={m.color}
          image={m.image}
        />
      ))}
    </div>
  </div>
</section>

<style>
  .members {
    padding: var(--space-base) 1.5rem;
    /* F4-e 装飾の absolute 配置基点・はみ出し防止（§5.8 / タスク G） */
    position: relative;
    overflow: hidden;
    /* 2026-06-20 あめさん FB: S2 margin-top -100vh の連鎖シフトを部分相殺・見出しが見える時間確保 */
    /* 2026-06-20 二回目 FB: 倍化 50vh→100vh / 25vh→50vh */
    margin-top: 100vh;
  }
  @media (max-width: 767px) {
    .members {
      margin-top: 50vh;
    }
  }
  /* Members だけグランドコンテナ（--max-w: 1120px）より広い 1500px に拡張（2026-06-21 あめさん FB）。
     PC 1920px viewport の左右余白を使い切り、5列×2:3 カードを十分な幅で見せる。
     SP/タブレットは min() で viewport-4rem に縮むため安全。グランドコンテナ自体は触らない。 */
  .members__inner {
    max-width: min(1500px, 100vw - 4rem);
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }
  /* M1（2026-06-21 みつる調査→さき三次→みつる実装）: 中域段階追加でカード潰れ回避。
     ~479: 1列 / 480+: 2列 / 768+: 3列(3+2段) / 1024+: 4列(4+1段) / 1280+: 5列横並び。
     1024px で 5 列だとカード 172px で窮屈、1280 から 5 列にする（さき判断）。 */
  .members__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 480px) {
    .members__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }
  }
  @media (min-width: 768px) {
    .members__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }
  @media (min-width: 1024px) {
    .members__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }
  @media (min-width: 1280px) {
    .members__grid {
      grid-template-columns: repeat(5, 1fr);
      gap: 1.5rem;
    }
  }
</style>
