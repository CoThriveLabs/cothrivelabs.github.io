---
// メンバー紹介セクション。MemberCard × 5。役割明示優先・メンバーカラーは装飾のみに使う。
import SectionHeading from '../SectionHeading.astro';
import MemberCard from '../MemberCard.astro';

const members = [
  {
    name: 'あめまみれ',
    role: 'Founder',
    tagline: '人間。要件定義やコードチェックを行い、開発フローすべてを監視する。',
    color: 'var(--m-ame)',
    image: '/members/amemamire.png',
  },
  {
    name: 'さき',
    role: 'CEO',
    tagline: '仕様書作成やメンバー間の橋渡し、実機テストを担当。',
    color: 'var(--m-saki)',
    image: '/members/saki.png',
  },
  {
    name: 'ろぴ',
    role: 'CTO',
    tagline: '設計書作成と二次テスト、コードレビューやリファクタリングを担当。',
    color: 'var(--m-ropi)',
    image: '/members/ropi.png',
  },
  {
    name: 'みつる',
    role: 'Engineer',
    tagline: '設計書をもとに、実装から一次テストまで担当。ファイル管理も行う。',
    color: 'var(--m-mitsuru)',
    image: '/members/mituru.png',
  },
  {
    name: 'ともみ',
    role: 'Researcher',
    tagline: '市場調査と技術調査担当。仕様書レビューや執筆も行う。',
    color: 'var(--m-tomomi)',
    image: '/members/tomomi.png',
  },
];
---
<section class="members" id="members" data-bg="paper-warm" data-step-section>
  <div class="members__inner">
    <SectionHeading
      title="メンバー紹介"
      lead="5 人それぞれに役割があります。"
    />
    <div class="members__grid">
      {members.map((m) => (
        <MemberCard
          name={m.name}
          role={m.role}
          tagline={m.tagline}
          color={m.color}
          image={m.image}
        />
      ))}
    </div>
  </div>
</section>

<style>
  .members {
    padding: calc(var(--space-base) * 0.6) 1.5rem;
    /* 装飾の absolute 配置基点・はみ出し防止 */
    position: relative;
    overflow: hidden;
    /* StudioAbout 側 margin-top:-100vh の連鎖シフトを部分相殺し、見出しが見える時間を確保する */
    margin-top: 100vh;
  }
  @media (max-width: 767px) {
    .members {
      margin-top: 50vh;
    }
    /* SP 2 列化でカード幅が狭くなるため、MemberCard 内要素を 0.9 倍に圧縮。
       :global で別 component のスコープを抜けて MemberCard の DOM に直接当てる。 */
    .members :global(.member-card__tilt) {
      padding: 1.8rem 1.35rem 1.575rem;
    }
    .members :global(.member-card__avatar) {
      width: 108px;
      height: 108px;
      margin-bottom: 1.35rem;
    }
    .members :global(.member-card__name) {
      font-size: 1.53rem;
      margin-bottom: 0.405rem;
    }
    .members :global(.member-card__role) {
      font-size: 1.035rem;
      margin-bottom: 1.125rem;
    }
    .members :global(.member-card__tagline) {
      font-size: 1.1115rem;
    }
  }
  /* Members だけグランドコンテナ（--max-w: 1120px）より広い 1500px に拡張する。
     PC 1920px viewport の左右余白を使い切り、5 列 × 2:3 カードを十分な幅で見せるため。
     SP / タブレットは min() で viewport - 4rem に縮むため安全。グランドコンテナ自体は触らない。 */
  .members__inner {
    max-width: min(1500px, 100vw - 4rem);
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }
  /* 中域ブレイクポイントを段階的に挟んでカード潰れを回避する。
     ~479: 1列 / 480+: 2列 / 768+: 3列(3+2段) / 1024+: 4列(4+1段) / 1280+: 5列横並び。
     1024px で 5 列だとカード 172px で窮屈なので、5 列化は 1280 から。 */
  .members__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.85rem;
  }
  @media (min-width: 480px) {
    .members__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }
  }
  @media (min-width: 768px) {
    .members__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }
  @media (min-width: 1024px) {
    .members__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }
  @media (min-width: 1280px) {
    .members__grid {
      grid-template-columns: repeat(5, 1fr);
      gap: 1.5rem;
    }
  }
</style>
