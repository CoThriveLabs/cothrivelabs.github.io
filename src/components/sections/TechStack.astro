---
// S7 技術スタック（設計書 §4.2 / §6 task5）。カテゴリ別 3 段グリッド・用途一言。領域 A 最終。
// C-DEEP 背景。各技術の公式配布ロゴ（simple-icons・CC0）をインライン SVG で表示。
// SVG は currentColor 塗りで、item ごとのブランドカラーを CSS color で当てる。
import SectionHeading from '../SectionHeading.astro';
import Decor from '../Decor.astro';
import astroLogo from '../../assets/tech-logos/astro.svg?raw';
import html5Logo from '../../assets/tech-logos/html5.svg?raw';
import cfWorkersLogo from '../../assets/tech-logos/cloudflareworkers.svg?raw';
import fastapiLogo from '../../assets/tech-logos/fastapi.svg?raw';
import claudeLogo from '../../assets/tech-logos/claude.svg?raw';
import wordpressLogo from '../../assets/tech-logos/wordpress.svg?raw';

const categories = [
  {
    name: 'フロントエンド',
    items: [
      { name: 'Astro', use: 'サイト・LP の土台。このサイトも Astro 製。', logo: astroLogo, color: '#BC52EE' },
      { name: 'HTML / CSS / JS', use: '素の Web 標準で軽く堅く作る。', logo: html5Logo, color: '#E34F26' },
    ],
  },
  {
    name: 'バックエンド・インフラ',
    items: [
      { name: 'Cloudflare Workers', use: 'フォーム送信などのサーバー処理を無料枠で。', logo: cfWorkersLogo, color: '#F38020' },
      { name: 'FastAPI / SQLite', use: 'Sprout のような小さな API + DB。', logo: fastapiLogo, color: '#009688' },
    ],
  },
  {
    name: 'AI・その他',
    items: [
      { name: 'Claude API', use: 'AI 機能の組み込み。JukuMate で本番投入。', logo: claudeLogo, color: '#D97757' },
      { name: 'WordPress', use: '既存 WordPress サイトの制作・調整。', logo: wordpressLogo, color: '#21759B' },
    ],
  },
];
---
<section class="techstack" id="techstack" data-bg="paper" data-step-section>
  {/* F4-e ちらほら視差装飾（設計書 §5.8 / タスク G）。pin セクション内は noReveal。 */}
  <Decor char="saki" depth="back" corner="bottom-right" noReveal />
  <div class="techstack__inner">
    <SectionHeading
      title="技術スタック"
      lead="案件に合わせて、ご希望のスタックも、コストを抑えながら堅く作れる組み合わせも選べます。"
    />
    <div class="techstack__grid">
      {categories.map((cat) => (
        <div class="techstack__cat" data-reveal>
          <h3 class="techstack__cat-name">{cat.name}</h3>
          <ul class="techstack__items">
            {cat.items.map((it) => (
              <li class="techstack__item">
                <span class="techstack__item-logo" style={`color:${it.color}`} aria-hidden="true" set:html={it.logo} />
                <span class="techstack__item-body">
                  <span class="techstack__item-name">{it.name}</span>
                  <span class="techstack__item-use">{it.use}</span>
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .techstack {
    padding: var(--space-base) 1.5rem;
    /* F4-e 装飾の absolute 配置基点・はみ出し防止（§5.8 / タスク G） */
    position: relative;
    overflow: hidden;
  }
  .techstack__inner {
    max-width: var(--max-w);
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }
  .techstack__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }
  .techstack__cat {
    padding: 1.75rem;
    background: color-mix(in srgb, var(--c-paper) 70%, transparent);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
  }
  .techstack__cat-name {
    margin: 0 0 1rem;
    font-family: var(--font-head);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--c-main);
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--c-border);
  }
  .techstack__items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .techstack__item {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
  }
  .techstack__item-logo {
    flex-shrink: 0;
    display: inline-flex;
    width: 1.5rem;
    margin-top: 0.15rem;
  }
  .techstack__item-logo :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }
  .techstack__item-body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .techstack__item-name {
    font-family: var(--font-accent);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--c-accent);
  }
  .techstack__item-use {
    font-family: var(--font-body);
    font-size: 0.85rem;
    line-height: 1.7;
    color: var(--c-main-soft);
  }

  /* fb7 §8（要件6＋add1）: 制作物以降の「薄シミ色＋紙テクスチャ noise」背景（シミ全面維持の継続）。
     §11: 全幅 no-preference ガード（SP でも ON・reduce のみ除外）。§4.4: 常時 z:10000（シミ超え）。
     既存の position:relative / overflow:hidden（装飾基点）はそのまま活かす。
     R13: color-mix 非対応向けに background-color ベタ値を前置きフォールバック。
     fb7 rev4.3 §2.1: rev4.2 の sticky 覆い被さりは reveal pin（JS）と同一要素競合し実機破綻
       （techstack 区間で scrollTo がロック・ComingSoon が Contact に到達不可）したため撤去。
       技スタ→ComingSoon は通常スクロールに確定（案c・あめさん合意）。position は relative に戻す
       （base と同値＝§8 で position を上書きしない状態）。z-index:10000・背景・noise は維持。 */
  @media (prefers-reduced-motion: no-preference) {
    .techstack {
      position: relative;
      z-index: 10000;
      background-color: var(--c-coffee-stain);
      background-color: var(--c-coffee-stain-soft);
      background-image: var(--paper-noise-url);
      background-repeat: repeat;
    }
  }
</style>
