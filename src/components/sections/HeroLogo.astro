---
// 手書きロゴ「こすらぼ Co-Thrive Labs」。
// 元画像を 2 色（テラコッタ／ダークブラウン）に分離 → potrace → svgo 最適化した
// fill path 2 本をインライン SVG 化。同じ viewBox 上に重ねて元画像を再現。
// お絵描きアニメ: 塗りロゴを「太い横帯ストロークの mask」で覆い、mask path の
// stroke-dashoffset を 1→0 にして左から描かれていく（stroke-dashoffset 方式）。
// fill を保つため描画完了後も手書きの塗りが残る（中空縁取りにならない）。
// このアニメは手書き感の核なので reduced-motion でも無効化しない（完了状態は forwards で固定）。
import { heroLogoPathKosurabo, heroLogoPathCoThrive, heroLogoViewBox } from './heroLogoPath';

const VBX = 74, VBY = 88, W = 1653, H = 723;
// 上下 2 本の太い横帯で全面を覆い、左→右へ dashoffset で出す
const bandWidth = Math.round(H * 0.6);
const topY = VBY + Math.round(H * 0.3);
const botY = VBY + Math.round(H * 0.72);
const wipeD = `M${VBX} ${topY}H${VBX + W}M${VBX} ${botY}H${VBX + W}`;
const maskId = 'hero-logo-wipe';
---
<svg
  class="hero-logo"
  viewBox={heroLogoViewBox}
  role="img"
  aria-label="こすらぼ（Co-Thrive Labs）"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <mask id={maskId} maskUnits="userSpaceOnUse" x={VBX} y={VBY} width={W} height={H}>
      <path
        class="hero-logo__wipe"
        d={wipeD}
        stroke="#fff"
        stroke-width={bandWidth}
        fill="none"
        pathLength="1"
      />
    </mask>
  </defs>
  <path d={heroLogoPathKosurabo} fill="var(--c-accent)" fill-rule="evenodd" mask={`url(#${maskId})`} />
  <path d={heroLogoPathCoThrive} fill="#3A3230" fill-rule="evenodd" mask={`url(#${maskId})`} />
</svg>

<style>
  .hero-logo {
    width: min(480px, 50vw);
    height: auto;
    display: block;
  }
  .hero-logo__wipe {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: hero-logo-draw 2.4s var(--ease) 0.3s forwards;
  }
  @keyframes hero-logo-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  /* 手書き感の核なので reduced-motion でも止めない（他演出は即時表示だがこれは例外）。
     配慮として完了状態は確実に表示されるよう forwards で固定。 */
</style>
