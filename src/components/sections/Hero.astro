---
// S1 ファーストビュー。CTA なし・h1=サイト名・手書きロゴはプレースホルダ枠。
// 集合イラストはメンバーを個別 DOM レイヤー（L1/L2）に分割し、
// data-hero-layer 属性 + will-change 予約で Hero 奥入り込み演出が乗る形にする。
// 背景は紙 C2。スクロール誘導のみ。
import { Picture } from 'astro:assets';
import centerImg from '../../assets/hero/center.png';
import tomomiImg from '../../assets/hero/tomomi.png';
import ropiImg from '../../assets/hero/ropi.png';
import HeroLogo from './HeroLogo.astro';
---
<section class="hero" id="hero">
  <div class="hero__inner">
    {/* 手書きロゴ（こすらぼ）: stroke-dashoffset お絵描きアニメ */}
    <div class="hero__logo">
      <HeroLogo />
    </div>

    <h1 class="sr-only">Co-Thrive Labs（こすらぼ）</h1>

    {/* S1 一行コピー。data-reveal は付けない（LCP/CLS 安定優先）。
        Hero 入り込み演出 heroImmersion.ts の transform 対象は logo/art/L1/L2 のままで
        tagline は独立（演出に巻き込まない）。 */}
    <p class="hero__tagline">ー 人とAIで、確かなものを作るWeb開発スタジオ ー</p>

    {/* 集合イラスト: メンバーを個別レイヤーに分割（Hero 入り込み演出の前提構造） */}
    <div class="hero__art" role="img" aria-label="Co-Thrive Labs のメンバー 5 人の集合イラスト">
      {/* L2 中央・ゆっくり */}
      <div class="hero__layer hero__layer--l2" data-hero-layer="l2" aria-hidden="true">
        <Picture
          src={centerImg}
          formats={['avif', 'webp']}
          alt=""
          width={1536}
          height={1024}
          fetchpriority="high"
          loading="eager"
          decoding="async"
        />
      </div>
      {/* L1 手前・速い */}
      <div class="hero__layer hero__layer--l1" data-hero-layer="l1" aria-hidden="true">
        <Picture
          src={tomomiImg}
          formats={['avif', 'webp']}
          alt=""
          width={1536}
          height={1024}
          fetchpriority="high"
          loading="eager"
          decoding="async"
        />
        <Picture
          src={ropiImg}
          formats={['avif', 'webp']}
          alt=""
          width={1536}
          height={1024}
          fetchpriority="high"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </div>

  <div class="hero__scroll" aria-hidden="true">
    <span class="hero__scroll-dot"></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 0;
    height: 100vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0;
    /* ロゴ + 集合イラストを 100vh 内に収納するため縦 padding を控えめに */
    padding: var(--space-base) -0.5rem var(--space-tight);
    text-align: center;
  }
  .hero__inner {
    position: relative;
    /* hero__art を 1.3 倍化（max 1196px）で許容するため max-width を 1196 + 余白で拡大 */
    max-width: 1200px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  /* 手書きロゴ */
  .hero__logo {
    display: flex;
    justify-content: center;
    /* opacity tween の GPU 合成ヒント */
    will-change: opacity;
    transform-origin: center center;
    /* SP 既定: scale なし（はみ出し回避）。PC（>= 768px）で scale(1.3) を後段の @media で適用 */
    transform: scale(1);
    max-width: 100%;
    /* SP 既定: 上に詰めて art との重なりを抑える。PC では @media で 3rem に上書き */
    margin-top: 1rem;
  }
  /* S1 一行コピー */
  .hero__tagline {
    font-family: var(--font-accent); /* Klee One */
    font-size: clamp(1.05rem, 1.4vw, 1.15rem);
    color: var(--c-main-soft);
    text-align: center;
    /* SP 既定: 親 .hero__inner で詰める。PC では @media で 3rem に上書き */
    margin-top: 1rem;
    line-height: 1.5;
  }
  /* SEO 用非表示 h1 */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }
  /* 集合イラスト（メンバー個別レイヤー・Hero 入り込み演出の前提構造） */
  .hero__art {
    position: relative;
    /* CSS scale ではなく width を直接拡大（GSAP transform tween との衝突回避）。
       1.3 倍化。vw は 100vw で上限丸め（横はみ出し抑制）。
       SP では @media で 92vw に抑え左右余裕確保。 */
    width: min(1196px, 100vw);
    aspect-ratio: 1536 / 1024;
    /* SP 既定: 56vh で 100vh 内収納。PC では @media で 75vh に拡張 */
    max-height: 56vh;
    /* SP 既定: art を logo に寄せず素直に並べる。PC では @media で -8rem に */
    margin-top: 0;
    /* translateY + scale の再描画ヒント（layer の will-change と分離） */
    will-change: transform;
  }
  /* 各レイヤーは枠全体に重ねる（3 枚が同一構図の透過 PNG で合わさり 1 枚絵になる） */
  .hero__layer {
    position: absolute;
    inset: 0;
  }
  .hero__layer :global(picture),
  .hero__layer :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  /* L2 中央: ゆっくり拡大 */
  .hero__layer--l2 {
    z-index: 1;
    will-change: transform, filter, opacity;
  }
  /* L1 手前: 外側へ大きく速く */
  .hero__layer--l1 {
    z-index: 2;
    will-change: transform, filter, opacity;
  }
  /* スクロール誘導 */
  .hero__scroll {
    position: absolute;
    bottom: 1.8rem;
    left: 50%;
    transform: translateX(-50%);
    width: 22px;
    height: 36px;
    border: 1.5px solid var(--c-main-mute);
    border-radius: 999px;
    display: flex;
    justify-content: center;
    padding-top: 7px;
  }
  .hero__scroll-dot {
    width: 3px;
    height: 8px;
    background: var(--c-main-soft);
    border-radius: 999px;
    animation: hero-scroll 1.8s var(--ease) infinite;
  }
  @keyframes hero-scroll {
    0%   { transform: translateY(0);    opacity: 1; }
    70%  { transform: translateY(10px); opacity: 0; }
    100% { transform: translateY(10px); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-dot { animation: none; }
  }

  /* タブレット帯（640-767px）: SP より少しゆとり・art の左右余裕は維持 */
  @media (min-width: 640px) and (max-width: 767px) {
    .hero__logo {
      margin-top: 2rem;
    }
    .hero__tagline {
      margin-top: 2rem;
    }
    .hero__art {
      width: min(1196px, 92vw);
      max-height: 60vh;
      margin-top: -2rem;
    }
  }

  /* PC（>= 768px）: ロゴ scale(1.3) を適用、各要素のゆとりを大きく */
  @media (min-width: 768px) {
    .hero {
      height: 100vh;
      padding: var(--space-base) 1rem;
    }
    .hero__logo {
      transform: scale(1.3);
      margin-top: 3rem;
      margin-bottom: 0;
    }
    .hero__tagline {
      margin-top: 3rem;
    }
    .hero__art {
      width: min(1196px, 100vw);
      max-height: 75vh;
      margin-top: -8rem;
    }
  }
</style>
