---
// S1 ファーストビュー（設計書 §4.2 / §5.2）。
// CTA なし・h1=サイト名・手書きロゴは Phase 3 素材待ちのためプレースホルダ枠。
// 集合イラストは Phase 3 で実体化：メンバーを個別 DOM レイヤー（L1/L2）に分割し、
// data-hero-layer 属性 + will-change 予約で Phase 4 演出 A（Hero 奥入り込み）が乗れる形にする。
// 演出（scale/translate/blur）は Phase 4。Phase 3 は静的レイヤー構造まで。
// 背景は紙 C2（領域 A 先頭）。スクロール誘導のみ。
import { Picture } from 'astro:assets';
import centerImg from '../../assets/hero/center.png';
import tomomiImg from '../../assets/hero/tomomi.png';
import ropiImg from '../../assets/hero/ropi.png';
import HeroLogo from './HeroLogo.astro';
---
<section class="hero" id="hero">
  <div class="hero__inner">
    {/* 手書きロゴ（こすらぼ）：stroke-dashoffset お絵描きアニメ */}
    <div class="hero__logo">
      <HeroLogo />
    </div>

    <h1 class="sr-only">Co-Thrive Labs（こすらぼ）</h1>

    {/* v1.4 S1 一行コピー（仕様書 v1.4 / 設計書 §4.5）。
        data-reveal は付けない（LCP/CLS 安定優先・ろぴ推奨）。
        演出 A heroImmersion.ts の transform 対象は既存 logo/art/L1/L2 のままで
        tagline は独立（演出に巻き込まない）。 */}
    <p class="hero__tagline">人と AI で、確かなものを作る Web 開発スタジオ</p>

    {/* 集合イラスト：メンバーを個別レイヤーに分割（Phase 4 演出 A の前提構造） */}
    <div class="hero__art" role="img" aria-label="Co-Thrive Labs のメンバー 5 人の集合イラスト">
      {/* L2 中央・ゆっくり：みつる + さき + あめまみれ */}
      <div class="hero__layer hero__layer--l2" data-hero-layer="l2" aria-hidden="true">
        <Picture
          src={centerImg}
          formats={['avif', 'webp']}
          alt=""
          width={1536}
          height={1024}
          fetchpriority="high"
          loading="eager"
          decoding="async"
        />
      </div>
      {/* L1 手前・速い：ともみ + ろぴ */}
      <div class="hero__layer hero__layer--l1" data-hero-layer="l1" aria-hidden="true">
        <Picture
          src={tomomiImg}
          formats={['avif', 'webp']}
          alt=""
          width={1536}
          height={1024}
          fetchpriority="high"
          loading="eager"
          decoding="async"
        />
        <Picture
          src={ropiImg}
          formats={['avif', 'webp']}
          alt=""
          width={1536}
          height={1024}
          fetchpriority="high"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </div>

  <div class="hero__scroll" aria-hidden="true">
    <span class="hero__scroll-dot"></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 0;
    height: 100vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0;
    /* あめさん FB 3: ロゴ＋集合イラストが 100vh 内に収まるよう縦 padding を縮小 */
    padding: var(--space-base) -0.5rem var(--space-tight);
    text-align: center;
  }
  .hero__inner {
    position: relative;
    /* あめさん FB 2: hero__art 1.3 倍化 (max 1196px) を許容するため max-width を 1196 + 余白 で拡大。 */
    max-width: 1200px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  /* 手書きロゴ */
  .hero__logo {
    display: flex;
    justify-content: center;
    margin-bottom: 0rem;
    /* 演出A rev2 段階0a: opacity tween 再描画ヒント */
    will-change: opacity;
    /* あめさん FB 3: SP（< 768px）では scale 1.0 維持（はみ出し回避）。PC 用 scale 1.3 は @media (min-width: 768px) で適用。 */
    transform-origin: center center;
    /* SP 既定: scale なし（はみ出し回避） */
    transform: scale(1);
    max-width: 100%;
  }
  /* v1.4 S1 一行コピー（設計書 §4.5） */
  .hero__tagline {
    font-family: var(--font-accent); /* Klee One */
    font-size: clamp(0.95rem, 1.4vw, 1.15rem);
    color: var(--c-main-soft);
    text-align: center;
    margin: 1rem 0 1.5rem;
    line-height: 1.5;
  }
  /* SEO 用非表示 h1 */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }
  /* 集合イラスト（メンバー個別レイヤー・Phase 4 演出 A の前提構造） */
  .hero__art {
    position: relative;
    /* あめさん FB 2: 初期サイズ 1.3 倍。CSS scale ではなく width を直接拡大（GSAP transform tween 衝突回避）。
       旧 min(920px, 96vw) → 1.3 倍。vw は 100vw で上限丸め（横はみ出し抑制）。
       あめさん FB 3: SP では 92vw に抑え左右余裕確保（< 768px は @media で上書き）。 */
    width: min(1196px, 100vw);
    aspect-ratio: 1536 / 1024;
    /* あめさん FB 3: 縦方向の制約。aspect-ratio が効くため max-height 指定で
       「縦が狭い PC では height 基準で width が自動縮小」される。Hero は height:100vh ＋
       logo / scroll-dot との縦同居スペースを考慮し 65vh で頭打ち。 */
    max-height: 65vh;
    margin-top: -5.0rem;
    /* 演出A rev2 段階0b: translateY + scale 再描画ヒント（layer の will-change と分離） */
    will-change: transform;
  }
  /* 各レイヤーは枠全体に重ねる（3 枚が同一構図の透過 PNG で合わさり 1 枚絵になる） */
  .hero__layer {
    position: absolute;
    inset: 0;
  }
  .hero__layer :global(picture),
  .hero__layer :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  /* L2 中央・ゆっくり：その場でゆっくり拡大（Phase 4） */
  .hero__layer--l2 {
    z-index: 1;
    will-change: transform, filter, opacity;
  }
  /* L1 手前・速い：外側へ大きく速く（Phase 4） */
  .hero__layer--l1 {
    z-index: 2;
    will-change: transform, filter, opacity;
  }
  /* スクロール誘導 */
  .hero__scroll {
    position: absolute;
    bottom: 1.8rem;
    left: 50%;
    transform: translateX(-50%);
    width: 22px;
    height: 36px;
    border: 1.5px solid var(--c-main-mute);
    border-radius: 999px;
    display: flex;
    justify-content: center;
    padding-top: 7px;
  }
  .hero__scroll-dot {
    width: 3px;
    height: 8px;
    background: var(--c-main-soft);
    border-radius: 999px;
    animation: hero-scroll 1.8s var(--ease) infinite;
  }
  @keyframes hero-scroll {
    0%   { transform: translateY(0);    opacity: 1; }
    70%  { transform: translateY(10px); opacity: 0; }
    100% { transform: translateY(10px); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-dot { animation: none; }
  }
  @media (min-width: 640px) {
    .hero {
      height: 100vh;
      padding: var(--space-base) 1rem;
    }
    .hero__logo {
      margin-bottom: 1.0rem;
    }

  }
  @media (max-width: 640px) {

    .hero__logo {
      margin-bottom: 0rem;
    }
    .hero__art {
      margin-top: 0rem;
    }
  }
  /* あめさん FB 3: SP（< 768px）はロゴ scale 据え置き、集合イラストは 92vw に抑え max-height は 56vh に。 */
  /* M7（2026-06-21 みつる調査→さき三次→みつる実装）: BP 値統一 767.98 → 767。 */
  @media (max-width: 767px) {
    .hero__logo {
      transform: scale(1);
    }
    .hero__art {
      width: min(1196px, 92vw);
      max-height: 56vh;
    }
  }
  /* あめさん FB 3: PC（>= 768px）でのみロゴ scale(1.3) を適用（はみ出し回避）。 */
  @media (min-width: 768px) {
    .hero__logo {
      transform: scale(1.3);
    }
  }
</style>
