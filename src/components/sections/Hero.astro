---
// S1 ファーストビュー（設計書 §4.2 / §5.2）。
// CTA なし・h1=サイト名・手書きロゴは Phase 3 素材待ちのためプレースホルダ枠。
// 集合イラストは Phase 3 で実体化：メンバーを個別 DOM レイヤー（L1/L2）に分割し、
// data-hero-layer 属性 + will-change 予約で Phase 4 演出 A（Hero 奥入り込み）が乗れる形にする。
// 演出（scale/translate/blur）は Phase 4。Phase 3 は静的レイヤー構造まで。
// 背景は紙 C2（領域 A 先頭）。スクロール誘導のみ。
import { Picture } from 'astro:assets';
import centerImg from '../../assets/hero/center.png';
import tomomiImg from '../../assets/hero/tomomi.png';
import ropiImg from '../../assets/hero/ropi.png';
---
<section class="hero" id="hero" data-reveal>
  <div class="hero__inner">
    {/* 手書きロゴ枠（task 2 で SVG ロゴに差し替え） */}
    <div class="hero__logo-frame" aria-hidden="true">
      <span class="hero__logo-placeholder">こすらぼ ロゴ（準備中）</span>
    </div>

    <h1 class="hero__title">Co-Thrive Labs</h1>
    <p class="hero__reading">こすらぼ</p>

    {/* 集合イラスト：メンバーを個別レイヤーに分割（Phase 4 演出 A の前提構造） */}
    <div class="hero__art" role="img" aria-label="Co-Thrive Labs のメンバー 5 人の集合イラスト">
      {/* L2 中央・ゆっくり：みつる + さき + あめまみれ */}
      <div class="hero__layer hero__layer--l2" data-hero-layer="l2" aria-hidden="true">
        <Picture
          src={centerImg}
          formats={['avif', 'webp']}
          alt=""
          width={1536}
          height={1024}
          fetchpriority="high"
          loading="eager"
          decoding="async"
        />
      </div>
      {/* L1 手前・速い：ともみ + ろぴ */}
      <div class="hero__layer hero__layer--l1" data-hero-layer="l1" aria-hidden="true">
        <Picture
          src={tomomiImg}
          formats={['avif', 'webp']}
          alt=""
          width={1536}
          height={1024}
          fetchpriority="high"
          loading="eager"
          decoding="async"
        />
        <Picture
          src={ropiImg}
          formats={['avif', 'webp']}
          alt=""
          width={1536}
          height={1024}
          fetchpriority="high"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </div>

  <div class="hero__scroll" aria-hidden="true">
    <span class="hero__scroll-dot"></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0;
    padding: var(--space-loose) 1.5rem var(--space-base);
    text-align: center;
  }
  .hero__inner {
    position: relative;
    max-width: 760px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  /* ロゴ枠（準備中プレースホルダ） */
  .hero__logo-frame {
    width: min(280px, 70vw);
    aspect-ratio: 16 / 5;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 2rem;
    border: 1px dashed var(--c-border);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--c-paper-deep) 50%, transparent);
  }
  .hero__logo-placeholder {
    font-family: var(--font-accent);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    color: var(--c-main-mute);
  }
  .hero__title {
    margin: 0;
    font-family: var(--font-head);
    font-weight: 800;
    font-size: var(--fs-h1);
    line-height: 1.2;
    letter-spacing: 0.02em;
    color: var(--c-main);
  }
  .hero__reading {
    margin: 0.5rem 0 0;
    font-family: var(--font-accent);
    font-size: 1rem;
    letter-spacing: 0.3em;
    color: var(--c-accent);
  }
  /* 集合イラスト（メンバー個別レイヤー・Phase 4 演出 A の前提構造） */
  .hero__art {
    position: relative;
    width: min(560px, 90vw);
    aspect-ratio: 1536 / 1024;
    margin-top: 2.5rem;
  }
  /* 各レイヤーは枠全体に重ねる（3 枚が同一構図の透過 PNG で合わさり 1 枚絵になる） */
  .hero__layer {
    position: absolute;
    inset: 0;
  }
  .hero__layer :global(picture),
  .hero__layer :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  /* L2 中央・ゆっくり：その場でゆっくり拡大（Phase 4） */
  .hero__layer--l2 {
    z-index: 1;
    will-change: transform;
  }
  /* L1 手前・速い：外側へ大きく速く（Phase 4） */
  .hero__layer--l1 {
    z-index: 2;
    will-change: transform;
  }
  /* スクロール誘導 */
  .hero__scroll {
    position: absolute;
    bottom: 1.8rem;
    left: 50%;
    transform: translateX(-50%);
    width: 22px;
    height: 36px;
    border: 1.5px solid var(--c-main-mute);
    border-radius: 999px;
    display: flex;
    justify-content: center;
    padding-top: 7px;
  }
  .hero__scroll-dot {
    width: 3px;
    height: 8px;
    background: var(--c-main-soft);
    border-radius: 999px;
    animation: hero-scroll 1.8s var(--ease) infinite;
  }
  @keyframes hero-scroll {
    0%   { transform: translateY(0);    opacity: 1; }
    70%  { transform: translateY(10px); opacity: 0; }
    100% { transform: translateY(10px); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-dot { animation: none; }
  }

  @media (max-width: 640px) {
    .hero {
      min-height: 84vh;
      padding: var(--space-base) 1.25rem;
    }
  }
</style>
