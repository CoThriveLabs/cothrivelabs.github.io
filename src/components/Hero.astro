---
// Hero セクション: ファーストビュー
// ロゴ・キャッチコピー・サブコピー・Works へのスクロール CTA
---
<section class="hero" id="hero">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="hero-decor" aria-hidden="true">
    {/* 装飾A: 左上の葉っぱクラスタ（Co-Thrive Labs の「育つ」象徴） */}
    <svg class="hero-decor-leaves" viewBox="0 0 200 200" preserveAspectRatio="xMidYMid meet">
      <path d="M40 100 Q40 50 100 50 Q160 60 150 110 Q120 140 80 130 Q50 125 40 100 Z"
            fill="var(--color-primary)" opacity="0.10" />
      <path d="M70 110 Q100 90 130 80"
            stroke="var(--color-primary)" stroke-width="1.5" fill="none" opacity="0.18" />
      <path d="M180 60 Q175 80 170 95"
            stroke="var(--color-primary)" stroke-width="1.6" fill="none" opacity="0.15" />
      <circle cx="180" cy="58" r="4" fill="var(--color-primary)" opacity="0.18" />
    </svg>
    {/* 装飾B: 右下から斜めに伸びる点線パス + 終端の芽 */}
    <svg class="hero-decor-dashed" viewBox="0 0 280 200" preserveAspectRatio="xMidYMid meet">
      <path d="M10 180 Q80 120 150 130 Q230 140 270 60"
            stroke="var(--color-accent)" stroke-width="1.4"
            stroke-dasharray="3 6" fill="none" opacity="0.25" />
      <circle cx="270" cy="60" r="3.5" fill="var(--color-accent)" opacity="0.35" />
    </svg>
  </div>
  <div class="hero-inner">
    <p class="hero-logo">Co-Thrive Labs</p>
    <h1 class="hero-copy">
      <span class="hero-line">AI 4 人と一緒に育てる、</span>
      <span class="hero-line"><span class="accent">こすらぼ</span>の作品集</span>
    </h1>
    <p class="hero-sub">
      Co-Thrive Labs — AI 社員 4 人と僕で運営する個人 AI 会社
    </p>
    <a class="hero-cta" href="#works">
      <span>作品を見る</span>
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M3 7h8M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
  <a class="hero-scroll" href="#about" aria-label="次のセクションへ">
    <span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6rem 1.5rem 5rem;
    overflow: hidden;
    background: linear-gradient(180deg, #fbfaf5 0%, #f4f1e8 100%);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 50% at 18% 20%, rgba(107, 142, 90, 0.14), transparent 60%),
      radial-gradient(ellipse 50% 40% at 82% 78%, rgba(201, 123, 94, 0.12), transparent 60%);
    pointer-events: none;
  }
  /* Phase 3.6 追加: 装飾 SVG レイヤ（葉っぱ + 点線）
     主役テキストの背面（z-index 0）。pointer-events なしでクリック透過。
     filter: blur(0.6px) で「ぼやけて主役を邪魔しない」感を演出。 */
  .hero-decor {
    position: absolute;
    inset: 0;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }
  .hero-decor-leaves {
    position: absolute;
    top: 8%;
    left: 4%;
    width: clamp(120px, 18vw, 220px);
    height: auto;
    filter: blur(0.6px);
  }
  .hero-decor-dashed {
    position: absolute;
    bottom: 12%;
    right: 6%;
    width: clamp(140px, 22vw, 280px);
    height: auto;
  }
  .hero-inner {
    position: relative;
    max-width: 760px;
    text-align: center;
    z-index: 1;
  }
  .hero-logo {
    margin: 0 0 2rem;
    font-family: var(--font-en);
    font-size: 0.85rem;
    letter-spacing: 0.32em;
    color: var(--color-primary);
    font-weight: 600;
    text-transform: uppercase;
  }
  .hero-copy {
    margin: 0 0 1.75rem;
    font-family: var(--font-jp);
    font-size: var(--fs-h1);
    line-height: 1.32;
    color: var(--color-text);
    letter-spacing: 0.01em;
    font-weight: 900;
  }
  .hero-copy .hero-line {
    display: block;
    /* 折り返しを禁止して 2 行構成を維持する。
       極小 viewport では下の @media で font-size を絞ってはみ出しを防ぐ */
    white-space: nowrap;
  }
  /* 1行目末尾の読点（、）は約 0.5em の右側スペースを抱えており、
     text-align: center だと視覚的中央が左に寄って見える。
     疑似要素で読点を上書きせず、padding-left で内容ボックスごと右にオフセットして補正する。 */
  .hero-copy .hero-line:first-child {
    padding-left: 0.5em;
  }
  .hero-copy .accent {
    color: var(--color-accent);
  }
  .hero-sub {
    margin: 0 auto 2.5rem;
    max-width: 540px;
    color: var(--color-text-sub);
    line-height: 1.85;
    font-size: clamp(0.9rem, 1.6vw, 1rem);
  }
  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.9rem 1.8rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: #fff;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    box-shadow: 0 6px 18px rgba(201, 123, 94, 0.28);
    transition: transform 0.25s var(--ease), background 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }
  .hero-cta:hover {
    background: var(--color-accent-dark);
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(201, 123, 94, 0.34);
  }
  .hero-cta svg {
    transition: transform 0.25s var(--ease);
  }
  .hero-cta:hover svg {
    transform: translateX(3px);
  }
  .hero-scroll {
    position: absolute;
    bottom: 1.8rem;
    left: 50%;
    transform: translateX(-50%);
    width: 22px;
    height: 36px;
    border: 1.5px solid rgba(42, 42, 42, 0.45);
    border-radius: 999px;
    display: flex;
    justify-content: center;
    padding-top: 7px;
  }
  .hero-scroll span {
    width: 3px;
    height: 8px;
    background: rgba(42, 42, 42, 0.55);
    border-radius: 999px;
    animation: scrollDot 1.8s var(--ease) infinite;
  }
  @keyframes scrollDot {
    0%   { transform: translateY(0);    opacity: 1; }
    70%  { transform: translateY(10px); opacity: 0; }
    100% { transform: translateY(10px); opacity: 0; }
  }

  @media (max-width: 640px) {
    .hero {
      min-height: 80vh;
      padding: 5rem 1.25rem 4rem;
    }
    .hero-logo {
      margin-bottom: 1.5rem;
      letter-spacing: 0.24em;
    }
    /* nowrap で折り返さなくなったので補正量を半分に抑える */
    .hero-copy .hero-line:first-child {
      padding-left: 0.25em;
    }
    .hero-scroll {
      bottom: 1.2rem;
    }
    /* 装飾はモバイルでは画面外に半分逃がし、主役テキストとの干渉を回避 */
    .hero-decor-leaves {
      top: 4%;
      left: -2%;
      width: clamp(90px, 28vw, 140px);
    }
    .hero-decor-dashed {
      bottom: 8%;
      right: -4%;
      width: clamp(120px, 32vw, 180px);
      opacity: 0.85;
    }
  }

  /* 小〜極小 viewport 対策:
     1 行目「AI 4 人と一緒に育てる、」は約 11.5em 幅で、デフォルトの 2.4rem だと
     375px viewport (内側 ≒ 335px) ではみ出すため、480px 以下では font-size を絞り、
     読点補正の padding-left も外して nowrap のはみ出しを防ぐ */
  @media (max-width: 480px) {
    .hero-copy {
      font-size: clamp(1.7rem, 7vw, 2.3rem);
    }
    .hero-copy .hero-line:first-child {
      padding-left: 0;
    }
  }
  @media (max-width: 360px) {
    .hero-copy {
      font-size: clamp(1.45rem, 6.5vw, 1.9rem);
    }
  }
</style>
