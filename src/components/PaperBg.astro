---
// 紙 C2 noise 背景。
//   mode="fixed"  : 領域 A（sticky ラッパ内）。inset:0 で領域全体をカバーし、背景色は
//                   --bg-current（グラデ背景切替が差し替える最背面レイヤ）。
//   mode="normal" : 領域 B の各セクション通常背景。color で実背景色を指定。
// noise は HTTP リクエスト 0 の inline data URI。Hero 奥入り込み演出は別レイヤで行うため
// この背景とは z-index で分離する。
// noise は共通モジュール（src/lib/paperNoise.ts）に一元化し、シミ系と粒を完全一致させる。
import { paperNoiseUrl } from '../lib/paperNoise';

interface Props {
  mode: 'fixed' | 'normal';
  color?: 'paper' | 'paper-deep';
}
const { mode, color = 'paper' } = Astro.props;

const noiseUrl = paperNoiseUrl;

// mode="fixed" は --bg-current（演出 B が動的に差し替える）を使い、未設定時は color に応じた紙色。
// mode="normal" は color 指定の実背景色を直に使う。
const baseColorVar = color === 'paper-deep' ? 'var(--c-paper-deep)' : 'var(--c-paper)';
const bgColor = mode === 'fixed' ? `var(--bg-current, ${baseColorVar})` : baseColorVar;
---
<div
  class:list={['paper-bg', `paper-bg--${mode}`]}
  aria-hidden="true"
  style={`--paper-noise: url("${noiseUrl}"); --paper-color: ${bgColor};`}
>
</div>

<style>
  .paper-bg {
    background-color: var(--paper-color);
    background-image: var(--paper-noise);
    background-repeat: repeat;
    pointer-events: none;
    user-select: none;
  }
  /* 領域 A: viewport fixed。
     スクロール進行感を強調しない原則のため、背景レイヤを viewport 固定にして
     スクロールしてもズレないようにする
     （position: absolute では region-a 全体を覆うが scroll で一緒に動いてしまう）。
     背景色は --bg-current をグラデ背景切替が transition で差し替える。 */
  .paper-bg--fixed {
    position: fixed;
    inset: 0;
    z-index: -1;
    transition: background-color var(--bg-transition, 800ms) var(--ease);
  }
  /* 領域 B: 各セクションの通常背景として全面に敷く。 */
  .paper-bg--normal {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  @media (prefers-reduced-motion: reduce) {
    .paper-bg--fixed {
      transition: none;
    }
  }
</style>
