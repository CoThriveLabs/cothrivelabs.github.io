---
// Updates セクション: note 連載・お知らせを時系列で表示
import { updates, updatesMoreLink } from '../data/updates.js';

function formatDate(iso) {
  const d = new Date(iso);
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  return { y, m, day };
}
---
<section class="updates" id="updates">
  <div class="updates-inner">
    <div class="updates-head" data-fade>
      <h2 class="section-title">
        <span class="section-num-bg" aria-hidden="true">04</span>
        <span class="section-label">
          <span class="num">04</span>
          <span class="text">Updates</span>
        </span>
        <span class="section-title-text">最近のお知らせ</span>
      </h2>
      <p class="updates-lead">こすらぼの note 連載・運営記録・リリース情報</p>
    </div>
    <ul class="updates-list">
      {updates.map((u, i) => {
        const { y, m, day } = formatDate(u.date);
        const isLink = u.link && u.link !== '#';
        return (
          <li class="update-item" data-fade style={`transition-delay:${i * 80}ms`}>
            <div class="update-date">
              <span class="update-year">{y}</span>
              <span class="update-md">{m}.{day}</span>
            </div>
            <div class="update-body">
              <div class="update-meta">
                <span class="update-category">{u.category}</span>
                <span class={`update-status ${u.status === '近日公開' ? 'is-soon' : ''}`}>{u.status}</span>
              </div>
              <h3 class="update-title">{u.title}</h3>
              <p class="update-excerpt">{u.excerpt}</p>
              {isLink ? (
                <a class="update-link" href={u.link} target="_blank" rel="noopener">
                  <span>読む</span>
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M3 7h8M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              ) : (
                <span class="update-link is-disabled">準備中</span>
              )}
            </div>
          </li>
        );
      })}
    </ul>
    <div class="updates-foot" data-fade>
      {updatesMoreLink && updatesMoreLink !== '#' ? (
        <a class="updates-more" href={updatesMoreLink} target="_blank" rel="noopener">
          すべての更新を見る
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M3 7h8M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      ) : (
        <span class="updates-more is-disabled">すべての更新を見る（準備中）</span>
      )}
    </div>
  </div>
</section>

<style>
  .updates {
    padding: 7rem 1.5rem;
    background: var(--color-bg);
    position: relative;
  }
  .updates-inner {
    max-width: var(--max-w);
    margin: 0 auto;
  }
  .updates-head {
    text-align: center;
    margin-bottom: 3rem;
    position: relative;
  }
  .section-title {
    margin: 0 0 0.85rem;
    position: relative;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    padding-top: 1.2rem;
  }
  .updates-head .section-num-bg {
    left: 50%;
    transform: translateX(-50%);
  }
  .updates-head .section-label {
    justify-content: center;
  }
  .section-title-text {
    font-family: var(--font-jp);
    font-weight: 700;
    font-size: var(--fs-h2);
    line-height: 1.3;
    color: var(--color-text);
    letter-spacing: 0.01em;
    position: relative;
    z-index: 1;
  }
  .updates-lead {
    margin: 1rem 0 0;
    color: var(--color-text-mute);
    font-size: 0.95rem;
  }
  .updates-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .update-item {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 2rem;
    padding: 2rem 0;
    border-top: 1px solid var(--color-border);
    transition: background 0.3s var(--ease);
  }
  .update-item:last-child {
    border-bottom: 1px solid var(--color-border);
  }
  .update-date {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-family: var(--font-en);
    color: var(--color-text-mute);
  }
  .update-year {
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    font-weight: 500;
  }
  .update-md {
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: var(--ls-tight);
    color: var(--color-accent);
    font-feature-settings: "tnum" 1;
    line-height: 1;
  }
  .update-body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .update-meta {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }
  .update-category {
    font-family: var(--font-en);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--color-primary-dark);
    background: rgba(107, 142, 90, 0.1);
    padding: 0.22rem 0.7rem;
    border-radius: 999px;
  }
  .update-status {
    font-family: var(--font-en);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    padding: 0.22rem 0.65rem;
    border-radius: 999px;
    background: rgba(107, 142, 90, 0.12);
    color: var(--color-primary-dark);
    font-weight: 600;
  }
  .update-status.is-soon {
    background: rgba(201, 123, 94, 0.14);
    color: var(--color-accent-dark);
  }
  .update-title {
    margin: 0;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.55;
    color: var(--color-text);
    font-family: var(--font-jp);
    font-weight: 700;
    letter-spacing: 0.01em;
  }
  .update-excerpt {
    margin: 0;
    color: var(--color-text-sub);
    font-size: 0.92rem;
    line-height: 1.85;
  }
  .update-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    align-self: flex-start;
    margin-top: 0.5rem;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: #fff;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    transition: background 0.25s var(--ease), transform 0.25s var(--ease);
  }
  .update-link:hover {
    background: var(--color-accent-dark);
    transform: translateY(-2px);
  }
  .update-link svg {
    transition: transform 0.25s var(--ease);
  }
  .update-link:hover svg {
    transform: translateX(2px);
  }
  .update-link.is-disabled {
    background: transparent;
    color: var(--color-text-mute);
    border: 1px dashed var(--color-border);
    cursor: default;
  }
  .update-link.is-disabled:hover {
    background: transparent;
    transform: none;
  }
  .updates-foot {
    margin-top: 2.5rem;
    text-align: center;
  }
  .updates-more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-en);
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-text-sub);
    text-decoration: none;
    padding: 0.6rem 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    transition: color 0.25s var(--ease), border-color 0.25s var(--ease), background 0.25s var(--ease);
  }
  .updates-more:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: rgba(201, 123, 94, 0.06);
  }
  .updates-more.is-disabled {
    color: var(--color-text-mute);
    border-style: dashed;
    cursor: default;
  }

  @media (max-width: 768px) {
    .updates {
      padding: 5rem 1.25rem;
    }
    .update-item {
      grid-template-columns: 100px 1fr;
      gap: 1.25rem;
      padding: 1.75rem 0;
    }
    .update-md {
      font-size: 1.3rem;
    }
  }
  @media (max-width: 480px) {
    .update-item {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .update-date {
      flex-direction: row;
      align-items: baseline;
      gap: 0.5rem;
    }
    .update-md {
      font-size: 1.1rem;
    }
  }
</style>
