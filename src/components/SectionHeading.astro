---
// 日本語のみ見出し（番号・英語小添字を構造的に持たない・設計書 §4.1 / 仕様書 D4）。
// 見出しはしっぽり明朝（--font-head）。リード文は任意の温度感補足。
export interface Props {
  title: string;
  lead?: string;
  align?: 'center' | 'left';
}
const { title, lead, align = 'center' } = Astro.props;
---
<div class:list={['section-heading', `is-${align}`]} data-reveal>
  <h2 class="section-heading__title">{title}</h2>
  {lead && <p class="section-heading__lead">{lead}</p>}
</div>

<style>
  .section-heading {
    margin-bottom: var(--space-snug);
  }
  .section-heading.is-center {
    text-align: center;
  }
  .section-heading.is-left {
    text-align: left;
  }
  .section-heading__title {
    margin: 0;
    font-family: var(--font-head);
    font-weight: 800;
    font-size: var(--fs-h2);
    line-height: 1.3;
    letter-spacing: 0.01em;
    color: var(--c-main);
  }
  .section-heading__lead {
    margin: 0.85rem 0 0;
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--c-main-mute);
  }
  .section-heading.is-center .section-heading__lead {
    max-width: 36rem;
    margin-left: auto;
    margin-right: auto;
  }
</style>
