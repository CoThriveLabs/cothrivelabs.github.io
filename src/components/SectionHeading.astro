---
// 日本語のみ見出し（番号・英語小添字を構造的に持たない）。
// 見出しはしっぽり明朝（--font-head）。リード文は任意の温度感補足。
export interface Props {
  title: string;
  lead?: string;
  align?: 'center' | 'left';
  underline?: boolean;   // 見出し下の手書き装飾線（補助・既定 on）
}
const { title, lead, align = 'center', underline = true } = Astro.props;
---
{/* heading と lead を別々に [data-reveal] とする。
    pin + scrub 順次出現で「見出し → リード → 各カード」と 1 つずつ出すため、
    SectionHeading 内も heading と lead で data-reveal を分離する。
    ラッパ div には data-reveal を付けない（要素単位の発火制御を阻害しないため）。 */}
<div class:list={['section-heading', `is-${align}`]}>
  <div class="section-heading__head" data-reveal>
    <h2 class="section-heading__title">{title}</h2>
    {underline && (
      <svg class="section-heading__underline" viewBox="0 0 120 10" preserveAspectRatio="none" aria-hidden="true">
        {/* 手書き風に少し波打つ下線（補助装飾・主役にしない） */}
        <path d="M2 6.5 C 22 3.5, 42 8, 62 5 S 102 3, 118 6" stroke="var(--c-accent)" stroke-width="2.2" stroke-linecap="round" fill="none" />
      </svg>
    )}
  </div>
  {lead && <p class="section-heading__lead" data-reveal>{lead}</p>}
</div>

<style>
  .section-heading {
    margin-bottom: var(--space-snug);
  }
  .section-heading.is-center {
    text-align: center;
  }
  .section-heading.is-left {
    text-align: left;
  }
  .section-heading__title {
    margin: 0;
    font-family: var(--font-head);
    font-weight: 800;
    font-size: var(--fs-h2);
    line-height: 1.3;
    letter-spacing: 0.01em;
    color: var(--c-main);
  }
  /* 手書き装飾線（補助・控えめ） */
  .section-heading__underline {
    display: block;
    width: 4.5rem;
    height: 0.55rem;
    margin: 0.6rem 0 0;
    opacity: 0.85;
  }
  .section-heading.is-center .section-heading__underline {
    margin-left: auto;
    margin-right: auto;
  }
  .section-heading__lead {
    margin: 0.85rem 0 0;
    font-family: var(--font-body);
    font-size: 1.235rem;
    line-height: 1.8;
    color: var(--c-main-mute);
  }
  .section-heading.is-center .section-heading__lead {
    max-width: 36rem;
    margin-left: auto;
    margin-right: auto;
  }
</style>
